---
import EmergencyAction from '../components/EmergencyAction.astro';
import { emergencyPhone, supportEmail } from '../data/contact';
import PrimaryNavigation from '../components/navigation/PrimaryNavigation.astro';
import '../styles/mega-navigation.css';
import { canonicalPath, pages, siteUrl, structuredData } from '../data/seo';
import { sharedStyles } from '../data/shared-styles';
import { offices } from '../data/locations';
import logo192 from '../assets/itkeepers-logo-192.webp?url';
import logo384 from '../assets/itkeepers-logo-384.webp?url';
const path = canonicalPath(Astro.url.pathname);
const page = pages[path];
if (!page) throw new Error(`Missing SEO metadata for ${path}`);
const { title, description } = page;
const canonical = `${siteUrl}${path}`;
const schema = structuredData(path, page);
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" data-hero-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={page.index === false ? 'noindex, follow' : 'index, follow'} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico?v=itk-symbol-3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=itk-symbol-3" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=itk-symbol-3" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={page.articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content="ITKeepers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/assets/itkeepers-og-v2.png`} />
    <meta property="og:image:alt" content="ITKeepers. Your IT person is a team. Managed IT, Cybersecurity, Cloud and Infrastructure. Lebanon." />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/assets/itkeepers-og-v2.png`} />
    <meta name="twitter:image:alt" content="ITKeepers. Your IT person is a team. Managed IT, Cybersecurity, Cloud and Infrastructure. Lebanon." />

    <script type="application/ld+json" set:html={schemaJson}></script>
    <slot name="head" />

    {Astro.url.pathname === '/' && <script is:inline src="/hero-theme-init.js"></script>}

    <link rel="stylesheet" href={Astro.url.pathname === '/' ? sharedStyles.home.href : sharedStyles.inner.href} />
  </head>
  <body class={Astro.url.pathname === '/' ? 'home-page' : undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {Astro.url.pathname === '/' && <svg class="logo-theme-defs" aria-hidden="true" width="0" height="0"><defs><filter id="itkeepers-logo-day" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.043137 0 0 0 0 -0.827451 1 0 0 0 -0.627451 0 1 0 0 0 0 0 1 0" /></filter></defs></svg>}
    <div class="header-region">
    <header class="site-header" data-mega-header>
      <a class="site-brand" href="/" aria-label="ITKeepers home"><img src={logo384} srcset={`${logo192} 192w, ${logo384} 384w`} sizes="(max-width: 1439px) 110px, 190px" alt="ITKeepers" width="1747" height="289" /></a>
      <PrimaryNavigation />
      <EmergencyAction />
      <span class="header-cta-actions"><a class="btn header-primary-cta" href="/contact/">Talk to our team</a></span>
      {Astro.url.pathname === '/' && <button class="hero-theme-toggle" type="button" data-hero-theme-toggle data-theme-control-paused aria-label="Switch to day mode" title="Switch to day mode" aria-pressed="true" hidden><span data-theme-icon aria-hidden="true">☾</span></button>}
      <EmergencyAction placement="mobile" />
      <PrimaryNavigation mobile />
    </header>
    </div>
    {Astro.url.pathname === '/' && <div class="home-pointer-layer" aria-hidden="true"><div class="home-pointer-light"></div></div>}
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-columns">
          <div class="footer-brand">
            <a href="/" aria-label="ITKeepers home"><img src={logo384} srcset={`${logo192} 192w, ${logo384} 384w`} sizes="150px" alt="ITKeepers" width="1747" height="289" loading="lazy" decoding="async" /></a>
            <p>Your IT person is a team.</p>
            {offices.map(office => <p><strong>{office.label}</strong><br />{office.detail}</p>)}
          </div>
          <nav class="footer-group" aria-labelledby="footer-services">
            <h2 id="footer-services">Services</h2>
            <ul>
              <li><a href="/services/managed-it/">Managed IT Services</a></li>
              <li><a href="/services/microsoft-cloud/">Microsoft 365 &amp; Cloud</a></li>
              <li><a href="/services/cybersecurity/">Cybersecurity</a></li>
              <li><a href="/services/backup-recovery/">Backup &amp; Recovery</a></li>
              <li><a href="/services/networks-infrastructure/">Networking &amp; Infrastructure</a></li>
              <li><a href="/services/ai-automation/">AI &amp; Automation</a></li>
              <li><a href="/services/web-design-hosting/">Web Design &amp; Hosting</a></li>
            </ul>
          </nav>
          <nav class="footer-group" aria-labelledby="footer-company">
            <h2 id="footer-company">Company</h2>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/how-we-work/">How We Work</a></li>
              <li><a href="/about/">Our Team</a></li>
              <li><a href="/it-keepers-pulse/">IT Keepers Pulse</a></li>
            </ul>
          </nav>
          <nav class="footer-group" aria-labelledby="footer-resources">
            <h2 id="footer-resources">Resources</h2>
            <ul>
              <li><a href="/resources/ai-governance/">AI Governance Playbook</a></li>
              <li><a href="/blog/">Blog Archive</a></li>
              <li><a href="/contact/?type=review">Free IT Consultation</a></li>
              <li><a href="/services/">All Services</a></li>
            </ul>
          </nav>
          <nav class="footer-group" aria-labelledby="footer-support">
            <h2 id="footer-support">Support</h2>
            <ul>
              <li><a href="/contact/">Contact Us</a></li>
              <li><a class="footer-emergency" href="/emergency/">Under Attack?</a></li>
              <li><a href={emergencyPhone.href} aria-label={`Call ITKeepers on ${emergencyPhone.display}`}>{emergencyPhone.display}</a></li>
              <li><a href={supportEmail.href} aria-label={`Email ITKeepers at ${supportEmail.display}`}>{supportEmail.display}</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} ITKeepers</p>
          <a href="/privacy/">Privacy Policy</a>
        </div>
      </div>
    </footer>
    <script>
      import { mountHeroTheme } from '../scripts/hero-theme';
      mountHeroTheme();
    </script>
  </body>
</html>




