---
import EmergencyAction from '../components/EmergencyAction.astro';
const {
  title = 'ITKeepers | Your IT person is a team.',
  description = 'Your IT person is a team. Familiar engineers, shared expertise, documented context and follow-up for your business.'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://itkeepers.com');
const organizationUrl = new URL('/', Astro.site ?? 'https://itkeepers.com').href;
const organizationId = `${organizationUrl}#organization`;
const entities: Record<string, unknown>[] = [{
  '@type': 'Organization',
  '@id': organizationId,
  name: 'ITKeepers',
  url: organizationUrl
}];
if (Astro.url.pathname === '/') {
  entities.push({
    '@type': 'WebSite',
    '@id': `${organizationUrl}#website`,
    name: 'ITKeepers',
    description,
    url: organizationUrl,
    publisher: { '@id': organizationId }
  });
}
const schema = { '@context': 'https://schema.org', '@graph': entities };
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" data-hero-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico?v=itk-symbol-3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=itk-symbol-3" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=itk-symbol-3" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ITKeepers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={schemaJson}></script>
    <slot name="head" />

    {Astro.url.pathname === '/' && <script is:inline src="/hero-theme-init.js"></script>}

    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/mobile.css" />
    {Astro.url.pathname === '/' && <link rel="stylesheet" href="/services-theme.css" />}
    <link rel="stylesheet" href="/visual-system-tokens.css" />
    <link rel="stylesheet" href="/visual-system.css" />
    <link rel="stylesheet" href="/emergency.css" />
    <link rel="stylesheet" href="/pulse-navigation.css" />
  </head>
  <body class={Astro.url.pathname === '/' ? 'home-page' : undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {Astro.url.pathname === '/' && <svg class="logo-theme-defs" aria-hidden="true" width="0" height="0"><defs><filter id="itkeepers-logo-day" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.043137 0 0 0 0 -0.827451 1 0 0 0 -0.627451 0 1 0 0 0 0 0 1 0" /></filter></defs></svg>}
    <div class="header-region">
    <header class="site-header">
      <a class="site-brand" href="/" aria-label="ITKeepers home"><img src="/assets/itkeepers-logo.png" alt="ITKeepers" width="1747" height="289" /></a>
      <nav class="desktop-navigation" aria-label="Primary navigation"><a href="/services/">Services</a><a href="/how-we-work">How we work</a><a href="/it-keepers-pulse" aria-current={Astro.url.pathname.replace(/\/$/, "") === "/it-keepers-pulse" ? "page" : undefined}>IT Keepers Pulse</a><a href="/about">The team</a><span class="header-cta-actions"><a class="btn header-primary-cta" href="/contact">Talk to our team</a></span></nav>
      <EmergencyAction />
      {Astro.url.pathname === '/' && <button class="hero-theme-toggle" type="button" data-hero-theme-toggle aria-label="Switch to night mode" title="Switch to night mode" aria-pressed="false" hidden><span data-theme-icon aria-hidden="true">☀</span></button>}
      <EmergencyAction placement="mobile" />
      <details class="mobile-navigation"><summary><span class="mobile-menu-label">Menu</span> <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation"><a href="/services/">Services</a><a href="/how-we-work">How we work</a><a href="/it-keepers-pulse" aria-current={Astro.url.pathname.replace(/\/$/, "") === "/it-keepers-pulse" ? "page" : undefined}>IT Keepers Pulse</a><a href="/about">The team</a><a class="btn header-primary-cta" href="/contact">Talk to our team</a></nav></details>
    </header>
    </div>
    {Astro.url.pathname === '/' && <div class="home-pointer-light" data-tone="cyan" aria-hidden="true"></div>}
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><a href="/" aria-label="ITKeepers home"><img src="/assets/itkeepers-logo.png" alt="ITKeepers" width="1747" height="289" loading="lazy" decoding="async" /></a><p>Managed IT with familiar people and shared expertise.</p></div>
      <nav aria-label="Footer navigation"><a href="/how-we-work">How we work</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a></nav>
    </footer>
    <script>
      import { mountHeroTheme } from '../scripts/hero-theme';
      mountHeroTheme();
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-navigation');
      menu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>




