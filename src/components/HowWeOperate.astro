---
import OperationalWorkflowAnimation from './animations/OperationalWorkflowAnimation.astro';
import KnowledgeContinuityAnimation from './animations/KnowledgeContinuityAnimation.astro';
import HardwareAssessmentAnimation from './animations/HardwareAssessmentAnimation.astro';
---
<section class="how-we-operate" id="how-we-operate" aria-labelledby="operate-title">
  <div class="operate-inner">
    <header class="operate-heading"><p class="operate-eyebrow">HOW WE WORK</p><h2 id="operate-title">From signal to resolution.</h2></header>
    <div class="operate-primary">
      <div class="operate-card-column">
        <OperationalWorkflowAnimation />
        <a class="operate-security-link" href="/services/cybersecurity/#security-layers">See how we handle security</a>
      </div>
      <div class="operate-supporting">
        <article aria-labelledby="operate-monitoring-title"><h3 id="operate-monitoring-title">Proactive monitoring</h3><p>Monitoring alerts highlight changes that need attention.</p></article>
        <article aria-labelledby="operate-review-title"><h3 id="operate-review-title">Reviewed by engineers</h3><p>Engineers assess signals in context and follow up on work that needs attention.</p></article>
      </div>
    </div>
    <div class="operate-stories">
      <article class="operate-documentation" aria-labelledby="operate-documentation-title">
        <div><p class="operate-label">DOCUMENTATION</p><h3 id="operate-documentation-title">Your IT. Your data. Your control.</h3><p>We maintain infrastructure and configuration records, ticket history, resolutions, changes and decisions. This documentation, with backup and recovery context, helps engineers share knowledge and continue the work.</p><p class="operate-data-arrangements">Agree client access, ownership, export, retention and handover arrangements for records and backups in your service agreement.</p></div>
        <KnowledgeContinuityAnimation />
      </article>
      <article class="operate-decisions" aria-labelledby="operate-decisions-title">
        <div><h3 id="operate-decisions-title">Keep / Upgrade / Replace</h3><p>We assess workload, condition and supportability before recommending a purchase.</p></div>
        <HardwareAssessmentAnimation />
      </article>
    </div>
    <p class="operate-footnote">Illustrative examples, not a response-time guarantee or a device diagnosis.</p>
  </div>
</section>
<style>
  :global(body.home-page) .how-we-operate { --operate-ink:var(--itk-text); --operate-muted:#B8C4D6; --operate-accent:var(--itk-brand-cyan); --operate-line:var(--itk-border-strong); color:var(--operate-ink); background:var(--itk-bg); padding-block:48px var(--chapter-space,64px); }
  .operate-inner { max-width:1240px; margin-inline:auto; min-width:0; padding-inline:clamp(16px,2vw,24px); }
  .how-we-operate :is(h2,h3,p,dt,dd) { overflow-wrap:anywhere; }
  .operate-heading { display:block; margin:0 0 28px; }
  .operate-eyebrow { color:var(--operate-accent); font-size:14px; font-weight:700; letter-spacing:.14em; line-height:1.5; margin:0 0 14px; }
  #operate-title { font-size:clamp(36px,3.8vw,56px); line-height:1.08; font-weight:600; letter-spacing:-.04em; color:var(--operate-ink); max-width:18ch; margin:0; text-wrap:balance; scroll-margin-block-start:140px; }
  .operate-primary { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(230px,.7fr); align-items:center; gap:clamp(24px,3vw,36px); }
  .operate-card-column { min-width:0; }
  .operate-security-link { display:inline-flex; align-items:center; min-height:44px; margin-top:12px; color:#7dd3fc; font-size:16px; line-height:1.5; font-weight:600; text-decoration:underline; text-underline-offset:4px; }
  .operate-security-link:focus-visible { outline:2px solid var(--operate-accent); outline-offset:4px; border-radius:3px; }
  .operate-supporting { display:grid; gap:28px; min-width:0; align-content:center; }
  .operate-stories { display:grid; gap:36px; margin-top:48px; }
  .operate-stories > article,.operate-supporting article { background:transparent; border:0; border-radius:0; padding:0; margin:0; }
  .operate-stories > article > div h3 { color:var(--operate-ink); font-size:22px; font-weight:600; line-height:1.25; letter-spacing:-.02em; margin:0 0 14px; }
  .operate-supporting h3 { color:var(--operate-ink); font-size:18px; font-weight:600; line-height:1.3; letter-spacing:-.01em; margin:0 0 8px; }
  .operate-stories > article > div > p:not(.operate-label),.operate-supporting p { color:#B8C4D6; font-size:16px; line-height:1.6; margin:0; max-width:52ch; }
  .operate-stories .operate-documentation .operate-data-arrangements { margin-block-start:16px; }
  #operate-documentation-title,#operate-decisions-title { scroll-margin-block-start:140px; }
  .operate-stories > .operate-documentation { display:grid; grid-template-columns:.75fr 1.25fr; gap:40px; align-items:center; border-top:1px solid var(--operate-line); padding-top:36px; }
  .operate-stories .operate-documentation > div .operate-label { color:#9FB0C7; font-size:14px; font-weight:700; letter-spacing:.12em; margin:0 0 18px; }
  .operate-stories .operate-documentation > div h3 { font-size:clamp(26px,2.5vw,34px); max-width:20ch; }
  .operate-stories .operate-decisions { display:grid; grid-template-columns:.55fr 1.45fr; gap:40px; border-top:1px solid var(--operate-line); padding-top:36px; align-items:center; }
  .operate-footnote { margin:32px 0 0; color:#B8C4D6; font-size:14px; line-height:1.5; }
  @media(max-width:1100px) { .operate-stories > .operate-documentation,.operate-stories .operate-decisions { grid-template-columns:minmax(0,1fr); gap:24px; } }
  @media(max-width:768px) { .operate-primary { grid-template-columns:minmax(0,1fr); gap:24px; } .operate-supporting { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; } .operate-stories { margin-top:32px; } }
  @media(max-width:540px) { .operate-supporting { grid-template-columns:minmax(0,1fr); gap:18px; } }
  @media(forced-colors:active) { :global(body.home-page) .how-we-operate { --operate-ink:CanvasText; --operate-muted:CanvasText; --operate-accent:LinkText; --operate-line:CanvasText; background:Canvas; color:CanvasText; } .operate-supporting p,.operate-footnote,.operate-security-link,.operate-stories > article > div > p { color:CanvasText; } }
</style>
<script>import '../scripts/approved-operate-animations';</script>
