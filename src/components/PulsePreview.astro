---
const { compact = false, horizontal = false } = Astro.props;
const areas = ['Overview', 'Users', 'Devices', 'Security', 'Licenses', 'Reports', 'Support'];
---
<figure class:list={['pulse-preview', { 'pulse-preview-compact': compact, 'pulse-preview-horizontal': horizontal }]} aria-label="IT Keepers Pulse interface preview" data-pulse-animation>
  <div class="pulse-preview-visual" data-animation-visual aria-hidden="true">
    <div class="pulse-product-bar">
      <div class="pulse-product-brand"><img src="/favicon.svg?v=itk-symbol-3" alt="" width="36" height="36" loading="lazy" decoding="async" /><div><strong>ITKeepers</strong><span>Pulse <svg viewBox="0 0 30 14" width="26" height="12" focusable="false"><path d="M1 7h8l3-5 5 10 3-5h9" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></div></div>
    </div>
    <div class="pulse-dashboard">
      <div class="pulse-sidebar">{areas.map((area, i) => <span class:list={{ 'pulse-selected': i === 0 }}>{area}</span>)}</div>
      <div class="pulse-dashboard-body">
        <div class="pulse-overview-label"><strong>Your environment at a glance</strong><span>Overview</span></div>
        <div class="pulse-health pulse-signal">
          <div class="pulse-health-ring"><svg viewBox="0 0 80 80" width="80" height="80" focusable="false"><circle cx="40" cy="40" r="33" fill="none" stroke="#e3e8ef" stroke-width="6"/><circle class="pulse-ring-progress" cx="40" cy="40" r="33" fill="none" stroke="var(--itk-brand-deep)" stroke-width="6" stroke-linecap="round" stroke-dasharray="195 208" transform="rotate(-90 40 40)"/></svg><span>94<small>%</small></span></div>
          <div><span class="pulse-ui-label">IT Health</span><strong>Environment healthy</strong><span class="pulse-status pulse-status-review">Items under review</span></div>
        </div>
        <div class="pulse-metrics">
          <div class="pulse-metric pulse-signal"><span class="pulse-ui-label">Devices</span><strong>54</strong><span class="pulse-status">Protection in view</span><div class="pulse-meter"><i style="--fill:94%"></i></div></div>
          <div class="pulse-metric pulse-signal"><span class="pulse-ui-label">Security</span><strong>78<small>%</small></strong><span class="pulse-status">Microsoft Secure Score</span><div class="pulse-meter"><i style="--fill:78%"></i></div></div>
          <div class="pulse-metric pulse-signal"><span class="pulse-ui-label">Licenses</span><strong>45<small> / 50</small></strong><span class="pulse-status">Assigned / purchased</span><div class="pulse-meter"><i style="--fill:90%"></i></div></div>
        </div>
        <div class="pulse-attention pulse-signal"><div><span class="pulse-ui-label">Attention Required</span><span class="pulse-status pulse-status-review">Review in progress</span></div><strong>Device compliance</strong><p>Assigned to the ITKeepers team</p></div>
      </div>
    </div>
  </div>
</figure>
<style>
  .pulse-preview { margin:0; min-inline-size:0; --pulse-ink:#0f1c2e; --pulse-muted:#506178; color:var(--pulse-ink); }
  .pulse-preview-visual { border:1px solid #d5e0ed; border-radius:var(--itk-radius-lg); overflow:hidden; background:#f4f6f9; box-shadow:0 18px 48px -24px #07152540; }
  .pulse-product-bar { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:18px 20px; background:#fff; border-block-end:1px solid #e3e8ef; }
  .pulse-product-brand { display:flex; align-items:center; gap:10px; }
  .pulse-product-brand img { inline-size:36px; block-size:36px; flex:0 0 36px; }
  .pulse-product-brand strong { display:block; font-size:17px; line-height:1.2; }
  .pulse-product-brand span { display:flex; align-items:center; gap:6px; color:#2d63a8; font-size:12px; font-weight:600; }
  .pulse-dashboard { display:grid; grid-template-columns:105px minmax(0,1fr); min-block-size:360px; }
  .pulse-sidebar { display:flex; flex-direction:column; gap:7px; padding:20px 8px; background:#fff; border-inline-end:1px solid #e3e8ef; }
  .pulse-sidebar span { font-size:12px; padding:7px 9px; color:var(--pulse-muted); border-radius:7px; }
  .pulse-sidebar .pulse-selected { background:#eaf2fc; color:#2d63a8; font-weight:700; }
  .pulse-dashboard-body { padding:20px; min-inline-size:0; }
  .pulse-overview-label { display:flex; flex-direction:column; gap:2px; margin-block-end:16px; }
  .pulse-overview-label strong { font-size:16px; letter-spacing:-.025em; }
  .pulse-overview-label > span { font-size:12px; color:var(--pulse-muted); }
  .pulse-health { display:flex; align-items:center; gap:14px; background:#fff; border:1px solid #e3e8ef; border-block-start:3px solid var(--itk-brand-cyan); border-radius:12px; padding:16px; margin-block-end:12px; }
  .pulse-health-ring { position:relative; flex:0 0 80px; inline-size:80px; block-size:80px; }
  .pulse-health-ring > span { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:26px; }
  .pulse-health-ring small { font-size:14px; }
  .pulse-health > div:last-child { display:flex; flex-direction:column; gap:5px; }
  .pulse-health strong { font-size:16px; line-height:1.3; }
  .pulse-ui-label { font-size:12px; font-weight:600; color:var(--pulse-muted); }
  .pulse-status { font-size:12px; line-height:1.4; color:var(--pulse-muted); }
  .pulse-status-review { color:#805000; background:#fdf4e2; padding:3px 7px; border-radius:5px; inline-size:fit-content; }
  .pulse-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  .pulse-metric { display:flex; flex-direction:column; gap:8px; padding:12px; border:1px solid #e3e8ef; border-radius:10px; background:#fff; }
  .pulse-metric > strong { font-size:25px; line-height:1.2; }
  .pulse-metric small { font-size:12px; color:var(--pulse-muted); }
  .pulse-meter { block-size:5px; background:#eaf0f7; border-radius:10px; overflow:hidden; margin-block-start:auto; }
  .pulse-meter i { display:block; inline-size:var(--fill); block-size:100%; background:linear-gradient(90deg,var(--itk-brand-deep),var(--itk-brand-cyan)); }
  .pulse-attention { margin-block-start:12px; padding:13px 15px; border:1px solid #e3e8ef; border-inline-start:3px solid #a96907; background:#fff; border-radius:10px; }
  .pulse-attention > div { display:flex; justify-content:space-between; gap:8px; margin-block-end:8px; }
  .pulse-attention strong { font-size:14px; }
  .pulse-attention p { margin:3px 0 0; font-size:12px; color:var(--pulse-muted); }
  .pulse-preview-compact .pulse-sidebar, .pulse-preview-compact .pulse-attention { display:none; }
  .pulse-preview-compact .pulse-dashboard { grid-template-columns:1fr; min-block-size:0; }
  @media (min-width:1101px) {
    .pulse-preview:not(.pulse-preview-compact) .pulse-product-bar { padding:22px 24px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-product-brand strong { font-size:20px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-product-brand span { font-size:14px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-product-brand img { inline-size:42px; block-size:42px; flex-basis:42px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-dashboard { grid-template-columns:120px minmax(0,1fr); }
    .pulse-preview:not(.pulse-preview-compact) .pulse-sidebar { padding:24px 10px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-sidebar span { font-size:14px; padding:8px 10px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-dashboard-body { padding:28px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-overview-label strong { font-size:20px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-health { padding:22px; gap:18px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-health-ring { inline-size:104px; block-size:104px; flex-basis:104px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-health-ring svg { inline-size:100%; block-size:100%; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-health-ring > span { font-size:32px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-health strong { font-size:20px; }
    .pulse-preview:not(.pulse-preview-compact) :is(.pulse-ui-label,.pulse-status) { font-size:14px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-metric { padding:18px; gap:12px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-metric > strong { font-size:32px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-attention { padding:16px 18px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-attention strong { font-size:16px; }
    .pulse-preview:not(.pulse-preview-compact) .pulse-attention p { font-size:14px; }
    /* Homepage-only proportion refinement; retain existing UI and type sizes. */
    .pulse-preview.pulse-preview-horizontal .pulse-product-bar { padding-block:17px; }
    .pulse-preview.pulse-preview-horizontal .pulse-dashboard { grid-template-columns:104px minmax(0,1fr); }
    .pulse-preview.pulse-preview-horizontal .pulse-dashboard-body { padding-block:22px; }
    .pulse-preview.pulse-preview-horizontal .pulse-overview-label { margin-block-end:12px; }
    .pulse-preview.pulse-preview-horizontal .pulse-health { padding-block:20px; margin-block-end:8px; }
    .pulse-preview.pulse-preview-horizontal .pulse-metric { padding-block:16px; gap:10px; }
    .pulse-preview.pulse-preview-horizontal .pulse-attention { padding-block:10px; margin-block-start:8px; }
    .pulse-preview.pulse-preview-horizontal .pulse-attention > div { margin-block-end:4px; }
    .pulse-preview.pulse-preview-horizontal .pulse-attention p { margin-block-start:1px; }
  }
  @media (prefers-reduced-motion:no-preference) {
    [data-animation-enhanced]:not([data-animation-state="settled"]) .pulse-preview-visual { animation:pulse-frame-in 400ms ease-out both; }
    [data-animation-enhanced]:not([data-animation-state="settled"]) .pulse-signal { animation:pulse-signal-in 350ms ease-out both; animation-delay:150ms; }
    [data-animation-enhanced]:not([data-animation-state="settled"]) .pulse-metric:nth-child(1) { animation-delay:280ms; }
    [data-animation-enhanced]:not([data-animation-state="settled"]) .pulse-metric:nth-child(2) { animation-delay:380ms; }
    [data-animation-enhanced]:not([data-animation-state="settled"]) .pulse-metric:nth-child(3) { animation-delay:480ms; }
    [data-animation-enhanced]:not([data-animation-state="settled"]) .pulse-attention { animation-delay:580ms; }
    [data-animation-enhanced].is-idle .pulse-preview-visual, [data-animation-enhanced].is-idle .pulse-signal { animation-play-state:paused; }
  }
  @keyframes pulse-frame-in { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
  @keyframes pulse-signal-in { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
  @media (max-width:600px) {
    .pulse-sidebar, .pulse-attention, .pulse-overview-label > span { display:none; }
    .pulse-dashboard { grid-template-columns:1fr; min-block-size:0; }
    .pulse-dashboard-body { padding:16px; }
    .pulse-product-bar { padding:16px; }
    .pulse-metrics { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .pulse-metric:first-child { grid-column:1 / -1; display:grid; grid-template-columns:1fr auto; gap:5px; align-items:center; }
    .pulse-metric:first-child .pulse-meter { display:none; }
    .pulse-health { padding:12px; gap:10px; }
    .pulse-health strong { font-size:15px; }
    [data-animation-enhanced]:not([data-animation-state="settled"]) :is(.pulse-preview-visual,.pulse-signal) { animation-name:pulse-mobile-in; animation-delay:0ms; animation-duration:250ms; }
  }
  @keyframes pulse-mobile-in { from { opacity:0; } to { opacity:1; } }
  @media (forced-colors:active) { .pulse-preview-visual,.pulse-health,.pulse-metric,.pulse-attention { border-color:CanvasText; } .pulse-meter i { background:Highlight; } }
</style>
<script>
  import { mountAnimation } from '../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('[data-pulse-animation]').forEach(root => {
    mountAnimation(root, () => ({ play() {}, settle() {}, duration: window.matchMedia('(max-width:600px)').matches ? 300 : 1000 }));
  });
</script>
