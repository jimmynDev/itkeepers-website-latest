<style>
  .animation-microsoft365 { margin:0; inline-size:100%; min-inline-size:0; --cyan:var(--itk-link,#38bdf8); font-family:var(--itk-page-heading-family,system-ui,sans-serif); container:cloud / inline-size; }
  .cloud-composition { display:flex; align-items:center; justify-content:center; inline-size:100%; }
    .visual { position: relative; width: 100%; max-width: 670px; margin-left: auto; aspect-ratio: 660 / 480; isolation: isolate; }
    .visual::before { content: ""; position: absolute; inset: 9% 6%; border-radius: 50%; pointer-events: none; background: radial-gradient(ellipse at center, #1f78a523 0%, #19587f18 38%, transparent 72%); filter: blur(17px); }
    .visual::after { content: ""; position: absolute; inset: 12% 14%; pointer-events: none; border-radius: 50%; background: radial-gradient(ellipse at center, transparent 43%, #53c8ff06 60%, transparent 78%); }
    .network { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
    .decor { fill: none; stroke: #397fa3; stroke-width: .6; opacity: .2; }
    .spine { fill: none; stroke: #286d94; stroke-width: 1.65; opacity: .60; }
    .spine-active { fill: none; stroke: var(--cyan); stroke-width: 2.3; opacity: 0; filter: drop-shadow(0 0 7px #31c4fc); transition: opacity .45s ease; }
    .visual[data-active="entra"] .spine-active.entra,
    .visual[data-active="exchange"] .spine-active.exchange,
    .visual[data-active="intune"] .spine-active.intune,
    .visual[data-active="sharepoint"] .spine-active.sharepoint { opacity: 1; }
    .signal { fill: #9fe6ff; filter: drop-shadow(0 0 4px #00c8ff) drop-shadow(0 0 9px #2aaeff); }
    .signal.secondary { fill: #38bdf8; opacity: .7; }
    .orbit { position: absolute; width: 38%; aspect-ratio: 1; left: 31%; top: 26%; border-radius: 50%; border: 1px solid #337a9f45; pointer-events: none; }
    .orbit.one { width:44%; top:22%; left:28%; border:1px dashed #3789af38; animation:cloud-orbit-turn 52s linear infinite; }
    .orbit.two { transform: scale(1.62); border-color: #1b618e24; }
    .orb-hub { position: absolute; top: 50%; left: 50%; width: 29%; aspect-ratio: 1; transform: translate(-50%,-50%); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 16px 8px; isolation: isolate; background: radial-gradient(circle at 50% 32%, #173a56, #0a2038 62%, #081c31 100%); box-shadow: 0 0 0 1px #64c4f876, 0 0 0 10px #10355266, 0 0 48px #149fe020, inset 0 1px 22px #2db3fa19; }
    .orb-hub::before { content: ""; inset: -16px; position: absolute; border-radius: 50%; border: 1px solid transparent; border-top-color: #63d9ffcc; border-bottom-color: #49aeeb55; animation: cloud-orbit-turn 14s linear infinite; z-index: -1; }
    .orb-hub::after { content: ""; inset: -29px; position: absolute; border-radius: 50%; border: 1px dashed #3d91ba3e; animation: cloud-orbit-turn 36s linear infinite reverse; z-index: -1; }
    .cloud-icon { width: 37px; height: 37px; color: #81dcff; margin-bottom: 6px; filter: drop-shadow(0 0 8px #38bdf84d); }
    .hub-main { font-size: clamp(13px, 1.5vw, 19px); color: #fff; letter-spacing: -.035em; line-height: 1.15; font-weight: 800; }
    .hub-sub { color: #a5cde4; font-size: clamp(8px, .87vw, 10px); margin-top: 6px; letter-spacing: .04em; }
    .capability { position: absolute; z-index: 3; width: 23%; min-height: 65px; padding: 12px 12px 11px 14px; text-align: left; border-radius: 15px; color: #f0f7fd; background: linear-gradient(135deg, #10283df2, #0b1c30fa); border: 1px solid #32769c92; box-shadow: 0 10px 30px #00000036, inset 0 1px 0 #a0dffd11; cursor: pointer; transition: border-color .2s, box-shadow .3s, background .2s, transform .25s; -webkit-tap-highlight-color: transparent; }
    .capability:hover { transform: translateY(-3px); border-color: #79dcffb6; box-shadow: 0 12px 36px #0005, 0 0 25px #38bdf81b; }
    .capability:focus-visible { outline: 2px solid #a5e9ff; outline-offset: 4px; }
    .capability[aria-pressed="true"] { background: linear-gradient(135deg, #12344c, #0b223b); border-color: #67d5ff; box-shadow: 0 14px 34px #0006, 0 0 24px #38bdf822, inset 0 1px 0 #d2f5ff22; }
    .capability .topline { display: flex; align-items: center; gap: 7px; margin-bottom: 5px; }
    .capability svg { width: 19px; height: 19px; stroke: #72d9ff; fill: none; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
    .capability .name { font-size: clamp(11px, 1.1vw, 14px); font-weight: 700; letter-spacing: -.025em; white-space: nowrap; }
    .capability .context { font-size: clamp(8px, .8vw, 10px); color: #a7c3d9; letter-spacing: .01em; white-space: nowrap; }
    .capability.entra { left: 4%; top: 14%; }
    .capability.exchange { right: 3%; top: 14%; }
    .capability.intune { left: 4%; bottom: 13%; }
    .capability.sharepoint { right: 3%; bottom: 13%; }

  .visual { margin-inline:auto; }
  .capability { font:inherit; min-height:65px; }
  .capability .name { font-size:14px; }
  .capability .context { font-size:11px; white-space:normal; line-height:1.35; display:block; }
  .hub-sub { font-size:10px; }
  .orbit.one,.orb-hub::before,.orb-hub::after { animation-play-state:paused; }
  .visual[data-motion="running"] .orbit.one,.visual[data-motion="running"] .orb-hub::before,.visual[data-motion="running"] .orb-hub::after { animation-play-state:running; }
  @keyframes cloud-orbit-turn { to { transform:rotate(360deg); } }
  @container cloud (max-width:430px) {
    .visual { max-width:100%; aspect-ratio:660/650; }
    .capability { width:35%; min-height:74px; border-radius:10px; padding:9px 7px; }
    .capability.entra,.capability.intune { left:0; } .capability.exchange,.capability.sharepoint { right:0; }
    .capability.entra,.capability.exchange { top:7%; } .capability.intune,.capability.sharepoint { bottom:20%; }
    .capability .topline { gap:4px; } .capability svg { width:14px; height:14px; }
    .capability .name { font-size:12px; } .capability .context { font-size:11px; }
    .hub-main { font-size:13px; } .hub-sub { display:none; } .cloud-icon { width:28px; height:28px; }
  }
  @media(prefers-reduced-motion:reduce) { .orbit.one,.orb-hub::before,.orb-hub::after { animation:none; } .signal { display:none; } .capability,.spine-active { transition:none; } .capability:hover { transform:none; } }
  @media(forced-colors:active) { .capability,.orb-hub { color:CanvasText; background:Canvas; border:1px solid CanvasText; } .capability[aria-pressed="true"] { border:2px solid Highlight; } .capability :is(.name,.context),.hub-main { color:CanvasText; } .signal { display:none; } }
</style>
<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  import { createCloudHeroTimeline } from '../../scripts/cloud-hero-animation';
  document.querySelectorAll<HTMLElement>('[data-animation="cloud-hero"]').forEach(root => mountAnimation(root, () => createCloudHeroTimeline(root), { loop:true }));
</script>
