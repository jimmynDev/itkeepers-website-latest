    .animation-security .animation-caption { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-block:14px 0; font-size:14px; line-height:1.6; color:inherit; }
    .animation-security .animation-caption p { flex:1 1 30ch; margin:0; max-width:80ch; font-size:14px; }
    .animation-security [data-animation-toggle] { font:inherit; font-size:14px; min-height:44px; padding:9px 16px; border:1px solid currentColor; border-radius:999px; background:transparent; color:inherit; cursor:pointer; }
    .animation-security [data-animation-toggle]:focus-visible { outline:3px solid var(--focus,#5cc5ff); outline-offset:4px; }
    .animation-security [hidden] { display:none !important; }
