<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('.animation-security').forEach(root => {
    mountAnimation(root, ({ later }) => {
      const section = root.querySelector('.itk-sec');

  var panel    = section.querySelector(".itk-panel");
  var lane     = section.querySelector("[data-lane]");
  var token    = section.querySelector("[data-threat]");
  var laneLine = section.querySelector("[data-lane-line]");
  var env      = section.querySelector("[data-env]");
  var envState = section.querySelector("[data-env-state]");
  var currentLayerEl = null;
  var tokenHidden = false;

  /* ---------- helpers ---------- */

  function at(ms, fn) { later(fn, ms); }

  function showAll(selector, cls) {
    section.querySelectorAll(selector).forEach(function (el) {
      el.classList.add(...cls.split(/\s+/));
    });
  }

  /* ---------- token positioning ---------- */

  function moveTokenTo(targetEl) {
    if (!lane || !token || !targetEl) return;
    var lr = lane.getBoundingClientRect();
    var tr = targetEl.getBoundingClientRect();
    var y = tr.top - lr.top + tr.height / 2;
    token.style.transform = "translateY(calc(" + y + "px - 50%))";
    currentLayerEl = targetEl;
  }

  /* ---------- layer engagement ---------- */

  function showLayer(n) {
    section.querySelectorAll('[data-layer="' + n + '"]').forEach(function (el) {
      el.classList.add("is-on");
    });
  }

  function engageLayer(n, statusText) {
    section.querySelectorAll('[data-layer="' + n + '"]').forEach(function (el) {
      el.classList.add("is-on", "is-engaged");
      var s = el.querySelector("[data-status]");
      if (s && statusText) s.textContent = statusText;
    });
  }

  function rail(n) {
    var el = section.querySelector('[data-rail="' + n + '"]');
    if (el) el.classList.add("is-on");
  }

  function chip(n) {
    var el = section.querySelectorAll("[data-chip]")[n];
    if (el) el.classList.add("is-on");
  }

  /* ---------- timeline ---------- */

  function play() {
    panel.classList.add("is-in");

    /* interface wakes up */
    at(200, function () {
      showAll("[data-live]", "is-on");
    });

    /* the environment and its protective layers become visible */
    at(450, function () {
      if (laneLine) laneLine.classList.add("is-on");
      [1, 2, 3, 4, 5].forEach(showLayer);
      if (env) env.classList.add("is-on");
    });

    /* the event appears */
    at(820, function () {
      if (token) token.classList.add("is-on");
      rail(0);
    });

    /* layer 1 — identity protection */
    at(1250, function () {
      var el = section.querySelector('[data-layer="1"]');
      moveTokenTo(el);
      engageLayer(1, "Risky sign-in detected");
      rail(1);
    });

    /* layer 2 — MFA / Conditional Access */
    at(1900, function () {
      var el = section.querySelector('[data-layer="2"]');
      moveTokenTo(el);
      engageLayer(2, "Challenge issued");
      rail(2);
    });

    /* layer 3 — endpoint protection */
    at(2550, function () {
      var el = section.querySelector('[data-layer="3"]');
      moveTokenTo(el);
      engageLayer(3, "Device posture checked");
      rail(3);
    });

    /* layer 4 — application control */
    at(3200, function () {
      var el = section.querySelector('[data-layer="4"]');
      moveTokenTo(el);
      engageLayer(4, "App access restricted");
      rail(4);
    });

    /* layer 5 — firewall / network controls */
    at(3850, function () {
      var el = section.querySelector('[data-layer="5"]');
      moveTokenTo(el);
      engageLayer(5, "Connection contained");
      rail(5);
    });

    /* alert generated */
    at(4480, function () {
      showAll("[data-alert]", "is-on");
      rail(6);
    });

    /* human response */
    at(5120, function () {
      showAll("[data-response]", "is-on");
      rail(7);
    });

    /* contained — calm resolution */
    at(5850, function () {
      rail(8);

      section.querySelectorAll('[data-layer="5"]').forEach(function (el) {
        el.classList.add("is-contained");
        var s = el.querySelector("[data-status]");
        if (s) s.textContent = "Contained";
      });

      [1, 2, 3, 4].forEach(function (n) {
        section.querySelectorAll('[data-layer="' + n + '"]').forEach(function (el) {
          el.classList.add("is-settled");
        });
      });

      if (env) env.classList.add("is-secure");
      if (envState) {
        envState.innerHTML = "<i></i> Example reviewed";
      }

      showAll("[data-mthreat]", "is-inert");

      if (token) token.classList.add("is-inert");
    });

    /* the event is gone */
    at(6700, function () {
      if (token) token.classList.add("is-gone");
      tokenHidden = true;
    });

    /* footer language settles */
    at(6500, function () { chip(0); });
    at(6750, function () { chip(1); });
    at(7000, function () { chip(2); });
    at(7250, function () { chip(3); });
  }

  /* ---------- reduced-motion / fallback final state ---------- */

  function settle() {
    panel.classList.add("is-in");

    showAll("[data-live]", "is-on");
    showAll("[data-alert]", "is-on");
    showAll("[data-response]", "is-on");
    showAll("[data-chip]", "is-on");
    showAll("[data-mthreat]", "is-inert");

    if (laneLine) laneLine.classList.add("is-on");
    if (env) env.classList.add("is-on", "is-secure");
    if (envState) envState.innerHTML = "<i></i> Example reviewed";

    var statuses = {
      1: "Risky sign-in detected",
      2: "Challenge issued",
      3: "Device posture checked",
      4: "App access restricted",
      5: "Contained"
    };

    [1, 2, 3, 4, 5].forEach(function (n) {
      section.querySelectorAll('[data-layer="' + n + '"]').forEach(function (el) {
        el.classList.add("is-on", "is-engaged");
        if (n === 5) el.classList.add("is-contained");
        else el.classList.add("is-settled");
        var s = el.querySelector("[data-status]");
        if (s) s.textContent = statuses[n];
      });
    });

    if (token) {
      token.classList.add("is-on", "is-inert");
      var last = section.querySelector('[data-layer="5"]');
      if (last) moveTokenTo(last);
    }

    for (var i = 0; i <= 8; i++) rail(i);
  }
      return { play, settle, duration: 8400 };
    });
  });
</script>
