<!-- Adapted from Security.html; illustrative, local-only prototype data. -->
<figure class="offering-animation animation-security" data-animation="security" role="img" aria-label="Illustrative cybersecurity workflow: a suspicious event is detected, reviewed and contained across coordinated security layers.">
  <div class="itk-sec" data-animation-visual aria-hidden="true">
    <div class="itk-panel" aria-hidden="true">

      
      <div class="sec-stage">
        <div class="sec-stage__head">
          <span class="sec-stage__title">Layered defence</span>
          <span class="sec-head__badges">
            <span class="sec-alert" data-alert><i></i> Alert generated</span>
            <span class="sec-live" data-live><i></i> Layered checks</span>
          </span>
        </div>

        <div class="sec-stack">

          
          <div class="sec-lane" data-lane>
            <span class="sec-lane__line" data-lane-line></span>
            <span class="sec-threat" data-threat>
              <span class="sec-threat__dot"></span>
              <span>Suspicious login</span>
            </span>
          </div>

          
          <div class="sec-layers">

            <div class="sec-layer" data-layer="1">
              <span class="sec-layer__bar"></span>
              <span class="sec-layer__body">
                <span class="sec-layer__name">Identity protection</span>
                <span class="sec-layer__status" data-status>Standing by</span>
              </span>
              <span class="sec-layer__pill" data-pill>Layer 1</span>
            </div>

            <div class="sec-layer" data-layer="2">
              <span class="sec-layer__bar"></span>
              <span class="sec-layer__body">
                <span class="sec-layer__name">MFA / Conditional Access</span>
                <span class="sec-layer__status" data-status>Standing by</span>
              </span>
              <span class="sec-layer__pill" data-pill>Layer 2</span>
            </div>

            <div class="sec-layer" data-layer="3">
              <span class="sec-layer__bar"></span>
              <span class="sec-layer__body">
                <span class="sec-layer__name">Endpoint protection</span>
                <span class="sec-layer__status" data-status>Standing by</span>
              </span>
              <span class="sec-layer__pill" data-pill>Layer 3</span>
            </div>

            <div class="sec-layer" data-layer="4">
              <span class="sec-layer__bar"></span>
              <span class="sec-layer__body">
                <span class="sec-layer__name">Application control</span>
                <span class="sec-layer__status" data-status>Standing by</span>
              </span>
              <span class="sec-layer__pill" data-pill>Layer 4</span>
            </div>

            <div class="sec-layer" data-layer="5">
              <span class="sec-layer__bar"></span>
              <span class="sec-layer__body">
                <span class="sec-layer__name">Firewall / network controls</span>
                <span class="sec-layer__status" data-status>Standing by</span>
              </span>
              <span class="sec-layer__pill" data-pill>Layer 5</span>
            </div>

            <div class="sec-response" data-response>
              <span class="sec-response__dot"></span>
              <span class="sec-response__text">Example engineer review</span>
            </div>

            <div class="sec-env" data-env>
              <div class="sec-env__head">
                <span class="sec-env__title">Example environment</span>
                <span class="sec-env__state" data-env-state><i></i> Monitored</span>
              </div>
              <div class="sec-env__chips">
                <span>Users</span>
                <span>Endpoints</span>
                <span>Applications</span>
                <span>Data</span>
              </div>
            </div>

          </div>
        </div>
      </div>

      
      <div class="sec-rail">
        <div class="sec-rail__head">
          <span class="sec-stage__title">Response</span>
        </div>

        <ol class="sec-rail__list">
          <li class="sec-item" data-rail="0" data-accent="threat">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Threat detected</span>
            <span class="sec-item__tag">Signal</span>
          </li>
          <li class="sec-item" data-rail="1">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Identity protection</span>
            <span class="sec-item__tag">Layer 1</span>
          </li>
          <li class="sec-item" data-rail="2">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">MFA / Conditional Access</span>
            <span class="sec-item__tag">Layer 2</span>
          </li>
          <li class="sec-item" data-rail="3">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Endpoint protection</span>
            <span class="sec-item__tag">Layer 3</span>
          </li>
          <li class="sec-item" data-rail="4">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Application control</span>
            <span class="sec-item__tag">Layer 4</span>
          </li>
          <li class="sec-item" data-rail="5">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Firewall / network controls</span>
            <span class="sec-item__tag">Layer 5</span>
          </li>
          <li class="sec-item" data-rail="6">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Alert generated</span>
            <span class="sec-item__tag">Detection</span>
          </li>
          <li class="sec-item" data-rail="7">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Engineer investigates</span>
            <span class="sec-item__tag">Human</span>
          </li>
          <li class="sec-item" data-rail="8" data-accent="ok">
            <span class="sec-item__dot"></span>
            <span class="sec-item__text">Threat contained</span>
            <span class="sec-item__tag">Resolved</span>
          </li>
        </ol>

        <p class="sec-rail__note">
          In this example, layered checks lead to a person reviewing the alert.
        </p>
      </div>

      
      <div class="sec-mobile">
        <div class="sec-mobile__head">
          <span class="sec-stage__title">Layered defence</span>
          <span class="sec-live" data-live><i></i> Layered checks</span>
        </div>

        <span class="sec-mthreat" data-mthreat>
          <span class="sec-threat__dot"></span>
          <span>Suspicious login attempt</span>
        </span>

        <ul class="sec-mflow">
          <li class="sec-mlayer" data-layer="1">
            <span class="sec-mlayer__dot"></span>
            <span>
              <span class="sec-mlayer__name">Identity protection</span>
              <span class="sec-mlayer__status" data-status>Standing by</span>
            </span>
          </li>
          <li class="sec-mlayer" data-layer="2">
            <span class="sec-mlayer__dot"></span>
            <span>
              <span class="sec-mlayer__name">MFA / Conditional Access</span>
              <span class="sec-mlayer__status" data-status>Standing by</span>
            </span>
          </li>
          <li class="sec-mlayer" data-layer="3">
            <span class="sec-mlayer__dot"></span>
            <span>
              <span class="sec-mlayer__name">Endpoint protection</span>
              <span class="sec-mlayer__status" data-status>Standing by</span>
            </span>
          </li>
          <li class="sec-mlayer" data-layer="4">
            <span class="sec-mlayer__dot"></span>
            <span>
              <span class="sec-mlayer__name">Application control</span>
              <span class="sec-mlayer__status" data-status>Standing by</span>
            </span>
          </li>
          <li class="sec-mlayer" data-layer="5">
            <span class="sec-mlayer__dot"></span>
            <span>
              <span class="sec-mlayer__name">Firewall / network controls</span>
              <span class="sec-mlayer__status" data-status>Standing by</span>
            </span>
          </li>
        </ul>

        <div class="sec-menv" data-env>
          <div class="sec-env__head">
            <span class="sec-env__title">Example environment</span>
            <span class="sec-env__state" data-env-state><i></i> Monitored</span>
          </div>
          <div class="sec-menv__chips">
            <span>Users</span>
            <span>Endpoints</span>
            <span>Applications</span>
            <span>Data</span>
          </div>
        </div>

        <div class="sec-mresp" data-response>
          <span class="sec-response__dot"></span>
          <span>Example engineer review</span>
        </div>
      </div>

      
      <div class="sec-foot">
        <span class="sec-chip" data-chip><i class="sec-chip__mark"></i>Prevention</span>
        <span class="sec-chip" data-chip><i class="sec-chip__mark"></i>Detection</span>
        <span class="sec-chip" data-chip><i class="sec-chip__mark"></i>Human response</span>
        <span class="sec-chip" data-chip><i class="sec-chip__mark"></i>Coordinated layers</span>
      </div>

    </div>
  </div>
</figure>

<style is:global>

.animation-security *, .animation-security *::before, .animation-security *::after { box-sizing: border-box; }

.animation-security .sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.animation-security .itk-sec {
  --bg:            #070B14;
  --panel-top:     #0E1526;
  --panel-bottom:  #0A1020;
  --surface:       #0C1322;
  --surface-hi:    #121B2E;

  --line:          rgba(126, 156, 204, 0.14);
  --line-strong:   rgba(126, 156, 204, 0.26);

  --text:          #E8EEF9;
  --muted:         #8695B0;
  --dim:           #5D6B85;

  --blue:          #3B82F6;
  --blue-bright:   #60A5FA;
  --blue-text:     #8FC0FF;
  --teal:          #2DD4A7;
  --threat:        #F2743C;
  --threat-soft:   rgba(242, 116, 60, 0.16);
  --threat-glow:   rgba(242, 116, 60, 0.42);

  --r-lg: 20px;
  --r-md: 12px;
  --r-sm: 10px;

  position: relative;
  padding: clamp(56px, 8vw, 112px) clamp(18px, 5vw, 64px);
  background:
    radial-gradient(120% 70% at 50% -12%, rgba(59, 130, 246, 0.09), transparent 62%),
    var(--bg);
}

.animation-security .itk-sec__inner { max-width: 1180px; margin: 0 auto; }

.animation-security .itk-sec .itk-eyebrow {
  display: inline-block;
  margin: 0 0 20px;
  padding: 6px 13px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--blue-text);
  background: rgba(59, 130, 246, 0.07);
  border: 1px solid rgba(59, 130, 246, 0.22);
  border-radius: 999px;
}

.animation-security .itk-sec__head h2 {
  margin: 0 0 16px;
  max-width: 22ch;
  font-size: clamp(27px, 3.4vw, 43px);
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: -0.02em;
  color: var(--text);
}

.animation-security .itk-sec__lede {
  margin: 0 0 38px;
  max-width: 66ch;
  font-size: clamp(14.5px, 1.15vw, 16.5px);
  line-height: 1.65;
  color: var(--muted);
}

.animation-security .itk-sec .itk-panel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  overflow: hidden;
  background: linear-gradient(180deg, var(--panel-top) 0%, var(--panel-bottom) 100%);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow:
    0 42px 90px -52px rgba(0, 0, 0, 0.95),
    0 0 0 1px rgba(255, 255, 255, 0.015) inset;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-security .itk-sec .itk-panel.is-in { opacity: 1; transform: none; }

.animation-security .sec-stage {
  min-width: 0;
  padding: 20px 24px 26px;
  border-right: 1px solid var(--line);
}

.animation-security .sec-stage__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}

.animation-security .sec-stage__title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-security .sec-head__badges {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.animation-security .sec-live,
.animation-security .sec-alert {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 12px 5px 10px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 999px;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.animation-security .sec-live {
  color: var(--blue-text);
  background: rgba(59, 130, 246, 0.09);
  border: 1px solid rgba(59, 130, 246, 0.22);
}

.animation-security .sec-alert {
  color: #F3A57E;
  background: rgba(242, 116, 60, 0.09);
  border: 1px solid rgba(242, 116, 60, 0.28);
}

.animation-security .sec-live.is-on,
.animation-security .sec-alert.is-on { opacity: 1; transform: none; }

.animation-security .sec-live i,
.animation-security .sec-alert i {
  width: 6px; height: 6px;
  border-radius: 50%;
  flex: none;
}

.animation-security .sec-live i {
  background: #4C9BFF;
  animation: offering-security-sec-live-pulse 3.4s ease-out infinite;
}

.animation-security .sec-alert i {
  background: var(--threat);
  animation: offering-security-sec-alert-pulse 4.6s ease-out infinite;
}

@keyframes offering-security-sec-live-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(76, 155, 255, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(76, 155, 255, 0); }
}

@keyframes offering-security-sec-alert-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(242, 116, 60, 0.45); }
  70%, 100% { box-shadow: 0 0 0 6px rgba(242, 116, 60, 0); }
}

.animation-security .sec-stack {
  position: relative;
  display: grid;
  grid-template-columns: 168px minmax(0, 1fr);
  gap: 20px;
  margin-top: 14px;
}

.animation-security .sec-lane {
  position: relative;
  min-width: 0;
}

.animation-security .sec-lane__line {
  position: absolute;
  left: 13px;
  top: 22px;
  bottom: 26px;
  width: 1px;
  background: repeating-linear-gradient(180deg,
    rgba(126, 156, 204, 0.26) 0 3px,
    transparent 3px 8px);
  opacity: 0;
  transition: opacity 0.7s ease;
}

.animation-security .sec-lane__line.is-on { opacity: 1; }

.animation-security .sec-threat {
  position: absolute;
  left: 0;
  top: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px 7px 9px;
  max-width: 100%;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  color: #F4B394;
  background: linear-gradient(180deg, #1E1620 0%, #150F18 100%);
  border: 1px solid rgba(242, 116, 60, 0.36);
  border-radius: 999px;
  box-shadow: 0 0 22px -8px var(--threat-glow);
  white-space: nowrap;
  opacity: 0;
  transform: translateY(calc(16px - 50%));
  transition:
    transform 0.72s cubic-bezier(0.33, 0, 0.2, 1),
    opacity 0.45s ease,
    border-color 0.5s ease,
    color 0.5s ease,
    box-shadow 0.5s ease,
    background 0.5s ease;
  z-index: 4;
}

.animation-security .sec-threat.is-on { opacity: 1; }

.animation-security .sec-threat__dot {
  position: relative;
  flex: none;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--threat);
  box-shadow: 0 0 9px var(--threat-glow);
  transition: background 0.5s ease, box-shadow 0.5s ease;
}

.animation-security .sec-threat.is-on .sec-threat__dot::after {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1px solid rgba(242, 116, 60, 0.45);
  animation: offering-security-sec-threat-ping 4.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes offering-security-sec-threat-ping {
  0%        { transform: scale(0.6); opacity: 0; }
  14%       { opacity: 0.55; }
  46%, 100% { transform: scale(2.2); opacity: 0; }
}
.animation-security .sec-threat.is-inert {
  color: #8794AB;
  background: linear-gradient(180deg, #131A28 0%, #0E1420 100%);
  border-color: rgba(126, 156, 204, 0.22);
  box-shadow: none;
}

.animation-security .sec-threat.is-inert .sec-threat__dot {
  background: #55627A;
  box-shadow: none;
}

.animation-security .sec-threat.is-inert .sec-threat__dot::after { display: none; }

.animation-security .sec-threat.is-gone { opacity: 0; }

.animation-security .sec-layers {
  display: flex;
  flex-direction: column;
  gap: 9px;
  min-width: 0;
  padding-top: 34px;
}

.animation-security .sec-layer {
  position: relative;
  display: grid;
  grid-template-columns: 3px minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  padding: 12px 15px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: linear-gradient(180deg, var(--surface-hi) 0%, var(--surface) 100%);
  opacity: 0;
  transform: translateY(7px);
  transition:
    opacity 0.55s ease,
    transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.55s ease,
    box-shadow 0.55s ease,
    background 0.55s ease;
}

.animation-security .sec-layer.is-on { opacity: 1; transform: none; }

.animation-security .sec-layer__bar {
  align-self: stretch;
  width: 3px;
  min-height: 26px;
  border-radius: 3px;
  background: #2C3852;
  transition: background 0.55s ease, box-shadow 0.55s ease;
}

.animation-security .sec-layer__body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.animation-security .sec-layer__name {
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: #C3D2E8;
}

.animation-security .sec-layer__status {
  font-size: 12px;
  font-weight: 500;
  line-height: 1.25;
  letter-spacing: 0.02em;
  color: var(--dim);
  transition: color 0.5s ease;
}

.animation-security .sec-layer__pill {
  flex: none;
  padding: 3px 9px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--dim);
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid var(--line);
  border-radius: 999px;
  white-space: nowrap;
  transition: color 0.5s ease, border-color 0.5s ease, background 0.5s ease;
}
.animation-security .sec-layer.is-engaged {
  border-color: rgba(59, 130, 246, 0.40);
  box-shadow:
    0 0 0 1px rgba(59, 130, 246, 0.08),
    0 0 28px -10px rgba(59, 130, 246, 0.55);
}

.animation-security .sec-layer.is-engaged .sec-layer__bar {
  background: var(--blue);
  box-shadow: 0 0 10px rgba(59, 130, 246, 0.65);
}

.animation-security .sec-layer.is-engaged .sec-layer__status { color: #7FA6E8; }

.animation-security .sec-layer.is-engaged .sec-layer__pill {
  color: var(--blue-text);
  border-color: rgba(59, 130, 246, 0.34);
  background: rgba(59, 130, 246, 0.09);
}
.animation-security .sec-layer.is-settled {
  border-color: rgba(59, 130, 246, 0.26);
  box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.04);
}

.animation-security .sec-layer.is-settled .sec-layer__bar {
  background: rgba(59, 130, 246, 0.75);
  box-shadow: none;
}
.animation-security .sec-layer.is-contained {
  border-color: rgba(45, 212, 167, 0.44);
  box-shadow:
    0 0 0 1px rgba(45, 212, 167, 0.08),
    0 0 28px -10px rgba(45, 212, 167, 0.5);
}

.animation-security .sec-layer.is-contained .sec-layer__bar {
  background: var(--teal);
  box-shadow: 0 0 10px rgba(45, 212, 167, 0.55);
}

.animation-security .sec-layer.is-contained .sec-layer__status { color: #6FD9BC; }

.animation-security .sec-layer.is-contained .sec-layer__pill {
  color: #7FE0C4;
  border-color: rgba(45, 212, 167, 0.34);
  background: rgba(45, 212, 167, 0.09);
}

.animation-security .sec-response {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 4px;
  padding: 11px 15px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.018);
  opacity: 0;
  transition: opacity 0.55s ease, border-color 0.55s ease;
}

.animation-security .sec-response.is-on {
  opacity: 1;
  border-color: rgba(59, 130, 246, 0.24);
}

.animation-security .sec-response__dot {
  position: relative;
  flex: none;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--blue);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.14);
}

.animation-security .sec-response__dot::after {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1px solid rgba(59, 130, 246, 0.45);
  animation: offering-security-sec-eng-ping 6.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes offering-security-sec-eng-ping {
  0%        { transform: scale(0.6); opacity: 0; }
  12%       { opacity: 0.55; }
  42%, 100% { transform: scale(2.2); opacity: 0; }
}

.animation-security .sec-response__text {
  font-size: 12px;
  font-weight: 500;
  color: #AFC2DC;
}

.animation-security .sec-env {
  margin-top: 10px;
  padding: 14px 16px 15px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background:
    radial-gradient(120% 150% at 50% 0%, rgba(59, 130, 246, 0.06), transparent 70%),
    linear-gradient(180deg, var(--surface-hi) 0%, var(--surface) 100%);
  opacity: 0;
  transform: translateY(7px);
  transition:
    opacity 0.6s ease,
    transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.6s ease,
    box-shadow 0.6s ease;
}

.animation-security .sec-env.is-on { opacity: 1; transform: none; }

.animation-security .sec-env.is-secure {
  border-color: rgba(45, 212, 167, 0.34);
  box-shadow: 0 0 32px -14px rgba(45, 212, 167, 0.55);
}

.animation-security .sec-env__head {
  display: flex;
  align-items: center;
