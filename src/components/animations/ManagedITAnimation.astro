<!-- Adapted from managedITservices.html; illustrative, local-only prototype data. -->
<figure class="offering-animation animation-managed" data-animation="managed">
  <div class="mits" data-animation-visual aria-hidden="true">
    <section class="mits-panel" aria-hidden="true">

        
        <div class="mits-stage">
          <div class="mits-stage__top">
            <span class="mits-stage__label">Example environment</span>
            <span class="mits-live">Monitoring example</span>
          </div>

          <div class="mits-map">
