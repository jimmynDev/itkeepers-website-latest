@media (max-width: 900px) {
  .animation-managed .mits-panel {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .animation-managed .mits-stage,
  .animation-managed .mits-flow {
    display: none;
  }

  .animation-managed .mits-mobile {
    display: block;
  }
}

@media (max-width: 560px) {
  .animation-managed .mits {
    padding-inline: 14px;
  }

  .animation-managed .mits__head h2 {
    font-size: 31px;
  }

  .animation-managed .mits__head p {
    font-size: 14px;
  }

  .animation-managed .mits-mobile__systems {
    grid-template-columns: 1fr 1fr;
  }
}
.animation-managed .mits.is-idle *,
.animation-managed .mits.is-idle *::before,
.animation-managed .mits.is-idle *::after {
  animation-play-state: paused !important;
}

@media (prefers-reduced-motion: reduce) {
  .animation-managed .mits *,
  .animation-managed .mits *::before,
  .animation-managed .mits *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
    transition-delay: 0s !important;
  }
}


