              <circle class="mits-ring" cx="50" cy="50" r="34"></circle>

              <line class="mits-link" data-link="users"     x1="50" y1="50" x2="50" y2="13"></line>
              <line class="mits-link" data-link="endpoints" x1="50" y1="50" x2="82" y2="30"></line>
              <line class="mits-link" data-link="m365"      x1="50" y1="50" x2="82" y2="70"></line>
              <line class="mits-link" data-link="backups"   x1="50" y1="50" x2="50" y2="87"></line>
              <line class="mits-link" data-link="servers"   x1="50" y1="50" x2="18" y2="70"></line>
              <line class="mits-link" data-link="network"   x1="50" y1="50" x2="18" y2="30"></line>
            </svg>

            <div class="mits-core">
              <div class="mits-core__inner">
                <span class="mits-core__dot"></span>
                <span class="mits-core__name">ITKeepers</span>
              </div>
            </div>

            <div class="mits-node" data-node="users">
              <span class="mits-node__dot"></span>
              <span class="mits-node__label">Users</span>
            </div>

            <div class="mits-node" data-node="endpoints">
              <span class="mits-node__dot"></span>
              <span class="mits-node__label">Endpoints</span>
            </div>

            <div class="mits-node" data-node="m365">
              <span class="mits-node__dot"></span>
              <span class="mits-node__label">Microsoft 365</span>
            </div>

            <div class="mits-node" data-node="network">
              <span class="mits-node__dot"></span>
              <span class="mits-node__label">Network</span>
            </div>

            <div class="mits-node" data-node="servers">
              <span class="mits-node__dot"></span>
              <span class="mits-node__label">Servers</span>
              <span class="mits-node__ticket">Ticket</span>
            </div>

            <div class="mits-node" data-node="backups">
              <span class="mits-node__dot"></span>
              <span class="mits-node__label">Backups</span>
            </div>
          </div>
        </div>

        <div class="mits-flow">
          <span class="mits-flow__label">Managed response</span>

          <ol class="mits-flow__steps">
            <li class="mits-step" data-step="monitor">
              <span class="mits-step__dot"></span>
              <span><strong>Monitor</strong><small>Environment connected</small></span>
            </li>

            <li class="mits-step" data-step="detect">
              <span class="mits-step__dot"></span>
              <span><strong>Detect</strong><small>Disk-space warning</small></span>
            </li>

            <li class="mits-step" data-step="own">
              <span class="mits-step__dot"></span>
              <span><strong>Own</strong><small>Ticket created</small></span>
            </li>

            <li class="mits-step" data-step="resolve">
              <span class="mits-step__dot"></span>
              <span><strong>Resolve</strong><small>Server healthy again</small></span>
            </li>
          </ol>

          <div class="mits-flow__result">
            <strong>Monitoring becomes action.</strong>
            <span>The issue is detected, owned and resolved.</span>
          </div>
        </div>

        
        <div class="mits-mobile">
          <div class="mits-mobile__status">
            <span class="mits-stage__label">Example environment</span>
            <span class="mits-live">Monitoring example</span>
          </div>

          <div class="mits-mobile__systems">
            <div class="mits-mobile__sys" data-mobile-node="users">Users</div>
            <div class="mits-mobile__sys" data-mobile-node="endpoints">Endpoints</div>
            <div class="mits-mobile__sys" data-mobile-node="m365">Microsoft 365</div>
            <div class="mits-mobile__sys" data-mobile-node="network">Network</div>
            <div class="mits-mobile__sys" data-mobile-node="servers">Servers</div>
            <div class="mits-mobile__sys" data-mobile-node="backups">Backups</div>
          </div>

          <ol class="mits-mobile__flow">
            <li class="mits-mobile__step" data-mobile-step="monitor">Monitor the environment</li>
            <li class="mits-mobile__step" data-mobile-step="detect">Detect the issue</li>
            <li class="mits-mobile__step" data-mobile-step="own">Create and own the ticket</li>
            <li class="mits-mobile__step" data-mobile-step="resolve">Restore healthy state</li>
          </ol>

          <div class="mits-mobile__result">Monitoring becomes action.</div>
        </div>

      </section>
  </div>
</figure>

<style is:global>

.animation-managed *,
