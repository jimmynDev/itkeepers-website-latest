      --bg:var(--n,#0b2c5f); --panel: #0b2c5f; --panel-top:#0b2c5f; --panel-bottom:#071f44;
      --surface:#102f59; --surface-2:#123763; --surface-hi:#163b68;
      --text:#ffffff; --muted:#d6e4f5; --dim:#b8cde6;
      --blue:#5cc5ff; --blue-bright:#5cc5ff; --blue-soft:#5cc5ff; --blue-text:#8fcfff;
      --cyan:#42baeb; --cyan-text:#7ee3f5; --line:rgba(184,205,230,.22); --line-strong:rgba(184,205,230,.5);
      padding:0; background:none; overflow:visible; color:var(--text); font-family:inherit;
    }
    .animation-managed .mits-panel { margin:0; background:linear-gradient(180deg,#0b2c5f,#071f44); }
    .animation-managed .animation-caption { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-block:14px 0; font-size:14px; line-height:1.6; color:inherit; }
    .animation-managed .animation-caption p { flex:1 1 30ch; margin:0; max-width:80ch; font-size:14px; }
    .animation-managed [data-animation-toggle] { font:inherit; font-size:14px; min-height:44px; padding:9px 16px; border:1px solid currentColor; border-radius:999px; background:transparent; color:inherit; cursor:pointer; }
    .animation-managed [data-animation-toggle]:focus-visible { outline:3px solid var(--focus,#5cc5ff); outline-offset:4px; }
    .animation-managed [hidden] { display:none !important; }
    .animation-managed.is-idle *, .animation-managed.is-idle *::before, .animation-managed.is-idle *::after { animation-play-state:paused !important; }
    .animation-managed[data-animation-state="settled"] *, .animation-managed[data-animation-state="settled"] *::before, .animation-managed[data-animation-state="settled"] *::after { animation:none !important; transition:none !important; }
    .animation-managed:not([data-animation-enhanced]) [data-animation-visual], .animation-managed:not([data-animation-enhanced]) [data-animation-visual] * { opacity:1 !important; animation:none !important; transition:none !important; }
    .animation-managed:not([data-animation-enhanced]) .mits-panel { transform:none; }
    @media (hover:hover) and (pointer:fine) { .animation-managed [data-animation-toggle]:hover { background:rgba(92,197,255,.12); } }
    @media (max-width:560px) { .animation-managed .animation-caption { align-items:flex-start; } .animation-managed .animation-caption p { flex-basis:100%; } }
    @media (prefers-reduced-motion:reduce) { .animation-managed *, .animation-managed *::before, .animation-managed *::after { animation:none !important; transition:none !important; } }
    @media (forced-colors:active) { .animation-managed .mits-panel, .animation-managed [data-animation-toggle] { border:1px solid CanvasText; } }
  
</style>

<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('.animation-managed').forEach(root => {
    mountAnimation(root, ({ later }) => {
      const section = root.querySelector('.mits');
  const panel = section.querySelector(".mits-panel");

  const names = ["users", "endpoints", "m365", "network", "servers", "backups"];

  const nodes = Object.fromEntries(
    names.map(name => [name, section.querySelector(`[data-node="${name}"]`)])
  );

  const mobileNodes = Object.fromEntries(
    names.map(name => [name, section.querySelector(`[data-mobile-node="${name}"]`)])
  );

  const links = Object.fromEntries(
    names.map(name => [name, section.querySelector(`[data-link="${name}"]`)])
  );

  const steps = {
    monitor: section.querySelector('[data-step="monitor"]'),
    detect: section.querySelector('[data-step="detect"]'),
    own: section.querySelector('[data-step="own"]'),
    resolve: section.querySelector('[data-step="resolve"]')
  };

  const mobileSteps = {
    monitor: section.querySelector('[data-mobile-step="monitor"]'),
    detect: section.querySelector('[data-mobile-step="detect"]'),
    own: section.querySelector('[data-mobile-step="own"]'),
    resolve: section.querySelector('[data-mobile-step="resolve"]')
  };

  

  function connectEnvironment() {
    section.classList.add("is-running");
    panel.classList.add("is-visible");

    names.forEach((name, index) => {
      later(() => {
        nodes[name]?.classList.add("is-on");
        mobileNodes[name]?.classList.add("is-on");
        links[name]?.classList.add("is-on");
      }, 120 + index * 90);
    });

    later(() => {
      steps.monitor.classList.add("is-on");
      mobileSteps.monitor.classList.add("is-on");
    }, 720);
  }

  function detectIssue() {
    nodes.servers.classList.add("is-warning");
    mobileNodes.servers.classList.add("is-warning");
    links.servers.classList.add("is-focus");

    steps.detect.classList.add("is-on", "is-warning");
    mobileSteps.detect.classList.add("is-on", "is-warning");
  }

  function ownIssue() {
    steps.own.classList.add("is-on", "is-warning");
    mobileSteps.own.classList.add("is-on", "is-warning");
  }

  function resolveIssue() {
    nodes.servers.classList.remove("is-warning");
    nodes.servers.classList.add("is-recovered");

    mobileNodes.servers.classList.remove("is-warning");
    mobileNodes.servers.classList.add("is-recovered");

    links.servers.classList.remove("is-focus");
    links.servers.classList.add("is-ok");

    steps.resolve.classList.add("is-on", "is-ok");
    mobileSteps.resolve.classList.add("is-on", "is-ok");

    section.classList.add("is-complete");
  }


      function play() {
        connectEnvironment();
        later(detectIssue, 1700);
        later(ownIssue, 2550);
        later(resolveIssue, 3650);
      }
      function settle() {
        section.classList.add('is-running');
        panel.classList.add('is-visible');
        names.forEach(name => {
          nodes[name]?.classList.add('is-on');
          mobileNodes[name]?.classList.add('is-on');
          links[name]?.classList.add('is-on');
        });
        Object.values(steps).forEach(step => step.classList.add('is-on'));
        Object.values(mobileSteps).forEach(step => step.classList.add('is-on'));
        resolveIssue();
      }
      return { play, settle, duration: 4700 };
    });
  });
</script>
