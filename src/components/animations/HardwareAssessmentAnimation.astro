---
// Compact adaptation of keep-upgrade-replace.html: diagnostics and three outcomes.
const signals=[['CPU',7,'Within spec','ok'],['RAM',4,'Under pressure','review'],['Storage',3,'Near capacity','review'],['Age',5,'In service','neutral'],['Warranty',3,'Expired','review'],['Security compatibility',7,'Review in this example','neutral']];
const outcomes=[['Keep','Still suitable for the work.'],['Upgrade','A targeted improvement addresses a bottleneck.'],['Replace','No longer practical to maintain.']];
---
<figure class="hardware-assessment is-idle" data-animation="hardware-assessment" aria-label="Example hardware assessment comparing keep, upgrade and replace options">
  <div class="assessment-scene" data-animation-visual data-phase="settled">
    <div class="assessment-diagnostics"><div class="assessment-heading"><strong>Sample assessment</strong><span data-assessment-status>Example complete</span></div><dl>{signals.map(([name,fill,state,tone],index)=><div class="assessment-signal" data-assessment-signal={index}><dt>{name}</dt><dd><span class:list={['assessment-meter',`meter-${tone}`]} aria-hidden="true">{Array.from({length:8},(_,i)=><i class:list={{'is-filled':i<Number(fill)}}></i>)}</span><span class="assessment-reading">{state}</span></dd></div>)}</dl></div>
    <div class="assessment-options" role="group" aria-label="Three possible hardware decisions">{outcomes.map(([name,copy])=><div class:list={['assessment-option',{'is-selected':name==='Upgrade'}]} data-assessment-outcome={name.toLowerCase()}><div class="assessment-option-title"><strong>{name}</strong>{name==='Upgrade'&&<span class="assessment-selection">Example outcome</span>}</div><p>{copy}</p></div>)}</div>
  </div>
</figure>
<style>
  .hardware-assessment { margin:0; min-width:0; }
  .assessment-scene { display:grid; grid-template-columns:1fr 1.1fr; gap:20px; color:var(--itk-text); }
  .assessment-diagnostics { padding:18px; border:1px solid var(--itk-border-strong); border-radius:14px; background:var(--itk-surface); min-width:0; }
  .assessment-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; padding-bottom:12px; border-bottom:1px solid var(--itk-border-strong); font-size:14px; line-height:1.5; }
  .assessment-heading > span { color:var(--itk-supporting-text,#B8C4D6); font-size:14px; }
  .assessment-diagnostics dl { margin:12px 0 0; }
  .assessment-signal { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.4fr); gap:12px; padding-block:7px; font-size:14px; line-height:1.5; }
  .assessment-signal dt { font-weight:600; overflow-wrap:anywhere; }
  .assessment-signal dd { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:0; min-width:0; }
  .assessment-reading { color:var(--itk-supporting-text,#B8C4D6); text-align:right; overflow-wrap:anywhere; }
  .assessment-meter { display:flex; gap:3px; flex:none; }
  .assessment-meter i { width:4px; height:12px; border-radius:1px; background:var(--itk-border-strong); }
  .assessment-meter .is-filled { background:var(--itk-cyan-sky); }
  .meter-ok .is-filled { background:var(--itk-cyan-sky); }
  .meter-review .is-filled { background:var(--itk-brand-cyan); }
  .assessment-options { display:grid; gap:10px; }
  .assessment-option { padding:13px 16px; border:1px solid var(--itk-border-strong); border-radius:12px; background:var(--itk-surface); }
  .assessment-option-title { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px; font-size:14px; line-height:1.5; }
  .assessment-option p { margin:6px 0 0; font-size:16px; line-height:1.6; font-weight:400; color:var(--itk-supporting-text,#B8C4D6); overflow-wrap:anywhere; }
  .assessment-selection { padding:2px 7px; border:1px solid var(--itk-cyan-sky); border-radius:6px; background:var(--itk-surface-raised); color:var(--itk-cyan-sky); font-size:14px; line-height:1.6; }
  .assessment-option.is-selected { border-color:var(--itk-cyan-sky); background:var(--itk-surface-raised); }
  .hardware-assessment[data-animation-enhanced="true"] .assessment-scene:not([data-phase="settled"]) .assessment-option:not(.is-selected) .assessment-selection { visibility:hidden; }
  .hardware-assessment[data-animation-enhanced="true"] .assessment-signal:not(.is-read) .assessment-meter .is-filled { background:var(--itk-border-strong); }
  @media(prefers-reduced-motion:no-preference) { .assessment-option { transition:background-color 300ms ease,border-color 300ms ease; } .assessment-meter i { transition:background-color 200ms ease; } }
  .hardware-assessment:is([data-animation-state="paused"],[data-animation-state="replay-ready"],[data-animation-state="settled"]) .assessment-scene * { transition:none; }
  @media(max-width:620px) { .assessment-scene { grid-template-columns:1fr; gap:16px; } .assessment-signal { grid-template-columns:1fr 1.4fr; } .assessment-signal dd { flex-wrap:wrap; } .assessment-reading { text-align:left; } }
  @media(forced-colors:active) { .assessment-scene,.assessment-scene * { color:CanvasText; border-color:CanvasText; } .assessment-diagnostics,.assessment-option,.assessment-option.is-selected,.assessment-selection { background:Canvas; } .assessment-option.is-selected { outline:2px solid Highlight; } }
</style>
