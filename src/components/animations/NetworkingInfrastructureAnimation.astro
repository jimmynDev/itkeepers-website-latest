}

.animation-network .net-node.is-fault .net-node__dot::after { border-color: rgba(240, 169, 59, 0.5); }

.animation-network .net-node.is-fault .net-node__status { color: #E8B978; }
.animation-network .net-node.is-recovered {
  border-color: rgba(45, 212, 167, 0.42);
  box-shadow:
    0 0 0 1px rgba(45, 212, 167, 0.08),
    0 0 26px -10px rgba(45, 212, 167, 0.5);
}

.animation-network .net-node.is-recovered .net-node__dot {
  background: var(--teal);
