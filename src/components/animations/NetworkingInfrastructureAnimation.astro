    .animation-network .animation-caption { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-block:14px 0; font-size:14px; line-height:1.6; color:inherit; }
    .animation-network .animation-caption p { flex:1 1 30ch; margin:0; max-width:80ch; font-size:14px; }
