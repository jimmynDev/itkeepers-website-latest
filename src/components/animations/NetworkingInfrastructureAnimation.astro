}

.animation-network .net-node.is-recovered .net-node__dot::after { border-color: rgba(45, 212, 167, 0.45); }

.animation-network .net-node.is-recovered .net-node__status { color: #6FD9BC; }

.animation-network .net-rail {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 20px 22px 22px;
}

.animation-network .net-rail__head {
