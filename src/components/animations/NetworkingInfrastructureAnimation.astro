  grid-template-columns: 14px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 7px 0;
  opacity: 0.26;
  transform: translateX(-4px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.animation-network .net-item.is-on { opacity: 1; transform: none; }

.animation-network .net-item__dot {
  position: relative;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  border: 1px solid var(--line-strong);
  transition: border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
}

.animation-network .net-item.is-on .net-item__dot {
