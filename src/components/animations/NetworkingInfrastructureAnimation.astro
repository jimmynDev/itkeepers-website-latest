  box-shadow: 0 0 10px -1px rgba(99, 102, 241, 0.5);
}

.animation-network .net-item.is-on .net-item__dot::after {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 5px; height: 5px;
  margin: -2.5px 0 0 -2.5px;
