}

.animation-network .net-mrow.is-active .net-mrow__status { color: var(--indigo-text); }
.animation-network .net-mrow.is-remote.is-active .net-mrow__status { color: var(--cyan-text); }
.animation-network .net-mrow.is-fault .net-mrow__status { color: #E8B978; }
.animation-network .net-mrow.is-recovered .net-mrow__status { color: #6FD9BC; }
.animation-network .net-mgroup {
  position: relative;
  margin: 4px 0 6px;
  padding: 12px 0 12px 0;
  border-top: 1px solid rgba(126, 156, 204, 0.10);
