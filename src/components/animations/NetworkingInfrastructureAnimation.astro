<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('.animation-network').forEach(root => {
    mountAnimation(root, ({ later }) => {
      const section = root.querySelector('.itk-net');

  var panel      = section.querySelector(".itk-panel");
  var faultBadge = section.querySelector("[data-fault-badge]");

  /* ---------- build flow overlays from link paths ---------- */

  var links = {};
  var flows = {};

  section.querySelectorAll("[data-link]").forEach(function (path) {
    var key = path.dataset.link;
    links[key] = path;

    /* flow overlay sits on top of the base link */
    var flow = document.createElementNS("http://www.w3.org/2000/svg", "path");
    flow.setAttribute("d", path.getAttribute("d"));
    flow.setAttribute("class", "net-flow");
    if (path.classList.contains("is-vpn")) flow.classList.add("is-vpn");
    path.parentNode.appendChild(flow);
    flows[key] = flow;
  });

  /* ---------- helpers ---------- */

  function at(ms, fn) { later(fn, ms); }

  function els(key) {
    return section.querySelectorAll('[data-node="' + key + '"]');
  }

  function appear(key) {
    els(key).forEach(function (el) { el.classList.add("is-on"); });
  }

  function activate(key, status) {
    els(key).forEach(function (el) {
      el.classList.add("is-on", "is-active");
      if (status) {
        var s = el.querySelector("[data-status]");
        if (s) s.textContent = status;
      }
    });
  }

  function setStatus(key, status) {
    els(key).forEach(function (el) {
      var s = el.querySelector("[data-status]");
      if (s) s.textContent = status;
    });
  }

  function markFault(key) {
    els(key).forEach(function (el) { el.classList.add("is-fault"); });
  }

  function markRecovered(key) {
    els(key).forEach(function (el) {
      el.classList.remove("is-fault");
      el.classList.add("is-recovered");
    });
  }

  function drawLink(key) {
    var p = links[key];
    if (!p) return;
    var len = 0;
    try { len = p.getTotalLength(); } catch (e) { len = 60; }

    if (p.classList.contains("is-vpn")) {
      /* dashed link fades in rather than drawing */
      p.classList.add("is-on");
      return;
    }

    p.style.strokeDasharray  = len;
    p.style.strokeDashoffset = len;
    p.classList.add("is-on");

    /* force reflow so the transition runs from the offset state */
    void p.getBoundingClientRect();
    p.style.strokeDashoffset = 0;
  }

  function startFlow(key) {
    var f = flows[key];
    if (f) f.classList.add("is-on");
  }

  function faultFlow(key) {
    var f = flows[key];
    if (f) f.classList.add("is-fault");
  }

  function clearFaultFlow(key) {
    var f = flows[key];
    if (f) f.classList.remove("is-fault");
  }

  function rail(n) {
    var el = section.querySelector('[data-rail="' + n + '"]');
    if (el) el.classList.add("is-on");
  }

  function chip(n) {
    var el = section.querySelectorAll("[data-chip]")[n];
    if (el) el.classList.add("is-on");
  }

  /* ---------- timeline ---------- */

  function play() {
    panel.classList.add("is-in");

    /* interface wakes */
    at(220, function () {
      section.querySelectorAll("[data-live]").forEach(function (el) {
        el.classList.add("is-on");
      });
    });

    /* disconnected components appear, dim */
    at(460, function () {
      ["internet", "remote", "firewall", "core",
       "users", "wifi", "servers", "business", "virt"]
        .forEach(appear);
    });

    /* internet comes online */
    at(800, function () {
      activate("internet", "Online");
      rail(0);
    });

    /* firewall + first link */
    at(1120, function () {
      drawLink("internet-firewall");
      activate("firewall", "Active");
      rail(1);
    });

    /* core + second link */
    at(1480, function () {
      drawLink("firewall-core");
      activate("core", "Active");
      rail(2);
    });

    /* branches */
    at(1840, function () {
      drawLink("core-users");
      activate("users", "Connected");
    });

    at(2060, function () {
      drawLink("core-wifi");
      activate("wifi", "Connected");
      rail(3);
    });

    at(2300, function () {
      drawLink("core-servers");
      activate("servers", "Connected");
      rail(4);
    });

    at(2540, function () {
      drawLink("core-business");
      activate("business", "Connected");
      rail(5);
    });

    at(2780, function () {
      drawLink("servers-virt");
      activate("virt", "Connected");
    });

    /* restrained traffic begins on the core paths */
    at(3180, function () {
      ["internet-firewall", "firewall-core",
       "core-users", "core-wifi", "core-servers", "core-business",
       "servers-virt"].forEach(startFlow);
    });

    /* remote employee connects */
    at(3560, function () {
      activate("remote", "Connecting");
    });

    at(3880, function () {
      drawLink("remote-firewall");
      setStatus("remote", "VPN established");
    });

    at(4260, function () {
      setStatus("remote", "Identity verified");
      startFlow("remote-firewall");
      rail(6);
    });

    /* link issue — detected without breaking the environment */
    at(4980, function () {
      var p = links["core-wifi"];
      if (p) p.classList.add("is-fault");
      faultFlow("core-wifi");
      markFault("wifi");
      setStatus("wifi", "Link degraded");

      if (faultBadge) faultBadge.classList.add("is-on");
      rail(7);
    });

    at(5680, function () {
      setStatus("wifi", "Detected · isolating");
    });

    /* restored */
    at(6280, function () {
      var p = links["core-wifi"];
      if (p) p.classList.remove("is-fault");
      clearFaultFlow("core-wifi");

      markRecovered("wifi");
      setStatus("wifi", "Restored");

      if (faultBadge) {
        faultBadge.classList.add("is-ok");
        faultBadge.innerHTML = "<i></i> Link restored";
      }
      rail(8);
    });

    /* footer language settles */
    at(6500, function () { chip(0); });
    at(6720, function () { chip(1); });
    at(6940, function () { chip(2); });
    at(7160, function () { chip(3); });
  }

  /* ---------- reduced-motion / fallback final state ---------- */

  function settle() {
    panel.classList.add("is-in");

    section.querySelectorAll("[data-live]").forEach(function (el) {
      el.classList.add("is-on");
    });
    section.querySelectorAll("[data-chip]").forEach(function (el) {
      el.classList.add("is-on");
    });

    ["internet", "remote", "firewall", "core",
     "users", "wifi", "servers", "business", "virt"]
      .forEach(function (k) { els(k).forEach(function (el) { el.classList.add("is-on"); }); });

    activate("internet", "Online");
    activate("firewall", "Active");
    activate("core", "Active");
    activate("users", "Connected");
    activate("servers", "Connected");
    activate("business", "Connected");
    activate("virt", "Connected");
    activate("remote", "Identity verified");

    els("wifi").forEach(function (el) {
      el.classList.add("is-active", "is-recovered");
      var s = el.querySelector("[data-status]");
      if (s) s.textContent = "Restored";
    });

    Object.keys(links).forEach(function (k) {
      var p = links[k];
      if (p.classList.contains("is-vpn")) {
        p.classList.add("is-on");
      } else {
        p.classList.add("is-on");
        p.style.strokeDasharray  = "none";
        p.style.strokeDashoffset = 0;
      }
      startFlow(k);
    });

    if (faultBadge) {
      faultBadge.classList.add("is-on", "is-ok");
      faultBadge.innerHTML = "<i></i> Link restored";
    }

    for (var i = 0; i <= 8; i++) rail(i);
  }
      return { play, settle, duration: 8300 };
    });
  });
</script>
