<!-- Adapted from Networking.html; illustrative, local-only prototype data. -->
<figure class="offering-animation animation-network" data-animation="network">
  <div class="itk-net" data-animation-visual aria-hidden="true">
    <div class="itk-panel" aria-hidden="true">

      
      <div class="net-stage">
        <div class="net-stage__head">
          <span class="net-stage__title">Network topology</span>
          <span class="net-head__badges">
            <span class="net-fault" data-fault-badge><i></i> Link issue detected</span>
            <span class="net-live" data-live><i></i> Connected example</span>
          </span>
        </div>

        <div class="net-map">
          <svg class="net-map__svg" viewBox="0 0 160 110" preserveAspectRatio="none">
            <g data-links>
              <path class="net-link" data-link="internet-firewall" d="M 80 7.7 L 80 28.6"></path>
              <path class="net-link" data-link="firewall-core"     d="M 80 28.6 L 80 51.7"></path>
              <path class="net-link is-vpn" data-link="remote-firewall"
                    d="M 17.6 29.7 C 42 29.7, 58 28.6, 80 28.6"></path>
              <path class="net-link" data-link="core-users"
                    d="M 80 51.7 C 80 67, 19.2 66, 19.2 82.5"></path>
              <path class="net-link" data-link="core-wifi"
                    d="M 80 51.7 C 80 67, 59.2 66, 59.2 82.5"></path>
              <path class="net-link" data-link="core-servers"
                    d="M 80 51.7 C 80 67, 100.8 66, 100.8 82.5"></path>
              <path class="net-link" data-link="core-business"
                    d="M 80 51.7 C 80 67, 140.8 66, 140.8 82.5"></path>
              <path class="net-link" data-link="servers-virt"
                    d="M 100.8 82.5 L 100.8 102.3"></path>
            </g>
          </svg>

          
          <div class="net-node" data-node="internet" data-style="network-inline-1">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Internet</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>

          
          <div class="net-node is-remote" data-node="remote" data-style="network-inline-2">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Remote employee</span>
              <span class="net-node__status" data-status>Away</span>
            </span>
          </div>

          
          <div class="net-node" data-node="firewall" data-style="network-inline-3">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Firewall</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>

          
          <div class="net-node is-core" data-node="core" data-style="network-inline-4">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Core network</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>

          
          <div class="net-node" data-node="users" data-style="network-inline-5">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">User devices</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>

          <div class="net-node" data-node="wifi" data-style="network-inline-6">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Wi-Fi</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>

          <div class="net-node" data-node="servers" data-style="network-inline-7">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Servers</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>

          <div class="net-node" data-node="business" data-style="network-inline-8">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Business apps</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>

          <div class="net-node" data-node="virt" data-style="network-inline-9">
            <span class="net-node__dot"></span>
            <span class="net-node__body">
              <span class="net-node__label">Virtualization</span>
              <span class="net-node__status" data-status>Offline</span>
            </span>
          </div>
        </div>
      </div>

      
      <div class="net-rail">
        <div class="net-rail__head">
          <span class="net-stage__title">Build &amp; monitor</span>
        </div>

        <ol class="net-rail__list">
          <li class="net-item" data-rail="0">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Internet connection</span>
            <span class="net-item__tag">WAN</span>
          </li>
          <li class="net-item" data-rail="1">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Firewall</span>
            <span class="net-item__tag">Edge</span>
          </li>
          <li class="net-item" data-rail="2">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Core network</span>
            <span class="net-item__tag">Switching</span>
          </li>
          <li class="net-item" data-rail="3">
            <span class="net-item__dot"></span>
            <span class="net-item__text">User devices &amp; Wi-Fi</span>
            <span class="net-item__tag">Access</span>
          </li>
          <li class="net-item" data-rail="4">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Servers &amp; virtualization</span>
            <span class="net-item__tag">Compute</span>
          </li>
          <li class="net-item" data-rail="5">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Business systems</span>
            <span class="net-item__tag">Apps</span>
          </li>
          <li class="net-item" data-rail="6" data-accent="cyan">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Remote access established</span>
            <span class="net-item__tag">VPN</span>
          </li>
          <li class="net-item" data-rail="7" data-accent="amber">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Link issue detected</span>
            <span class="net-item__tag">Monitored</span>
          </li>
          <li class="net-item" data-rail="8" data-accent="ok">
            <span class="net-item__dot"></span>
            <span class="net-item__text">Restored &amp; monitored</span>
            <span class="net-item__tag">Stable</span>
          </li>
        </ol>

        <p class="net-rail__note">
          Connectivity and the infrastructure behind it — engineered, monitored, restored.
        </p>
      </div>

      
      <div class="net-mobile">
        <div class="net-mobile__head">
          <span class="net-stage__title">Network</span>
          <span class="net-live" data-live><i></i> Active</span>
        </div>

        <ol class="net-mflow">
          <li class="net-mrow" data-node="internet">
            <span class="net-mrow__dot"></span>
            <span class="net-mrow__name">Internet</span>
            <span class="net-mrow__status" data-status>Offline</span>
          </li>
          <li class="net-mrow" data-node="firewall">
            <span class="net-mrow__dot"></span>
            <span class="net-mrow__name">Firewall</span>
            <span class="net-mrow__status" data-status>Offline</span>
          </li>
          <li class="net-mrow" data-node="core">
            <span class="net-mrow__dot"></span>
            <span class="net-mrow__name">Core network</span>
            <span class="net-mrow__status" data-status>Offline</span>
          </li>
        </ol>

        <div class="net-mgroup">
          <span class="net-mgroup__title">Connected systems</span>
          <ol class="net-mflow">
            <li class="net-mrow" data-node="users">
              <span class="net-mrow__dot"></span>
              <span class="net-mrow__name">User devices</span>
              <span class="net-mrow__status" data-status>Offline</span>
            </li>
            <li class="net-mrow" data-node="wifi">
              <span class="net-mrow__dot"></span>
              <span class="net-mrow__name">Wi-Fi</span>
              <span class="net-mrow__status" data-status>Offline</span>
            </li>
            <li class="net-mrow" data-node="servers">
              <span class="net-mrow__dot"></span>
              <span class="net-mrow__name">Servers</span>
              <span class="net-mrow__status" data-status>Offline</span>
            </li>
            <li class="net-mrow" data-node="virt">
              <span class="net-mrow__dot"></span>
              <span class="net-mrow__name">Virtualization</span>
              <span class="net-mrow__status" data-status>Offline</span>
            </li>
            <li class="net-mrow" data-node="business">
              <span class="net-mrow__dot"></span>
              <span class="net-mrow__name">Business apps</span>
              <span class="net-mrow__status" data-status>Offline</span>
            </li>
          </ol>
        </div>

        <ol class="net-mflow">
          <li class="net-mrow is-remote" data-node="remote">
            <span class="net-mrow__dot"></span>
            <span class="net-mrow__name">Remote employee</span>
            <span class="net-mrow__status" data-status>Away</span>
          </li>
        </ol>
      </div>

      
      <div class="net-foot">
        <span class="net-chip" data-chip><i class="net-chip__mark"></i>Connectivity</span>
        <span class="net-chip" data-chip><i class="net-chip__mark"></i>Infrastructure</span>
        <span class="net-chip" data-chip><i class="net-chip__mark"></i>Remote access</span>
        <span class="net-chip" data-chip><i class="net-chip__mark"></i>Monitored links</span>
      </div>

    </div>
  </div>
  <figcaption class="animation-caption">
    <span class="illustrative-badge">Illustrative</span>
    <p>An illustrative network connects its systems, then traces a Wi-Fi link issue through detection and recovery.</p>
    <button type="button" data-animation-toggle hidden>Pause animation</button>
  </figcaption>
</figure>

<style is:global>

.animation-network *, .animation-network *::before, .animation-network *::after { box-sizing: border-box; }

.animation-network .sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.animation-network .itk-net {
  --bg:            #070B14;
  --panel-top:     #0E1526;
  --panel-bottom:  #0A1020;
  --surface:       #0C1322;
  --surface-hi:    #121B2E;

  --line:          rgba(126, 156, 204, 0.14);
  --line-strong:   rgba(126, 156, 204, 0.26);

  --text:          #E8EEF9;
  --muted:         #8695B0;
  --dim:           #5D6B85;
  --blue:          #3B82F6;
  --blue-text:     #8FC0FF;
  --indigo:        #6366F1;
  --indigo-soft:   #818CF8;
  --indigo-text:   #A5B4FC;
  --electric:      #38BDF8;

  --cyan:          #22D3EE;
  --cyan-text:     #7EE3F5;

  --teal:          #2DD4A7;
  --amber:         #F0A93B;
  --amber-soft:    rgba(240, 169, 59, 0.5);

  --r-lg: 20px;
  --r-md: 12px;
  --r-sm: 10px;

  position: relative;
  padding: clamp(56px, 8vw, 112px) clamp(18px, 5vw, 64px);
  background:
    radial-gradient(120% 70% at 50% -12%, rgba(99, 102, 241, 0.085), transparent 60%),
    radial-gradient(120% 70% at 50% -12%, rgba(56, 189, 248, 0.05), transparent 64%),
    var(--bg);
}

.animation-network .itk-net__inner { max-width: 1180px; margin: 0 auto; }

.animation-network .itk-net .itk-eyebrow {
  display: inline-block;
  margin: 0 0 20px;
  padding: 6px 13px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--indigo-text);
  background: rgba(99, 102, 241, 0.07);
  border: 1px solid rgba(99, 102, 241, 0.22);
  border-radius: 999px;
}

.animation-network .itk-net__head h2 {
  margin: 0 0 16px;
  max-width: 24ch;
  font-size: clamp(27px, 3.4vw, 43px);
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: -0.02em;
  color: var(--text);
}

.animation-network .itk-net__lede {
  margin: 0 0 38px;
  max-width: 66ch;
  font-size: clamp(14.5px, 1.15vw, 16.5px);
  line-height: 1.65;
  color: var(--muted);
}

.animation-network .itk-net .itk-panel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 318px;
  overflow: hidden;
  background: linear-gradient(180deg, var(--panel-top) 0%, var(--panel-bottom) 100%);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow:
    0 42px 90px -52px rgba(0, 0, 0, 0.95),
    0 0 0 1px rgba(255, 255, 255, 0.015) inset;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-network .itk-net .itk-panel.is-in { opacity: 1; transform: none; }

.animation-network .net-stage {
  min-width: 0;
  padding: 20px 24px 26px;
  border-right: 1px solid var(--line);
}

.animation-network .net-stage__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.animation-network .net-stage__title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-network .net-head__badges {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.animation-network .net-live,
.animation-network .net-fault {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 12px 5px 10px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 999px;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.5s ease, transform 0.5s ease,
              color 0.5s ease, border-color 0.5s ease, background 0.5s ease;
}

.animation-network .net-live {
  color: var(--indigo-text);
  background: rgba(99, 102, 241, 0.09);
  border: 1px solid rgba(99, 102, 241, 0.22);
}

.animation-network .net-fault {
  color: #E8B978;
  background: rgba(240, 169, 59, 0.09);
  border: 1px solid rgba(240, 169, 59, 0.28);
}

.animation-network .net-live.is-on,
.animation-network .net-fault.is-on { opacity: 1; transform: none; }

.animation-network .net-fault.is-ok {
  color: #7FE0C4;
  background: rgba(45, 212, 167, 0.09);
  border-color: rgba(45, 212, 167, 0.28);
}

.animation-network .net-live i,
.animation-network .net-fault i {
  width: 6px; height: 6px;
  border-radius: 50%;
  flex: none;
}

.animation-network .net-live i {
  background: #7C8CFA;
  animation: offering-network-net-live-pulse 3.6s ease-out infinite;
}

.animation-network .net-fault i {
  background: var(--amber);
  animation: offering-network-net-fault-pulse 4.2s ease-out infinite;
}

.animation-network .net-fault.is-ok i {
  background: var(--teal);
  animation: offering-network-net-live-pulse 3.6s ease-out infinite;
}

@keyframes offering-network-net-live-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(124, 140, 250, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(124, 140, 250, 0); }
}

@keyframes offering-network-net-fault-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(240, 169, 59, 0.45); }
  70%, 100% { box-shadow: 0 0 0 6px rgba(240, 169, 59, 0); }
}

.animation-network .net-map {
  position: relative;
  width: 100%;
  max-width: 660px;
  margin: 14px auto 0;
  aspect-ratio: 16 / 11;
  overflow: visible;
}

.animation-network .net-map__svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}
.animation-network .net-link {
  fill: none;
  stroke: rgba(126, 156, 204, 0.20);
  stroke-width: 0.34;
  stroke-linecap: round;
  transition: stroke 0.6s ease, opacity 0.6s ease;
}

.animation-network .net-link.is-on { stroke: rgba(99, 102, 241, 0.62); }
.animation-network .net-link.is-vpn {
  stroke: rgba(34, 211, 238, 0.55);
  stroke-dasharray: 1.8 2.2;
  opacity: 0;
  transition: opacity 0.8s ease, stroke 0.6s ease;
}

.animation-network .net-link.is-vpn.is-on { opacity: 0.85; }
.animation-network .net-link.is-fault {
  stroke: var(--amber);
  stroke-width: 0.44;
}
.animation-network .net-flow {
  fill: none;
  stroke: var(--electric);
  stroke-width: 0.42;
  stroke-linecap: round;
  stroke-dasharray: 1.1 7.2;
  opacity: 0;
  transition: opacity 0.7s ease, stroke 0.6s ease;
}

.animation-network .net-flow.is-on {
  opacity: 0.85;
  animation: offering-network-net-flow-move 1.7s linear infinite;
}

.animation-network .net-flow.is-vpn.is-on {
  stroke: var(--cyan);
  stroke-dasharray: 0.9 5.4;
  animation-duration: 1.4s;
}

.animation-network .net-flow.is-fault.is-on {
  stroke: var(--amber);
  opacity: 0.9;
}

@keyframes offering-network-net-flow-move {
  to { stroke-dashoffset: -8.3; }
}

.animation-network .net-node {
  position: absolute;
  left: var(--x, 50%);
  top: var(--y, 50%);
  transform: translate(-50%, -50%) scale(0.95);
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 7px 12px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: linear-gradient(180deg, var(--surface-hi) 0%, var(--surface) 100%);
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  z-index: 2;
  transition:
    opacity 0.55s ease,
    transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.45s ease,
    box-shadow 0.45s ease;
}

.animation-network .net-node.is-on {
  opacity: 0.55;
  transform: translate(-50%, -50%) scale(1);
}

.animation-network .net-node.is-active { opacity: 1; }

.animation-network .net-node__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }

.animation-network .net-node__label {
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: #C3D2E8;
}

.animation-network .net-node__status {
  font-size: 12px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.03em;
  color: var(--dim);
  transition: color 0.45s ease;
}

.animation-network .net-node__dot {
  position: relative;
  flex: none;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #35415A;
  transition: background 0.45s ease, box-shadow 0.45s ease;
}
.animation-network .net-node.is-active {
  border-color: rgba(99, 102, 241, 0.42);
  box-shadow:
    0 0 0 1px rgba(99, 102, 241, 0.08),
    0 0 28px -10px rgba(99, 102, 241, 0.55);
}

.animation-network .net-node.is-active .net-node__dot {
  background: var(--indigo-soft);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.13);
}

.animation-network .net-node.is-active .net-node__status { color: var(--indigo-text); }

.animation-network .net-node.is-active .net-node__dot::after {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1px solid rgba(129, 140, 248, 0.45);
  animation: offering-network-net-node-ping 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  animation-delay: var(--ping, 0s);
}

@keyframes offering-network-net-node-ping {
  0%        { transform: scale(0.55); opacity: 0; }
  10%       { opacity: 0.55; }
  38%, 100% { transform: scale(2.3);  opacity: 0; }
}
.animation-network .net-node.is-core.is-active {
