}

.animation-network .net-node.is-remote.is-active .net-node__dot::after {
  border-color: rgba(34, 211, 238, 0.45);
}

.animation-network .net-node.is-remote.is-active .net-node__status { color: var(--cyan-text); }
.animation-network .net-node.is-fault {
  border-color: rgba(240, 169, 59, 0.52);
