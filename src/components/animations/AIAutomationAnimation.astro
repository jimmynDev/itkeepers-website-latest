            <span class="ai-request__label">Incoming request</span>
            <span class="ai-request__text">Customer asks for an updated quote</span>
          </span>
        </div>

        
        <svg class="ai-fork" data-fork viewBox="0 0 100 15" preserveAspectRatio="none">
          <path class="is-manual" d="M50 0 L50 6 L25 6 L25 15"></path>
          <path class="is-ai"     d="M50 0 L50 6 L75 6 L75 15"></path>
        </svg>

        <div class="ai-lanes">

          
          <div class="ai-lane ai-lane--manual" data-lane="manual">
            <div class="ai-lane__head" data-lane-head="manual">
              <span class="ai-lane__title">Manual example</span>
              <span class="ai-lane__tag" data-manual-tag>Repetitive</span>
            </div>

            <ol class="ai-steps">
              <li class="ai-step" data-mstep="0">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Employee reads request</span>
                <span class="ai-step__badge">Manual</span>
              </li>
              <li class="ai-step" data-mstep="1">
                <span class="ai-step__mark"></span>
