                <span class="ai-step__badge">Manual</span>
              </li>
              <li class="ai-step" data-mstep="2">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Switch between systems</span>
                <span class="ai-step__badge">Manual</span>
              </li>
              <li class="ai-step" data-mstep="3">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Response written</span>
                <span class="ai-step__badge">Manual</span>
              </li>
              <li class="ai-step" data-mstep="4">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Follow-up task created</span>
                <span class="ai-step__badge">Manual</span>
              </li>
            </ol>

            <div class="ai-loop" data-loop>
              <span class="ai-loop__glyph">&#8635;</span>
              <span>Repeated for every request, every day</span>
            </div>
          </div>

          
          <div class="ai-lane ai-lane--ai" data-lane="ai">
            <div class="ai-lane__head" data-lane-head="ai">
              <span class="ai-lane__title">Assisted example</span>
              <span class="ai-lane__tag" data-ai-tag>Assisted</span>
            </div>

            <ol class="ai-steps">
              <li class="ai-step" data-astep="0">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">AI understands &amp; categorizes</span>
                <span class="ai-step__badge">Assist</span>
              </li>
              <li class="ai-step" data-astep="1">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Relevant information retrieved</span>
                <span class="ai-step__badge">Assist</span>
              </li>
              <li class="ai-step" data-astep="2">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Workflow triggered</span>
                <span class="ai-step__badge">Automation</span>
              </li>
              <li class="ai-step" data-astep="3">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Draft / recommendation prepared</span>
                <span class="ai-step__badge">Draft</span>
              </li>
              <li class="ai-step is-human" data-astep="4">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Human reviews &amp; approves</span>
                <span class="ai-step__badge">Human</span>
              </li>
              <li class="ai-step is-done" data-astep="5">
                <span class="ai-step__mark"></span>
                <span class="ai-step__label">Action completed</span>
                <span class="ai-step__badge">Done</span>
              </li>
            </ol>
          </div>

        </div>

        
        <div class="ai-gov" data-gov>
          <span class="ai-gov__label">Governance</span>
          <span class="ai-gov__chip" data-gov-chip><i></i>Choose data sources</span>
          <span class="ai-gov__chip" data-gov-chip><i></i>Define access</span>
          <span class="ai-gov__chip" data-gov-chip><i></i>Human approval</span>
        </div>
      </div>

      
      <div class="ai-rail">
        <div class="ai-rail__head">
          <span class="ai-stage__title">Workflow</span>
        </div>

        <ol class="ai-rail__list">
          <li class="ai-item" data-rail="0">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Request arrives</span>
            <span class="ai-item__tag">Signal</span>
          </li>
          <li class="ai-item" data-rail="1" data-accent="muted">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Manual handling</span>
            <span class="ai-item__tag">Today</span>
          </li>
          <li class="ai-item" data-rail="2" data-accent="muted">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Repeated for every request</span>
            <span class="ai-item__tag">Repetitive</span>
          </li>
          <li class="ai-item" data-rail="3">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">AI understands &amp; categorizes</span>
            <span class="ai-item__tag">Assist</span>
          </li>
          <li class="ai-item" data-rail="4">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Information retrieved</span>
            <span class="ai-item__tag">Approved sources</span>
          </li>
          <li class="ai-item" data-rail="5">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Workflow triggered</span>
            <span class="ai-item__tag">Automation</span>
          </li>
          <li class="ai-item" data-rail="6">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Draft prepared</span>
            <span class="ai-item__tag">AI assist</span>
          </li>
          <li class="ai-item" data-rail="7" data-accent="human">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Human reviews &amp; approves</span>
            <span class="ai-item__tag">Control</span>
          </li>
          <li class="ai-item" data-rail="8" data-accent="ok">
            <span class="ai-item__dot"></span>
            <span class="ai-item__text">Action completed</span>
            <span class="ai-item__tag">Done</span>
          </li>
        </ol>

        <p class="ai-rail__note">
          AI assists the business — it does not take the decision away from your people.
        </p>
      </div>

      
      <div class="ai-mobile">
        <div class="ai-mobile__head">
          <span class="ai-stage__title">Request handling</span>
          <span class="ai-live" data-live><i></i> Active</span>
        </div>

        <div class="ai-mrequest" data-request>
          <span class="ai-request__dot"></span>
          <span class="ai-request__body">
            <span class="ai-request__label">Incoming request</span>
            <span class="ai-request__text">Customer asks for an updated quote</span>
          </span>
        </div>

        
        <div class="ai-mgroup ai-mgroup--manual" data-lane="manual">
          <div class="ai-mgroup__head">
            <span class="ai-lane__title">Manual example</span>
            <span class="ai-lane__tag" data-manual-tag>Repetitive</span>
          </div>

          <ol class="ai-msteps">
            <li class="ai-mstep" data-mstep="0">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">Employee reads request</span>
            </li>
            <li class="ai-mstep" data-mstep="1">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">Information copied</span>
            </li>
            <li class="ai-mstep" data-mstep="2">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">Switch between systems</span>
            </li>
            <li class="ai-mstep" data-mstep="3">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">Response written</span>
            </li>
            <li class="ai-mstep" data-mstep="4">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">Follow-up task created</span>
            </li>
          </ol>

          <div class="ai-mloop" data-loop>
            <span class="ai-loop__glyph">&#8635;</span>
            <span>Repeated for every request</span>
          </div>
        </div>

        
        <div class="ai-mgroup ai-mgroup--ai" data-lane="ai">
          <div class="ai-mgroup__head">
            <span class="ai-lane__title">Assisted example</span>
          </div>

          <ol class="ai-msteps">
            <li class="ai-mstep" data-astep="0">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">AI understands &amp; categorizes</span>
            </li>
            <li class="ai-mstep" data-astep="1">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">Relevant information retrieved</span>
            </li>
            <li class="ai-mstep" data-astep="2">
              <span class="ai-mstep__mark"></span>
              <span class="ai-mstep__label">Workflow triggered</span>
            </li>
            <li class="ai-mstep" data-astep="3">
              <span class="ai-mstep__mark"></span>
