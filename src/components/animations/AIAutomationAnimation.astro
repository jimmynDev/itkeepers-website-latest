  }

  function showManualStep(n) {
    all('[data-mstep="' + n + '"]').forEach(function (el) {
      el.classList.add("is-on");
    });
  }

  function showAiStep(n) {
    all('[data-astep="' + n + '"]').forEach(function (el) {
      el.classList.add("is-on");
    });
  }

  function rail(n) {
    var el = section.querySelector('[data-rail="' + n + '"]');
    if (el) el.classList.add("is-on");
  }

  function chip(n) {
    var el = all("[data-chip]")[n];
    if (el) el.classList.add("is-on");
  }

  /* ---------- timeline ---------- */

  function play() {
    panel.classList.add("is-in");

    /* interface wakes */
    at(220, function () {
      on("[data-live]", "is-on");
    });

    /* the request arrives */
    at(420, function () {
      all("[data-request]").forEach(function (el) {
        el.classList.add("is-on");
      });
      rail(0);
    });

    at(700, function () {
      all("[data-request]").forEach(function (el) {
        el.classList.add("is-active");
      });
      if (fork) fork.classList.add("is-on");
    });

    /* ---- the manual way, step by step: deliberately slower ---- */
    at(1050, function () {
      all('[data-lane-head="manual"]').forEach(function (el) {
        el.classList.add("is-on");
      });
    });

    at(1250, function () { showManualStep(0); });
    at(1600, function () { showManualStep(1); });
    at(1950, function () { showManualStep(2); });
    at(2300, function () { showManualStep(3); });
    at(2650, function () { showManualStep(4); });
    at(2950, function () { rail(1); });

    /* the loop — this is what makes it expensive */
    at(3250, function () {
      on("[data-loop]", "is-on");
      on("[data-manual-tag]", "is-on");
      rail(2);
    });

    /* ---- Assisted workflow enters, and the pace changes ---- */
    at(3800, function () {
      all('[data-lane-head="ai"]').forEach(function (el) {
        el.classList.add("is-on");
      });
      on("[data-ai-tag]", "is-on");
    });

    at(4050, function () { showAiStep(0); rail(3); });
    at(4320, function () { showAiStep(1); rail(4); });
    at(4590, function () { showAiStep(2); rail(5); });
    at(4860, function () { showAiStep(3); rail(6); });

    /* the human gate — held deliberately before the final action */
    at(5450, function () { showAiStep(4); rail(7); });

    /* only then, completion */
    at(6250, function () {
      showAiStep(5);
      rail(8);
      on("[data-live]", "is-ready");
    });

    /* governance becomes explicit */
    at(6650, function () {
      on("[data-gov]", "is-on");
      all("[data-gov-chip]").forEach(function (el, i) {
        later(function () {
          el.classList.add("is-on");
        }, i * 220);
      });
    });

    /* the old way recedes — automation is proven */
    at(7300, function () {
      all('[data-lane="manual"]').forEach(function (el) {
        el.classList.add("is-repetitive");
      });
    });

    /* final message */
    at(7600, function () { chip(0); });
    at(7850, function () { chip(1); });
    at(8100, function () { chip(2); });
  }

  /* ---------- reduced-motion / fallback final state ---------- */

  function settle() {
    panel.classList.add("is-in");

    on("[data-live]", "is-on is-ready");
    on("[data-chip]", "is-on");
    on("[data-loop]", "is-on");
    on("[data-manual-tag]", "is-on");
    on("[data-ai-tag]", "is-on");
    on("[data-gov]", "is-on");
    on("[data-gov-chip]", "is-on");
    on("[data-lane-head]", "is-on");

    all("[data-request]").forEach(function (el) {
      el.classList.add("is-on", "is-active");
    });

    if (fork) fork.classList.add("is-on");

    for (var i = 0; i < 5; i++) showManualStep(i);
    for (var j = 0; j < 6; j++) showAiStep(j);

    all('[data-lane="manual"]').forEach(function (el) {
      el.classList.add("is-repetitive");
    });

    for (var k = 0; k <= 8; k++) rail(k);
  }
      return { play, settle, duration: 9300 };
    });
  });
</script>
