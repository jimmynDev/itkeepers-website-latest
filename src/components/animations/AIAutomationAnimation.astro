<style is:global>

.animation-ai *, .animation-ai *::before, .animation-ai *::after { box-sizing: border-box; }

.animation-ai .sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.animation-ai .itk-ai {
  --bg:            #070B14;
  --panel-top:     #0E1526;
  --panel-bottom:  #0A1020;
  --surface:       #0C1322;
  --surface-hi:    #121B2E;

  --line:          rgba(126, 156, 204, 0.14);
  --line-strong:   rgba(126, 156, 204, 0.26);

  --text:          #E8EEF9;
  --muted:         #8695B0;
  --dim:           #5D6B85;
  --blue:          #3B82F6;
  --blue-soft:     #60A5FA;
  --blue-text:     #8FC0FF;
  --violet:        #8B5CF6;
  --violet-soft:   #A78BFA;
  --violet-text:   #C4B5FD;
  --violet-dim:    rgba(139, 92, 246, 0.16);
  --teal:          #2DD4A7;
  --teal-text:     #6FD9BC;

  --r-lg: 20px;
  --r-md: 12px;
  --r-sm: 10px;

  position: relative;
  padding: clamp(56px, 8vw, 112px) clamp(18px, 5vw, 64px);
  background:
    radial-gradient(120% 70% at 50% -12%, rgba(139, 92, 246, 0.085), transparent 60%),
    radial-gradient(120% 70% at 50% -12%, rgba(59, 130, 246, 0.06), transparent 66%),
    var(--bg);
}

.animation-ai .itk-ai__inner { max-width: 1180px; margin: 0 auto; }

.animation-ai .itk-ai .itk-eyebrow {
  display: inline-block;
  margin: 0 0 20px;
  padding: 6px 13px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--violet-text);
  background: rgba(139, 92, 246, 0.07);
  border: 1px solid rgba(139, 92, 246, 0.22);
  border-radius: 999px;
}

.animation-ai .itk-ai__head h2 {
  margin: 0 0 16px;
  max-width: 24ch;
  font-size: clamp(27px, 3.4vw, 43px);
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: -0.02em;
  color: var(--text);
}

.animation-ai .itk-ai__lede {
  margin: 0 0 38px;
  max-width: 66ch;
  font-size: clamp(14.5px, 1.15vw, 16.5px);
  line-height: 1.65;
  color: var(--muted);
}

.animation-ai .itk-ai .itk-panel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  overflow: hidden;
  background: linear-gradient(180deg, var(--panel-top) 0%, var(--panel-bottom) 100%);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow:
    0 42px 90px -52px rgba(0, 0, 0, 0.95),
    0 0 0 1px rgba(255, 255, 255, 0.015) inset;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-ai .itk-ai .itk-panel.is-in { opacity: 1; transform: none; }

.animation-ai .ai-stage {
  min-width: 0;
  padding: 20px 24px 24px;
  border-right: 1px solid var(--line);
}

.animation-ai .ai-stage__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.animation-ai .ai-stage__title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-ai .ai-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 12px 5px 10px;
  font-size: 12px;
  font-weight: 600;
  color: var(--violet-text);
  background: rgba(139, 92, 246, 0.08);
  border: 1px solid rgba(139, 92, 246, 0.22);
  border-radius: 999px;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.5s ease, transform 0.5s ease,
              color 0.5s ease, border-color 0.5s ease, background 0.5s ease;
}

.animation-ai .ai-live.is-on { opacity: 1; transform: none; }

.animation-ai .ai-live.is-ready {
  color: var(--teal-text);
  background: rgba(45, 212, 167, 0.08);
  border-color: rgba(45, 212, 167, 0.26);
}

.animation-ai .ai-live i {
  width: 6px; height: 6px;
  border-radius: 50%;
  flex: none;
  background: var(--violet-soft);
  animation: offering-ai-ai-live-pulse 3.6s ease-out infinite;
  transition: background 0.5s ease;
}

.animation-ai .ai-live.is-ready i {
  background: var(--teal);
  animation: offering-ai-ai-teal-pulse 4s ease-out infinite;
}

@keyframes offering-ai-ai-live-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(167, 139, 250, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(167, 139, 250, 0); }
}

@keyframes offering-ai-ai-teal-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(45, 212, 167, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(45, 212, 167, 0); }
}

.animation-ai .ai-request {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
  padding: 13px 16px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: linear-gradient(180deg, var(--surface-hi) 0%, var(--surface) 100%);
  opacity: 0;
  transform: translateY(-6px);
  transition:
    opacity 0.6s ease,
    transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.5s ease,
    box-shadow 0.5s ease;
}

.animation-ai .ai-request.is-on { opacity: 1; transform: none; }

.animation-ai .ai-request.is-active {
  border-color: rgba(139, 92, 246, 0.40);
  box-shadow: 0 0 30px -12px rgba(139, 92, 246, 0.6);
}

.animation-ai .ai-request__dot {
  position: relative;
  flex: none;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--violet-soft);
  box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.14);
}

.animation-ai .ai-request.is-active .ai-request__dot::after {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1px solid rgba(167, 139, 250, 0.5);
  animation: offering-ai-ai-req-ping 5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes offering-ai-ai-req-ping {
  0%        { transform: scale(0.6); opacity: 0; }
  12%       { opacity: 0.6; }
  44%, 100% { transform: scale(2.2); opacity: 0; }
}

.animation-ai .ai-request__body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.animation-ai .ai-request__label {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-ai .ai-request__text {
  font-size: 13px;
  font-weight: 550;
  line-height: 1.3;
  color: #C9D8EE;
}

.animation-ai .ai-fork {
  display: block;
  width: 100%;
  height: 15px;
  margin: 2px 0 0;
  overflow: visible;
}

.animation-ai .ai-fork path {
  fill: none;
  stroke: rgba(126, 156, 204, 0.30);
  stroke-width: 1;
  stroke-linecap: round;
  vector-effect: non-scaling-stroke;
  stroke-dasharray: 30;
  stroke-dashoffset: 30;
  transition: stroke-dashoffset 0.7s cubic-bezier(0.4, 0, 0.2, 1),
              stroke 0.6s ease;
}

.animation-ai .ai-fork.is-on path { stroke-dashoffset: 0; }
.animation-ai .ai-fork.is-on path.is-manual { stroke: rgba(126, 156, 204, 0.24); }
.animation-ai .ai-fork.is-on path.is-ai     { stroke: rgba(139, 92, 246, 0.55); }

.animation-ai .ai-lanes {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 22px;
  align-items: start;
}

.animation-ai .ai-lane { min-width: 0; }

.animation-ai .ai-lane--manual {
  padding-right: 22px;
  border-right: 1px solid var(--line);
  transition: opacity 0.8s ease;
}
.animation-ai .ai-lane--manual.is-repetitive { opacity: 1; }

.animation-ai .ai-lane__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 22px;
  margin-bottom: 12px;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.55s ease, transform 0.55s ease;
}

.animation-ai .ai-lane__head.is-on { opacity: 1; transform: none; }

.animation-ai .ai-lane__title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-ai .ai-lane--ai .ai-lane__title { color: var(--violet-text); }

.animation-ai .ai-lane__tag {
  padding: 3px 9px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #9AA7BC;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid var(--line);
  border-radius: 999px;
  white-space: nowrap;
  opacity: 0;
  transform: scale(0.88);
  transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-ai .ai-lane__tag.is-on { opacity: 1; transform: none; }

.animation-ai .ai-steps {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.animation-ai .ai-step {
  position: relative;
  display: grid;
  grid-template-columns: 17px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  opacity: 0.3;
  transform: translateX(-4px);
  transition:
    opacity 0.5s ease,
    transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.5s ease,
    background 0.5s ease,
    box-shadow 0.5s ease;
}

.animation-ai .ai-step.is-on {
  opacity: 1;
  transform: none;
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.02);
}

.animation-ai .ai-step__mark {
  position: relative;
  flex: none;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: #2C3852;
  transition: background 0.5s ease, box-shadow 0.5s ease, color 0.5s ease;
}

.animation-ai .ai-step__label {
  font-size: 12.5px;
  font-weight: 500;
  line-height: 1.3;
  color: #93A5C0;
  transition: color 0.5s ease;
}

.animation-ai .ai-step.is-on .ai-step__label { color: #C6D6EE; }

.animation-ai .ai-step__badge {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--dim);
  white-space: nowrap;
  opacity: 0;
  transform: scale(0.86);
  transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-ai .ai-step.is-on .ai-step__badge { opacity: 1; transform: none; }
.animation-ai .ai-lane--manual .ai-step.is-on {
  border-color: rgba(126, 156, 204, 0.16);
