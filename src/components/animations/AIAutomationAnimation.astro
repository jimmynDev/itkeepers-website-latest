<!-- Adapted from AI&Automation.html; illustrative, local-only prototype data. -->
<figure class="offering-animation animation-ai" data-animation="ai">
  <div class="itk-ai" data-animation-visual aria-hidden="true">
    <div class="itk-panel" aria-hidden="true">

      
      <div class="ai-stage">
        <div class="ai-stage__head">
          <span class="ai-stage__title">Request handling</span>
          <span class="ai-live" data-live><i></i> Workflow example</span>
