            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
      </div>

      <!-- 2. Microsoft 365 / Cloud -->
      <div class="orbit-node node-right">
        <div class="node-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.5 19c2.5 0 4.5-2 4.5-4.5 0-2.29-1.7-4.18-3.92-4.47a7.5 7.5 0 0 0-14.36 1.93A4.5 4.5 0 0 0 6.5 19h11z"></path>
          </svg>
        </div>
      </div>

      <!-- 3. Policy / Security -->
      <div class="orbit-node node-bottom">
        <div class="node-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
