</div>
</figure>
<style>

/* Base Container Options */
.itk-badge-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
  background: transparent;
  height: var(--service-art-size,360px);
}

/* 180px x 180px Compact Micro Card */
.itk-shield-card {
  position: relative;
  width: 180px;
  height: 180px;
  flex-shrink: 0;
  transform: scale(var(--service-badge-scale,1.8));
  border-radius: 20px;
  background: transparent;
  border: 1px solid transparent;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Ambient Backlight Glow */
.badge-ambient-glow {
  position: absolute;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 211, 238, 0.22) 0%, rgba(59, 130, 246, 0.12) 50%, transparent 100%);
  filter: blur(16px);
  pointer-events: none;
}

/* Circular Orbit Track Line */
.orbit-track {
  position: absolute;
  width: 122px;
  height: 122px;
  border-radius: 50%;
  border: 1px dashed rgba(126, 156, 204, 0.16);
}

/* Rotating Spinner Layer */
.orbit-spinner {
  position: absolute;
  width: 122px;
  height: 122px;
  animation: orbit-rotate 16s linear infinite;
}

/* Micro Orbiting Node Positioning */
.orbit-node {
  position: absolute;
  width: 26px;
  height: 26px;
  margin: -13px;
  border-radius: 50%;
  background: #0C1322;
  border: 1px solid rgba(59, 130, 246, 0.35);
  box-shadow: 0 0 10px rgba(59, 130, 246, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.node-top    { top: 0%;   left: 50%; }
.node-right  { top: 50%;  left: 100%; }
.node-bottom { top: 100%; left: 50%; }
.node-left   { top: 50%;  left: 0%; }

/* Counter-Rotation Keeps Micro-Icons Upright */
.node-icon {
  width: 13px;
  height: 13px;
  color: #7EE3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: orbit-counter-rotate 16s linear infinite;
}

.node-icon svg {
  width: 100%;
  height: 100%;
}

/* Pulsing Radar Waves */
.pulse-ring {
  position: absolute;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  border: 1px solid rgba(34, 211, 238, 0.4);
  opacity: 0;
  animation: shield-pulse 3.6s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
}

.pulse-ring.ring-2 {
  animation-delay: 1.8s;
}

/* Central Shield Centerpiece */
.shield-hub {
  position: relative;
  z-index: 2;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: radial-gradient(circle at 50% 20%, rgba(59, 130, 246, 0.35), #0A1020 80%);
  border: 1px solid rgba(59, 130, 246, 0.5);
  box-shadow: 
    0 0 20px rgba(59, 130, 246, 0.45),
    0 0 10px rgba(34, 211, 238, 0.2) inset;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shield-svg {
  width: 22px;
  height: 22px;
  color: #8FC0FF;
}

.shield-check {
  stroke: #22D3EE;
}

/* Keyframe Animations */
@keyframes orbit-rotate {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes orbit-counter-rotate {
  from { transform: rotate(0deg); }
  to   { transform: rotate(-360deg); }
}

@keyframes shield-pulse {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  80%, 100% {
    transform: scale(2.2);
    opacity: 0;
  }
}

/* Respect Motion Preferences */
@media (max-width: 900px) {
  .itk-badge-wrapper { height: var(--service-art-size,280px); }
  .itk-shield-card { transform: scale(var(--service-badge-scale,1.35)); }
}
@media (prefers-reduced-motion: reduce) {
  .orbit-spinner,
  .node-icon,
  .pulse-ring {
    animation: none !important;
  }
}

  .animation-security-badge { margin: 0; }
  .animation-security-badge.is-idle :global(*) { animation-play-state: paused !important; }
  .animation-security-badge[data-animation-state="settled"] :global(*) { animation: none !important; transition: none !important; }
</style>
<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('.animation-security-badge').forEach(root => {
    mountAnimation(root, () => ({
      play() {},
      settle() {},
      duration: 16000,
    }));
  });
</script>
