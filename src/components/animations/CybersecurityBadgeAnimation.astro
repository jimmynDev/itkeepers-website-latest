<!-- Owner-supplied shield/orbit animation; scoped to the homepage services stage. -->
<figure class="offering-animation animation-security animation-security-badge" data-animation="security-badge" role="img" aria-label="Cybersecurity shield surrounded by identity, cloud, policy and endpoint icons">
