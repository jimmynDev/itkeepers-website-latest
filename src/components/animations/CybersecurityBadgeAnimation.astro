<style>



.cs{--itk:#42BAEB;--cloud:#5AA9FF;--ok:var(--itk-success,#2DD4A7);--threat:#FF7A45;
  --surface:var(--surface-2,#0E1B2E);--surface-hi:var(--surface-3,#13243C);
  --text:var(--itk-text,#E8F1FA);--muted:var(--itk-muted,#8FA6BF);
  --ease:cubic-bezier(.33,0,.15,1);
  width:100%;max-width:640px;margin-inline:auto}
.cs-svg{display:block;width:100%;height:auto;overflow:visible}
.cs-mobile{display:none}
/* Keep the approved circular artwork and its uniform SVG scaling on mobile. */
@media (max-width:640px){.cs{max-width:360px}}

/* Layers */
.cs-fill{fill:#5AA9FF;fill-opacity:.028}
.f-identity{fill-opacity:.06}.f-endpoint{fill-opacity:.045}
.cs-ring{fill:none;stroke:var(--cloud);stroke-opacity:.42;stroke-width:1.2;stroke-dasharray:1;stroke-dashoffset:1}
.r-identity{stroke-opacity:.7;stroke-width:1.4}
.cs-ring-2{stroke-opacity:.10}
.r-recovery{stroke-opacity:.26}
.f-recovery{fill-opacity:.012}
.cs-hl{fill:none;stroke:var(--itk);stroke-width:2.2;opacity:0}
.cs-flow{fill:none;stroke:var(--itk);stroke-width:1.4;stroke-dasharray:.006 .024;opacity:0;transform-box:view-box}
.cs-opnode{fill:var(--surface-hi);stroke:var(--itk);stroke-width:1.2}
.cs-arc{fill:none;stroke:var(--itk);stroke-width:3;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;filter:drop-shadow(0 0 6px rgba(66,186,235,.55))}
.cs-glow{opacity:0}

/* Pills */
.cs-pill-bg{fill:var(--surface);stroke:rgba(90,169,255,.4);stroke-width:1;filter:drop-shadow(0 4px 10px rgba(0,8,20,.5))}
.p-ops .cs-pill-bg{stroke:rgba(66,186,235,.7)}
.p-recovery .cs-pill-bg{stroke:rgba(90,169,255,.34);fill:rgba(14,27,46,.72)}
.p-recovery .cs-lbl{fill:var(--muted)}
.cs-ico path,.cs-ico circle{fill:none;stroke:var(--cloud);stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.p-ops .cs-ico path,.p-ops .cs-ico circle{stroke:var(--itk)}
.cs-ops-ico path,.cs-ops-ico circle{fill:none;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}
.cs-lbl{fill:var(--text);font:600 13px/1 var(--font-sans,Inter,system-ui,-apple-system,"Segoe UI",sans-serif);letter-spacing:.02em}
.cs-dot{fill:var(--cloud);opacity:.35;transition:fill 1.2s,opacity 1.2s}

/* Core */
.cs-core-bg{fill:var(--surface-hi);stroke:rgba(90,169,255,.6);stroke-width:1.2;filter:drop-shadow(0 8px 20px rgba(0,8,20,.55))}
.cs-core-ok{fill:none;stroke:var(--ok);stroke-width:1.6;opacity:0}
.cs-core-ico path{fill:none;stroke:var(--text);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.cs-core-lbl{fill:var(--muted);font:600 10px/1 var(--font-sans,Inter,system-ui,sans-serif);letter-spacing:.14em;text-transform:uppercase;text-anchor:middle}

/* Threat — the only warm colour */
.cs-threat{opacity:0;transform:translate(var(--x0),var(--y0))}
.cs-t-core{fill:var(--threat)}
.cs-t-halo{fill:var(--threat);opacity:.18}
.cs-t-cage{fill:none;stroke:var(--itk);stroke-width:1.4;stroke-dasharray:1;stroke-dashoffset:1}

.cs-a{opacity:0;transform-box:fill-box;transform-origin:center}

/* ============ PLAY (settles at 5.0s) ============ */
[data-phase=play] .cs-glow{animation:csFade 1.5s var(--ease) forwards}
/* Present the business anchor during the shared entrance, without a second fade. */
.cs .cs-core{opacity:1;transform:none}
[data-phase=play] .f-identity,[data-phase=play] .p-identity{animation:csIn .5s var(--ease) .1s forwards}
[data-phase=play] .r-identity{animation:csDraw .55s var(--ease) 0s forwards}
[data-phase=play] .f-endpoint,[data-phase=play] .p-endpoint{animation:csIn .5s var(--ease) .4s forwards}
[data-phase=play] .r-endpoint{animation:csDraw .55s var(--ease) .35s forwards}
[data-phase=play] .f-network,[data-phase=play] .p-network{animation:csIn .5s var(--ease) .7s forwards}
[data-phase=play] .r-network{animation:csDraw .55s var(--ease) .65s forwards,csNetStrong .8s var(--ease) 3.2s}
[data-phase=play] .f-ops,[data-phase=play] .p-ops{animation:csIn .5s var(--ease) 1s forwards}
[data-phase=play] .cs-opnode{animation:csIn .5s var(--ease) 1s forwards,csOpPulse .7s var(--ease) 3.95s}
[data-phase=play] .r-ops{animation:csDraw .55s var(--ease) .95s forwards}
[data-phase=play] .f-recovery,[data-phase=play] .p-recovery{animation:csIn .5s var(--ease) 1.3s forwards}
[data-phase=play] .r-recovery{animation:csDraw .6s var(--ease) 1.25s forwards}

[data-phase=play] .cs-threat{animation:csThreat 1s var(--ease) 2.2s forwards,csThreatOut .4s var(--ease) 3.65s forwards}
[data-phase=play] .h-network{animation:csFlash .8s var(--ease) 3.2s}
[data-phase=play] .cs-arc{animation:csDraw .35s var(--ease) 3.2s forwards,csArcOut .6s var(--ease) 4s forwards}
[data-phase=play] .cs-t-cage{animation:csDraw .35s var(--ease) 3.3s forwards}
[data-phase=play] .cs-t-core,[data-phase=play] .cs-t-halo{animation:csDim .3s var(--ease) 3.45s forwards}
[data-phase=play] .h-ops{animation:csFlash .6s var(--ease) 3.95s}
[data-phase=play] .p-ops .cs-pill-bg{animation:csOpsPing .7s var(--ease) 3.95s}
[data-phase=play] .h-endpoint{animation:csFlash .5s var(--ease) 4.25s}
[data-phase=play] .h-identity{animation:csFlash .5s var(--ease) 4.4s}
[data-phase=play] .cs-core-ok{animation:csFade .5s var(--ease) 4.5s forwards}
[data-phase=play] .cs-dot{animation:csOkDot .3s var(--ease) forwards}
[data-phase=play] .p-recovery .cs-dot{animation-delay:4.5s}
[data-phase=play] .p-ops .cs-dot{animation-delay:4.55s}
[data-phase=play] .p-network .cs-dot{animation-delay:4.6s}
[data-phase=play] .p-endpoint .cs-dot{animation-delay:4.65s}
[data-phase=play] .p-identity .cs-dot{animation-delay:4.7s}

/* ============ SETTLED: quiet final frame ============ */
[data-phase=settled] .cs-a,[data-phase=settled] .cs-glow{opacity:1;transform:none}
[data-phase=settled] .cs-ring{stroke-dashoffset:0}
[data-phase=settled] .cs-core-ok{opacity:1;animation:none}
[data-phase=settled] .cs-dot{fill:var(--ok);opacity:1}
[data-phase=settled] .p-recovery .cs-lbl{fill:var(--text)}
[data-phase=settled] .cs-glow{opacity:.82;animation:none}
[data-phase=settled] .cs-flow{opacity:.22;animation:csFlow 42s linear infinite}
[data-phase=settled] .cs-orbit{
  animation: orbitOps 110s linear infinite;
  transform-box: view-box;
  transform-origin: 320px 300px;
}

@keyframes csIn{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}
@keyframes csDraw{to{stroke-dashoffset:0}}
@keyframes csFade{to{opacity:1}}
@keyframes csFlash{0%{opacity:0}35%{opacity:.85}100%{opacity:0}}
@keyframes csOpsPing{40%{stroke:var(--itk);stroke-width:2}}
@keyframes csThreat{0%{opacity:0;transform:translate(var(--x0),var(--y0))}20%{opacity:1}100%{opacity:1;transform:translate(var(--x3),var(--y1))}}
@keyframes csThreatOut{from{opacity:1;transform:translate(var(--x3),var(--y1)) scale(1)}to{opacity:0;transform:translate(var(--x3),var(--y1)) scale(.3)}}
@keyframes csNetStrong{0%,100%{stroke-opacity:.42;stroke-width:1.2}35%{stroke-opacity:.95;stroke-width:2}}
@keyframes csOpPulse{0%,100%{stroke-width:1.2;fill:var(--surface-hi)}40%{stroke-width:2.2;fill:rgba(66,186,235,.35)}}
@keyframes csDim{to{fill:#8FA6BF}}
@keyframes csArcOut{to{opacity:0}}
@keyframes csOkDot{to{fill:var(--ok);opacity:1}}
@keyframes csFlow{to{stroke-dashoffset:-1}}
@keyframes orbitOps{to{transform:rotate(360deg)}}

@media (prefers-reduced-motion:reduce){
  .cs .cs-a,.cs .cs-glow{opacity:1!important;transform:none!important;animation:none!important}
  .cs .cs-ring{stroke-dashoffset:0!important;animation:none!important}
  .cs .cs-core-ok{opacity:1!important;animation:none!important}
  .cs .cs-dot{fill:var(--ok)!important;opacity:1!important;animation:none!important}
  .cs .cs-threat,.cs .cs-arc,.cs .cs-flow,.cs .cs-hl{display:none}
  .cs .cs-ring,.cs .cs-opnode,.cs .cs-pill-bg{animation:none!important}
  .cs .cs-orbit{animation:none!important}
}


 .animation-security-badge { position:relative; margin:0; }
 .cs[data-motion="paused"] :global(*) { animation-play-state:paused!important; }
 .cs[data-motion="running"] :global(*) { animation-play-state:running; }
 .cs[data-phase="settled"] .cs-orbit { pointer-events:none; }
 :global([data-hero-theme="day"]) .cs { --surface:#f4f7fb; --surface-hi:#e9f3fa; --text:var(--n); --muted:#42566f; --cloud:#2763a5; --itk:#075d7d; --ok:#207644; } :global([data-hero-theme="day"]) .p-recovery .cs-pill-bg { fill:#f4f7fb; }
 @media (prefers-reduced-motion:reduce) { .cs :global(*) { animation:none!important; transition:none!important; } }
 @media (forced-colors:active) { .cs text { fill:CanvasText; } .cs :is(.cs-pill-bg,.cs-core-bg) { fill:Canvas; stroke:CanvasText; } }
</style>
<script>
import { mountAnimation } from '../../scripts/animation-lifecycle';
