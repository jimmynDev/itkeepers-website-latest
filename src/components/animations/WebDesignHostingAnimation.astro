          </ol>
        </div>
      </div>

      
      <div class="web-rail">
        <div class="web-rail__head">
          <span class="web-stage__title">Lifecycle</span>
        </div>

        <ol class="web-rail__list">
          <li class="web-item" data-rail="0" data-accent="muted">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Wireframe</span>
            <span class="web-item__tag">Idea</span>
          </li>
          <li class="web-item" data-rail="1" data-accent="muted">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Structure</span>
            <span class="web-item__tag">Layout</span>
          </li>
          <li class="web-item" data-rail="2">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Design</span>
            <span class="web-item__tag">Visual</span>
          </li>
          <li class="web-item" data-rail="3">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Responsive layout</span>
            <span class="web-item__tag">Devices</span>
          </li>
          <li class="web-item" data-rail="4">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Development</span>
            <span class="web-item__tag">Build</span>
          </li>
          <li class="web-item" data-rail="5" data-accent="cyan">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Security</span>
            <span class="web-item__tag">SSL</span>
          </li>
          <li class="web-item" data-rail="6" data-accent="cyan">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Performance optimisation</span>
            <span class="web-item__tag">Speed</span>
          </li>
          <li class="web-item" data-rail="7" data-accent="ok">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Deployment</span>
            <span class="web-item__tag">Published</span>
          </li>
          <li class="web-item" data-rail="8" data-accent="ok">
            <span class="web-item__dot"></span>
            <span class="web-item__text">Monitoring &amp; maintenance</span>
            <span class="web-item__tag">Ongoing</span>
