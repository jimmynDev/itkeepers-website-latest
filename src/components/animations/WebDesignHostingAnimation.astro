  transition: min-height 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.animation-web .web-foot {
  display: block;
  flex: none;
  width: 100%;
  height: 11px;
  border-radius: 4px;
}

.animation-web .web-nav__logo,
.animation-web .web-nav__links i,
.animation-web .web-line,
.animation-web .web-btn,
.animation-web .web-hero__media,
.animation-web .web-card,
.animation-web .web-foot {
  background: transparent;
  border: 1px dashed rgba(126, 156, 204, 0.26);
  opacity: 0;
  transform: scale(0.94);
  transition:
    opacity 0.5s ease,
    transform 0.62s cubic-bezier(0.34, 1.4, 0.64, 1),
    background 0.8s ease,
    border-color 0.8s ease,
    box-shadow 0.8s ease,
    min-height 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-web .web-nav__logo.is-on,
.animation-web .web-nav__links i.is-on,
.animation-web .web-line.is-on,
.animation-web .web-btn.is-on,
.animation-web .web-hero__media.is-on,
.animation-web .web-card.is-on,
.animation-web .web-foot.is-on {
  opacity: 1;
  transform: none;
}
@keyframes offering-web-web-snap {
