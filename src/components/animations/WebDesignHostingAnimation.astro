<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('.animation-web').forEach(root => {
    mountAnimation(root, ({ later }) => {
      const section = root.querySelector('.itk-web');

  var panel     = section.querySelector(".itk-panel");
  var stage     = section.querySelector("[data-stage]");
  var device    = section.querySelector("[data-device]");
  var page      = section.querySelector("[data-page]");
  var liveBadge = section.querySelector("[data-live]");
  var urlPill   = section.querySelector("[data-url-pill]");
  var urlText   = section.querySelector("[data-url]");
  var lock      = section.querySelector("[data-lock]");
  var deployEl  = section.querySelector("[data-deploy]");

  /* ---------- helpers ---------- */

  function at(ms, fn) { later(fn, ms); }

  function all(sel) { return section.querySelectorAll(sel); }

  function on(sel, cls) {
    all(sel).forEach(function (el) { el.classList.add(...cls.split(/\s+/)); });
  }

  function rail(n) {
    var el = section.querySelector('[data-rail="' + n + '"]');
    if (el) el.classList.add("is-on");
    var m = section.querySelector('[data-mrow="' + n + '"]');
    if (m) m.classList.add("is-on");
  }

  function chip(n) {
    var el = all("[data-chip]")[n];
    if (el) el.classList.add("is-on");
  }

  /* reveal the wireframe blocks with a short stagger */
  function revealBlocks() {
    var blocks = page.querySelectorAll(
      ".web-nav__logo, .web-nav__links i, .web-line, .web-btn," +
      ".web-hero__media, .web-card, .web-foot"
    );

    Array.prototype.forEach.call(blocks, function (el, i) {
      later(function () {
        el.classList.add("is-on");
      }, i * 45);
    });
  }

  /* ---------- timeline ---------- */

  function play() {
    panel.classList.add("is-in");

    /* interface wakes */
    at(200, function () {
      if (liveBadge) liveBadge.classList.add("is-on");
    });

    /* the canvas and the browser frame appear */
    at(380, function () {
      if (stage) stage.classList.add("is-lit");
      if (device) device.classList.add("is-on");
    });

    /* wireframe blocks appear, dashed and rough */
    at(760, function () {
      revealBlocks();
      rail(0);
    });

    /* structure — everything locks into the grid */
    at(1500, function () {
      page.classList.add("is-snap");
      rail(1);
      later(function () {
        page.classList.remove("is-snap");
      }, 700);
    });

    /* design — colour, typography and imagery apply */
    at(2150, function () {
      page.classList.add("is-designed");
      rail(2);
    });

    /* responsive demonstration */
    at(2950, function () {
      device.classList.add("is-tablet");
      rail(3);
    });

    at(3700, function () {
      device.classList.remove("is-tablet");
      device.classList.add("is-mobile");
    });

    at(4600, function () {
      device.classList.remove("is-mobile");
    });

    /* development complete */
    at(5250, function () {
      rail(4);
    });

    /* security — HTTPS check */
    at(5850, function () {
      if (lock) lock.classList.add("is-on");
      device.classList.add("is-secured");
      rail(5);
    });

    /* performance optimisation */
    at(6450, function () {
      page.classList.add("is-optimized");
      rail(6);
    });

    /* deployment — staging becomes live */
    at(7050, function () {
      device.classList.add("is-live");
      if (deployEl) deployEl.textContent = "Published";
      if (urlText) urlText.textContent = "Published example";
      if (urlPill) {
        urlPill.classList.add("is-flash");
        later(function () {
          urlPill.classList.remove("is-flash");
        }, 850);
      }
      if (liveBadge) {
        liveBadge.classList.add("is-live");
        liveBadge.innerHTML = "<i></i> Published";
      }
      rail(7);
    });

    /* hosting & maintenance — the part most agencies skip */
    at(7750, function () {
      on("[data-hosting]", "is-on");
    });

    ["ssl", "mon", "bak", "perf", "upd"].forEach(function (key, i) {
      at(8000 + i * 230, function () {
        var el = section.querySelector('[data-hchip="' + key + '"]');
        if (el) el.classList.add("is-on");
      });
    });

    /* monitoring & maintenance becomes the steady state */
    at(9450, function () {
      rail(8);
    });

    /* final state */
    at(9800, function () { chip(0); });
    at(10050, function () { chip(1); });
    at(10300, function () { chip(2); });
    at(10550, function () { chip(3); });
  }

  /* ---------- reduced-motion / fallback final state ---------- */

  function settle() {
    panel.classList.add("is-in");

    device?.classList.remove("is-tablet", "is-mobile");
    page?.classList.remove("is-snap");

    if (stage) stage.classList.add("is-lit");
    if (device) device.classList.add("is-on", "is-secured", "is-live");
    if (page) page.classList.add("is-designed", "is-optimized");

    if (lock) lock.classList.add("is-on");
    if (deployEl) deployEl.textContent = "Published";
    if (urlText) urlText.textContent = "Published example";

    if (liveBadge) {
      liveBadge.classList.add("is-on", "is-live");
      liveBadge.innerHTML = "<i></i> Published";
    }

    page.querySelectorAll(
      ".web-nav__logo, .web-nav__links i, .web-line, .web-btn," +
      ".web-hero__media, .web-card, .web-foot"
    ).forEach(function (el) { el.classList.add("is-on"); });

    on("[data-hosting]", "is-on");
    on("[data-hchip]", "is-on");
    on("[data-chip]", "is-on");

    for (var i = 0; i <= 8; i++) rail(i);
  }
      return { play, settle, duration: 11800 };
    });
  });
</script>
