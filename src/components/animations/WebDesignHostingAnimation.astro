              <span class="web-mrow__tag">Published</span>
            </li>
            <li class="web-mrow" data-mrow="8" data-accent="ok">
              <span class="web-mrow__dot"></span>
              <span class="web-mrow__name">Monitoring &amp; maintenance</span>
              <span class="web-mrow__tag">Ongoing</span>
