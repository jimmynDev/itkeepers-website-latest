        </p>
      </div>

      
      <div class="web-footbar">
        <span class="web-chip web-chip--violet" data-chip>
          <i class="web-chip__mark"></i>Designed
        </span>
        <span class="web-chip web-chip--teal" data-chip>
          <i class="web-chip__mark"></i>Deployed
        </span>
        <span class="web-chip web-chip--cyan" data-chip>
          <i class="web-chip__mark"></i>Reviewed
        </span>
        <span class="web-chip web-chip--teal" data-chip>
          <i class="web-chip__mark"></i>Maintenance plan
        </span>
      </div>

    </div>
  </div>
</figure>

<style is:global>

.animation-web *, .animation-web *::before, .animation-web *::after { box-sizing: border-box; }

.animation-web .sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.animation-web .itk-web {
  --bg:            #070B14;
  --panel-top:     #0E1526;
  --panel-bottom:  #0A1020;
  --surface:       #0C1322;
  --surface-hi:    #121B2E;

  --line:          rgba(126, 156, 204, 0.14);
  --line-strong:   rgba(126, 156, 204, 0.26);

  --text:          #E8EEF9;
  --muted:         #8695B0;
  --dim:           #5D6B85;
  --blue:          #3B82F6;
  --blue-soft:     #60A5FA;
  --blue-text:     #8FC0FF;
  --violet:        #8B5CF6;
  --violet-deep:   #6D4AE0;
  --violet-soft:   #A78BFA;
  --violet-text:   #C4B5FD;

  --cyan:          #22D3EE;
  --cyan-text:     #7EE3F5;

  --teal:          #2DD4A7;
  --teal-text:     #6FD9BC;

  --r-lg: 20px;
  --r-md: 12px;
  --r-sm: 10px;

  position: relative;
  padding: clamp(56px, 8vw, 112px) clamp(18px, 5vw, 64px);
  background:
    radial-gradient(120% 70% at 50% -12%, rgba(139, 92, 246, 0.085), transparent 58%),
    radial-gradient(120% 70% at 50% -12%, rgba(34, 211, 238, 0.05), transparent 66%),
    var(--bg);
}

.animation-web .itk-web__inner { max-width: 1180px; margin: 0 auto; }

.animation-web .itk-web .itk-eyebrow {
  display: inline-block;
  margin: 0 0 20px;
  padding: 6px 13px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--violet-text);
  background: rgba(139, 92, 246, 0.07);
  border: 1px solid rgba(139, 92, 246, 0.22);
  border-radius: 999px;
}

.animation-web .itk-web__head h2 {
  margin: 0 0 16px;
  max-width: 24ch;
  font-size: clamp(27px, 3.4vw, 43px);
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: -0.02em;
  color: var(--text);
}

.animation-web .itk-web__lede {
  margin: 0 0 38px;
  max-width: 66ch;
  font-size: clamp(14.5px, 1.15vw, 16.5px);
  line-height: 1.65;
  color: var(--muted);
}

.animation-web .itk-web .itk-panel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 318px;
  overflow: hidden;
  background: linear-gradient(180deg, var(--panel-top) 0%, var(--panel-bottom) 100%);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow:
    0 42px 90px -52px rgba(0, 0, 0, 0.95),
    0 0 0 1px rgba(255, 255, 255, 0.015) inset;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-web .itk-web .itk-panel.is-in { opacity: 1; transform: none; }

.animation-web .web-stage {
  position: relative;
  min-width: 0;
  padding: 20px 24px 22px;
  border-right: 1px solid var(--line);
}
.animation-web .web-stage::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 46%;
  width: 74%;
  height: 62%;
  transform: translate(-50%, -50%);
  background: radial-gradient(closest-side, rgba(139, 92, 246, 0.09), transparent 72%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 1.1s ease;
}

.animation-web .web-stage.is-lit::before { opacity: 1; }

.animation-web .web-stage__head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.animation-web .web-stage__title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-web .web-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 12px 5px 10px;
  font-size: 12px;
  font-weight: 600;
  color: var(--violet-text);
  background: rgba(139, 92, 246, 0.08);
  border: 1px solid rgba(139, 92, 246, 0.22);
  border-radius: 999px;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.5s ease, transform 0.5s ease,
              color 0.6s ease, border-color 0.6s ease, background 0.6s ease;
}

.animation-web .web-live.is-on { opacity: 1; transform: none; }

.animation-web .web-live.is-live {
  color: var(--teal-text);
  background: rgba(45, 212, 167, 0.08);
  border-color: rgba(45, 212, 167, 0.26);
}

.animation-web .web-live i {
  width: 6px; height: 6px;
  border-radius: 50%;
  flex: none;
  background: var(--violet-soft);
  animation: offering-web-web-live-pulse 3.4s ease-out infinite;
  transition: background 0.6s ease;
}

.animation-web .web-live.is-live i {
  background: var(--teal);
  animation: offering-web-web-teal-pulse 4s ease-out infinite;
}

@keyframes offering-web-web-live-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(167, 139, 250, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(167, 139, 250, 0); }
}

@keyframes offering-web-web-teal-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(45, 212, 167, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(45, 212, 167, 0); }
}

.animation-web .web-device-wrap {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: stretch;
  height: clamp(240px, 29vw, 320px);
  margin-top: 16px;
}

.animation-web .web-device {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: #070C18;
  box-shadow: 0 30px 60px -36px rgba(0, 0, 0, 0.95);
  opacity: 0;
  transform: translateY(8px) scale(0.985);
  transition:
    opacity 0.7s ease,
    transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
    width 0.95s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.7s ease,
    box-shadow 0.7s ease;
}

.animation-web .web-device.is-on { opacity: 1; transform: none; }
.animation-web .web-device.is-tablet { width: 62%; }
.animation-web .web-device.is-mobile { width: 31%; min-width: 132px; }
.animation-web .web-device.is-secured {
  border-color: rgba(34, 211, 238, 0.30);
  box-shadow:
    0 0 0 1px rgba(34, 211, 238, 0.06),
    0 30px 60px -36px rgba(0, 0, 0, 0.95),
    0 0 40px -20px rgba(34, 211, 238, 0.55);
}
.animation-web .web-device.is-live {
  border-color: rgba(45, 212, 167, 0.38);
  box-shadow:
    0 0 0 1px rgba(45, 212, 167, 0.07),
    0 30px 60px -36px rgba(0, 0, 0, 0.95),
    0 0 46px -18px rgba(45, 212, 167, 0.6);
}
.animation-web .web-chrome {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: none;
  padding: 7px 11px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
}

.animation-web .web-chrome__dots {
  display: inline-flex;
  gap: 4px;
  flex: none;
}

.animation-web .web-chrome__dots i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #2F3B52;
  transition: background 0.6s ease;
}

.animation-web .web-device.is-live .web-chrome__dots i:nth-child(1) { background: #3E4C68; }
.animation-web .web-device.is-live .web-chrome__dots i:nth-child(2) { background: #3E4C68; }
.animation-web .web-device.is-live .web-chrome__dots i:nth-child(3) { background: #3E4C68; }

.animation-web .web-chrome__url {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  flex: 1;
  min-width: 0;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.01em;
  color: var(--dim);
  background: rgba(255, 255, 255, 0.022);
  border: 1px solid var(--line);
  border-radius: 999px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color 0.6s ease, border-color 0.6s ease;
}

.animation-web .web-device.is-live .web-chrome__url {
  color: #7FA9A0;
  border-color: rgba(45, 212, 167, 0.20);
}

.animation-web .web-chrome__url.is-flash { animation: offering-web-web-url-flash 0.8s ease; }

@keyframes offering-web-web-url-flash {
  0%   { background: rgba(45, 212, 167, 0.16); }
  100% { background: rgba(255, 255, 255, 0.022); }
}

.animation-web .web-device.is-mobile .web-chrome__url { font-size: 12px; padding: 2px 7px; }
.animation-web .web-lock {
  position: relative;
  flex: none;
  width: 8px;
  height: 6.5px;
  border-radius: 1.5px;
  background: #2C3852;
  opacity: 0;
  transform: scale(0.7);
  transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.4, 0.64, 1),
              background 0.5s ease;
}

.animation-web .web-lock::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -4px;
  width: 5px;
  height: 5px;
  margin-left: -2.5px;
  border: 1.2px solid #2C3852;
  border-bottom: none;
  border-radius: 3px 3px 0 0;
  transition: border-color 0.5s ease;
}

.animation-web .web-lock.is-on {
  opacity: 1;
  transform: none;
  background: var(--teal);
}

.animation-web .web-lock.is-on::before { border-color: var(--teal); }

.animation-web .web-device.is-mobile .web-lock { display: none; }
.animation-web .web-chrome__state {
  flex: none;
  padding: 3px 9px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: #8A7FBF;
  background: rgba(139, 92, 246, 0.10);
  border: 1px solid rgba(139, 92, 246, 0.26);
  border-radius: 999px;
  white-space: nowrap;
  transition: color 0.6s ease, background 0.6s ease, border-color 0.6s ease;
}

.animation-web .web-device.is-live .web-chrome__state {
  color: var(--teal-text);
  background: rgba(45, 212, 167, 0.10);
  border-color: rgba(45, 212, 167, 0.30);
}

.animation-web .web-device.is-mobile .web-chrome__state { display: none; }

.animation-web .web-page {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10px;
  min-height: 0;
  padding: 12px 14px 14px;
  overflow: hidden;
  transition: padding 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
              gap 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.animation-web .web-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex: none;
}

.animation-web .web-nav__logo {
  width: 16px;
  height: 16px;
  border-radius: 5px;
  flex: none;
}

.animation-web .web-nav__links {
  display: inline-flex;
  gap: 6px;
  transition: opacity 0.5s ease;
}

.animation-web .web-nav__links i {
  display: block;
  width: 20px;
  height: 5px;
  border-radius: 3px;
}
.animation-web .web-hero {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 12px;
  flex: 1;
  min-height: 0;
  transition: grid-template-columns 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-web .web-hero__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 7px;
  min-width: 0;
}

.animation-web .web-line {
  display: block;
  border-radius: 4px;
}

.animation-web .web-line--xl { width: 82%; height: 13px; }
.animation-web .web-line--lg { width: 64%; height: 9px; }
.animation-web .web-line--md { width: 46%; height: 7px; }

.animation-web .web-btn {
  display: block;
  width: 54px;
  height: 15px;
  margin-top: 3px;
  border-radius: 999px;
}

.animation-web .web-hero__media {
  border-radius: 8px;
