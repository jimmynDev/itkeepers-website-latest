    .animation-cloud { width:100%; min-width:0; margin:0; color:var(--fg); font-family:var(--font-editorial,system-ui); }
    .animation-cloud .itk-m365 {
      --bg:var(--n,#0b2c5f); --panel: #0b2c5f; --panel-top:#0b2c5f; --panel-bottom:#071f44;
      --surface:#102f59; --surface-2:#123763; --surface-hi:#163b68;
      --text:#ffffff; --muted:#d6e4f5; --dim:#b8cde6;
      --blue:#5cc5ff; --blue-bright:#5cc5ff; --blue-soft:#5cc5ff; --blue-text:#8fcfff;
      --cyan:#42baeb; --cyan-text:#7ee3f5; --line:rgba(184,205,230,.22); --line-strong:rgba(184,205,230,.5);
      padding:0; background:none; overflow:visible; color:var(--text); font-family:inherit;
    }
    .animation-cloud .itk-panel { margin:0; background:linear-gradient(180deg,#0b2c5f,#071f44); }
    .animation-cloud .animation-caption { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-block:14px 0; font-size:14px; line-height:1.6; color:inherit; }
    .animation-cloud .animation-caption p { flex:1 1 30ch; margin:0; max-width:80ch; font-size:14px; }
    .animation-cloud [data-animation-toggle] { font:inherit; font-size:14px; min-height:44px; padding:9px 16px; border:1px solid currentColor; border-radius:999px; background:transparent; color:inherit; cursor:pointer; }
    .animation-cloud [data-animation-toggle]:focus-visible { outline:3px solid var(--focus,#5cc5ff); outline-offset:4px; }
    .animation-cloud [hidden] { display:none !important; }
    .animation-cloud.is-idle *, .animation-cloud.is-idle *::before, .animation-cloud.is-idle *::after { animation-play-state:paused !important; }
    .animation-cloud[data-animation-state="settled"] *, .animation-cloud[data-animation-state="settled"] *::before, .animation-cloud[data-animation-state="settled"] *::after { animation:none !important; transition:none !important; }
    .animation-cloud:not([data-animation-enhanced]) [data-animation-visual], .animation-cloud:not([data-animation-enhanced]) [data-animation-visual] * { opacity:1 !important; animation:none !important; transition:none !important; }
    .animation-cloud:not([data-animation-enhanced]) .itk-panel { transform:none; }
    @media (hover:hover) and (pointer:fine) { .animation-cloud [data-animation-toggle]:hover { background:rgba(92,197,255,.12); } }
    @media (max-width:560px) { .animation-cloud .animation-caption { align-items:flex-start; } .animation-cloud .animation-caption p { flex-basis:100%; } }
    @media (prefers-reduced-motion:reduce) { .animation-cloud *, .animation-cloud *::before, .animation-cloud *::after { animation:none !important; transition:none !important; } }
