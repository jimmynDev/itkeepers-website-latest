<!-- Adapted from cloud_services.html; illustrative, local-only prototype data. -->
<figure class="offering-animation animation-cloud" data-animation="cloud">
  <div class="itk-m365" data-animation-visual aria-hidden="true">
    <div class="itk-panel" aria-hidden="true">

      
      <div class="m365-stage">
        <div class="m365-stage__head">
          <span class="m365-stage__title">Identity &amp; cloud</span>
          <span class="m365-live" data-live><i></i> Identity example</span>
        </div>

        <div class="m365-map">
          <svg class="m365-map__svg" viewBox="0 0 100 100" preserveAspectRatio="none">
            <g>
              <path class="m365-link" data-link="user"
                    d="M 13 34 C 26 34, 31 50, 44 50"></path>
              <path class="m365-link" data-link="device"
                    d="M 13 66 C 26 66, 31 50, 44 50"></path>

              <path class="m365-link" data-link="m365"
                    d="M 44 50 C 62 50, 65 10, 83 10"></path>
              <path class="m365-link" data-link="exchange"
                    d="M 44 50 C 62 50, 65 30, 83 30"></path>
              <path class="m365-link" data-link="intune"
                    d="M 44 50 C 62 50, 65 50, 83 50"></path>
              <path class="m365-link" data-link="sharepoint"
                    d="M 44 50 C 62 50, 65 70, 83 70"></path>
              <path class="m365-link is-cloud" data-link="azure"
                    d="M 44 50 C 62 50, 65 90, 83 90"></path>
            </g>
          </svg>

          
          <div class="m365-identity" data-identity>
            <span class="m365-identity__glyph"></span>
            <span class="m365-identity__label">Entra ID</span>
            <span class="m365-identity__sub">Identity</span>
          </div>

          
          <div class="m365-node" data-node="user" data-style="cloud-inline-1">
            <span class="m365-node__dot"></span>
            <span class="m365-node__body">
              <span class="m365-node__label">User</span>
              <span class="m365-node__status" data-status>New hire</span>
            </span>
          </div>

          <div class="m365-node" data-node="device" data-style="cloud-inline-2">
            <span class="m365-node__dot"></span>
            <span class="m365-node__body">
              <span class="m365-node__label">Device</span>
              <span class="m365-node__status" data-status>New device</span>
            </span>
            <span class="m365-node__badge">Policy</span>
          </div>

          
          <div class="m365-node" data-node="m365" data-style="cloud-inline-3">
            <span class="m365-node__dot"></span>
            <span class="m365-node__body">
              <span class="m365-node__label">Microsoft 365</span>
              <span class="m365-node__status" data-status>Not connected</span>
            </span>
          </div>

          <div class="m365-node" data-node="exchange" data-style="cloud-inline-4">
            <span class="m365-node__dot"></span>
            <span class="m365-node__body">
              <span class="m365-node__label">Exchange Online</span>
              <span class="m365-node__status" data-status>Not connected</span>
            </span>
          </div>

          <div class="m365-node" data-node="intune" data-style="cloud-inline-5">
            <span class="m365-node__dot"></span>
            <span class="m365-node__body">
              <span class="m365-node__label">Intune</span>
              <span class="m365-node__status" data-status>Not connected</span>
            </span>
          </div>

          <div class="m365-node" data-node="sharepoint" data-style="cloud-inline-6">
            <span class="m365-node__dot"></span>
            <span class="m365-node__body">
              <span class="m365-node__label">SharePoint</span>
              <span class="m365-node__status" data-status>Not connected</span>
            </span>
          </div>

          <div class="m365-node" data-node="azure" data-style="cloud-inline-7">
            <span class="m365-node__dot"></span>
            <span class="m365-node__body">
              <span class="m365-node__label">Azure</span>
              <span class="m365-node__status" data-status>Not connected</span>
            </span>
          </div>
        </div>
      </div>

      
      <div class="m365-rail">
        <div class="m365-rail__head">
          <span class="m365-stage__title">Identity lifecycle</span>
        </div>

        <ol class="m365-rail__list">
          <li class="m365-item" data-rail="0">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">User joins company</span>
            <span class="m365-item__tag">People</span>
          </li>
          <li class="m365-item" data-rail="1">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">Identity created in Entra ID</span>
            <span class="m365-item__tag">Identity</span>
          </li>
          <li class="m365-item" data-rail="2">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">Microsoft 365 access assigned</span>
            <span class="m365-item__tag">Apps</span>
          </li>
          <li class="m365-item" data-rail="3">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">Email becomes available</span>
            <span class="m365-item__tag">Exchange</span>
          </li>
          <li class="m365-item" data-rail="4">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">Device enrols into Intune</span>
            <span class="m365-item__tag">Devices</span>
          </li>
          <li class="m365-item" data-rail="5">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">Security policies apply</span>
            <span class="m365-item__tag">Security</span>
          </li>
          <li class="m365-item" data-rail="6">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">SharePoint resources available</span>
            <span class="m365-item__tag">Files</span>
          </li>
          <li class="m365-item" data-rail="7" data-accent="cloud">
            <span class="m365-item__dot"></span>
            <span class="m365-item__text">Cloud services connect</span>
            <span class="m365-item__tag">Cloud</span>
          </li>
        </ol>

        <p class="m365-rail__note">
          The right people get the right access on the right devices.
        </p>
      </div>

      
      <div class="m365-mobile">
        <div class="m365-mobile__head">
          <span class="m365-stage__title">Identity &amp; cloud</span>
          <span class="m365-live" data-live><i></i> Managed</span>
        </div>

        <div class="m365-mpeople">
          <div class="m365-mchip" data-node="user">
            <span class="m365-mchip__top"><i></i>User</span>
            <span class="m365-mchip__status" data-status>New hire</span>
          </div>
          <div class="m365-mchip" data-node="device">
            <span class="m365-mchip__top"><i></i>Device</span>
            <span class="m365-mchip__status" data-status>New device</span>
          </div>
        </div>

        <div class="m365-mspine" data-spine></div>

        <div class="m365-midentity" data-identity>
          <span class="m365-identity__glyph"></span>
          <span class="m365-identity__label">Entra ID</span>
          <span class="m365-identity__sub">Identity</span>
        </div>

        <ul class="m365-mservices">
          <li data-node="m365">
            <i></i>
            <span class="m365-mservices__name">Microsoft 365</span>
            <span class="m365-mservices__status" data-status>Not connected</span>
          </li>
          <li data-node="exchange">
            <i></i>
            <span class="m365-mservices__name">Exchange Online</span>
            <span class="m365-mservices__status" data-status>Not connected</span>
          </li>
          <li data-node="intune">
            <i></i>
            <span class="m365-mservices__name">Intune</span>
            <span class="m365-mservices__status" data-status>Not connected</span>
          </li>
          <li data-node="sharepoint">
            <i></i>
            <span class="m365-mservices__name">SharePoint</span>
            <span class="m365-mservices__status" data-status>Not connected</span>
          </li>
          <li data-node="azure">
            <i></i>
            <span class="m365-mservices__name">Azure</span>
            <span class="m365-mservices__status" data-status>Not connected</span>
          </li>
        </ul>
      </div>

      
      <div class="m365-lifecycle">
        <span class="m365-lifecycle__title">When someone leaves</span>
        <ol class="m365-life">
          <li data-life="0"><i></i>Account disabled</li>
          <li data-life="1"><i></i>Access revoked</li>
          <li data-life="2"><i></i>Sessions terminated</li>
          <li data-life="3"><i></i>Device controlled</li>
          <li data-life="4"><i></i>Data access reviewed</li>
        </ol>
      </div>

    </div>
  </div>
</figure>

<style is:global>

.animation-cloud *, .animation-cloud *::before, .animation-cloud *::after { box-sizing: border-box; }

.animation-cloud .sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.animation-cloud .itk-m365 {
  --bg:            #070B14;
  --panel-top:     #0E1526;
  --panel-bottom:  #0A1020;
  --surface:       #0C1322;
  --surface-hi:    #121B2E;

  --line:          rgba(126, 156, 204, 0.14);
  --line-strong:   rgba(126, 156, 204, 0.26);

  --text:          #E8EEF9;
  --muted:         #8695B0;
  --dim:           #5D6B85;

  --blue:          #3B82F6;
  --blue-bright:   #60A5FA;
  --blue-text:     #8FC0FF;
  --cyan:          #22D3EE;
  --cyan-text:     #7EE3F5;
  --teal:          #2DD4A7;

  --r-lg: 20px;
  --r-md: 12px;
  --r-sm: 10px;

  position: relative;
  padding: clamp(56px, 8vw, 112px) clamp(18px, 5vw, 64px);
  background:
    radial-gradient(120% 70% at 50% -12%, rgba(34, 211, 238, 0.075), transparent 60%),
    radial-gradient(120% 70% at 50% -12%, rgba(59, 130, 246, 0.09), transparent 64%),
    var(--bg);
}

.animation-cloud .itk-m365__inner { max-width: 1180px; margin: 0 auto; }

.animation-cloud .itk-m365 .itk-eyebrow {
  display: inline-block;
  margin: 0 0 20px;
  padding: 6px 13px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cyan-text);
  background: rgba(34, 211, 238, 0.06);
  border: 1px solid rgba(34, 211, 238, 0.20);
  border-radius: 999px;
}

.animation-cloud .itk-m365__head h2 {
  margin: 0 0 16px;
  max-width: 24ch;
  font-size: clamp(27px, 3.4vw, 43px);
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: -0.02em;
  color: var(--text);
}

.animation-cloud .itk-m365__lede {
  margin: 0 0 38px;
  max-width: 66ch;
  font-size: clamp(14.5px, 1.15vw, 16.5px);
  line-height: 1.65;
  color: var(--muted);
}

.animation-cloud .itk-m365 .itk-panel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 328px;
  overflow: hidden;
  background: linear-gradient(180deg, var(--panel-top) 0%, var(--panel-bottom) 100%);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow:
    0 42px 90px -52px rgba(0, 0, 0, 0.95),
    0 0 0 1px rgba(255, 255, 255, 0.015) inset;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-cloud .itk-m365 .itk-panel.is-in { opacity: 1; transform: none; }

.animation-cloud .m365-stage {
  min-width: 0;
  padding: 20px 24px 26px;
  border-right: 1px solid var(--line);
}

.animation-cloud .m365-stage__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.animation-cloud .m365-stage__title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-cloud .m365-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 12px 5px 10px;
  font-size: 12px;
  font-weight: 600;
  color: var(--cyan-text);
  background: rgba(34, 211, 238, 0.07);
  border: 1px solid rgba(34, 211, 238, 0.20);
  border-radius: 999px;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.animation-cloud .m365-live.is-on { opacity: 1; transform: none; }

.animation-cloud .m365-live i {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #4FD8EC;
  animation: offering-cloud-m365-live-pulse 3.2s ease-out infinite;
}

@keyframes offering-cloud-m365-live-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(79, 216, 236, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(79, 216, 236, 0); }
}

.animation-cloud .m365-map {
  position: relative;
  width: 100%;
  margin-top: 12px;
  aspect-ratio: 3 / 2;
}

.animation-cloud .m365-map__svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.animation-cloud .m365-link {
  fill: none;
  stroke: rgba(126, 156, 204, 0.22);
  stroke-width: 0.24;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.85s cubic-bezier(0.4, 0, 0.2, 1),
              stroke 0.6s ease;
}

.animation-cloud .m365-link.is-on { stroke: rgba(59, 130, 246, 0.55); }
.animation-cloud .m365-link.is-cloud.is-on { stroke: rgba(34, 211, 238, 0.55); }

.animation-cloud .m365-identity {
  position: absolute;
  left: 44%;
  top: 50%;
  transform: translate(-50%, -50%) scale(0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 15px 20px 13px;
  border-radius: 18px;
  background:
    radial-gradient(circle at 50% 28%, rgba(59, 130, 246, 0.22), rgba(10, 16, 32, 0.95) 74%);
  border: 1px solid rgba(59, 130, 246, 0.32);
  box-shadow:
    0 0 46px -12px rgba(59, 130, 246, 0.58),
    0 0 28px -12px rgba(59, 130, 246, 0.5) inset;
  opacity: 0;
  z-index: 3;
  transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-cloud .m365-identity.is-on { opacity: 1; transform: translate(-50%, -50%) scale(1); }

.animation-cloud .m365-identity::after {
  content: "";
  position: absolute;
  inset: -11px;
  border-radius: 28px;
  border: 1px solid rgba(96, 165, 250, 0.26);
  pointer-events: none;
  animation: offering-cloud-m365-halo 5.4s ease-in-out infinite;
}

@keyframes offering-cloud-m365-halo {
  0%, 100% { opacity: 0.22; transform: scale(1); }
  50%      { opacity: 0.5;  transform: scale(1.035); }
}

.animation-cloud .m365-identity__glyph {
  position: relative;
  width: 26px;
  height: 26px;
  margin-bottom: 4px;
  border-radius: 9px;
  background: linear-gradient(160deg, rgba(59, 130, 246, 0.34), rgba(59, 130, 246, 0.07));
  border: 1px solid rgba(96, 165, 250, 0.45);
}

.animation-cloud .m365-identity__glyph::before {
  content: "";
  position: absolute;
  left: 50%; top: 6px;
  width: 7px; height: 7px;
  margin-left: -3.5px;
  border-radius: 50%;
  background: #9CC4FF;
}

.animation-cloud .m365-identity__glyph::after {
  content: "";
  position: absolute;
  left: 50%; bottom: 5px;
  width: 13px; height: 7px;
  margin-left: -6.5px;
  border-radius: 6px 6px 3px 3px;
  background: #9CC4FF;
  opacity: 0.85;
}

.animation-cloud .m365-identity__label {
  font-size: 12px;
  font-weight: 650;
  letter-spacing: -0.01em;
  color: #D3E1F6;
}

.animation-cloud .m365-identity__sub {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--blue-text);
  opacity: 0.75;
}

.animation-cloud .m365-node {
  position: absolute;
  left: var(--x, 50%);
  top: var(--y, 50%);
  transform: translate(-50%, -50%) scale(0.95);
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: linear-gradient(180deg, var(--surface-hi) 0%, var(--surface) 100%);
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  z-index: 2;
  transition:
    opacity 0.55s ease,
    transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.45s ease,
    box-shadow 0.45s ease;
}

.animation-cloud .m365-node.is-on {
  opacity: 0.72;
  transform: translate(-50%, -50%) scale(1);
}

.animation-cloud .m365-node.is-check,
.animation-cloud .m365-node.is-verified,
.animation-cloud .m365-node.is-cloud,
.animation-cloud .m365-node.is-policy { opacity: 1; }

.animation-cloud .m365-node__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }

.animation-cloud .m365-node__label {
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: #C3D2E8;
}

.animation-cloud .m365-node__status {
  font-size: 12px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.03em;
  color: var(--dim);
  transition: color 0.4s ease;
}

.animation-cloud .m365-node__dot {
  position: relative;
  flex: none;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #35415A;
  transition: background 0.4s ease, box-shadow 0.4s ease;
}
.animation-cloud .m365-node.is-check .m365-node__dot::after,
.animation-cloud .m365-node.is-verified .m365-node__dot::after,
.animation-cloud .m365-node.is-cloud .m365-node__dot::after,
.animation-cloud .m365-node.is-policy .m365-node__dot::after {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1px solid rgba(59, 130, 246, 0.5);
  animation: offering-cloud-m365-ping 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes offering-cloud-m365-ping {
  0%        { transform: scale(0.55); opacity: 0; }
  10%       { opacity: 0.6; }
  38%, 100% { transform: scale(2.3);  opacity: 0; }
}

.animation-cloud .m365-node.is-check {
  border-color: rgba(59, 130, 246, 0.42);
  box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.09),
              0 0 26px -8px rgba(59, 130, 246, 0.55);
}
.animation-cloud .m365-node.is-check .m365-node__dot {
  background: var(--blue);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.13);
}
.animation-cloud .m365-node.is-check .m365-node__status { color: #7FA6E8; }

.animation-cloud .m365-node.is-verified {
  border-color: rgba(45, 212, 167, 0.44);
  box-shadow: 0 0 0 1px rgba(45, 212, 167, 0.09),
              0 0 26px -8px rgba(45, 212, 167, 0.5);
}
.animation-cloud .m365-node.is-verified .m365-node__dot {
  background: var(--teal);
  box-shadow: 0 0 0 3px rgba(45, 212, 167, 0.13);
}
.animation-cloud .m365-node.is-verified .m365-node__status { color: #6FD9BC; }

.animation-cloud .m365-node.is-cloud {
  border-color: rgba(34, 211, 238, 0.44);
  box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.09),
              0 0 26px -8px rgba(34, 211, 238, 0.5);
}
.animation-cloud .m365-node.is-cloud .m365-node__dot {
  background: var(--cyan);
  box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.13);
}
.animation-cloud .m365-node.is-cloud .m365-node__dot::after { border-color: rgba(34, 211, 238, 0.5); }
.animation-cloud .m365-node.is-cloud .m365-node__status { color: #7EE3F5; }

.animation-cloud .m365-node.is-policy {
  border-color: rgba(45, 212, 167, 0.48);
  box-shadow: 0 0 0 1px rgba(45, 212, 167, 0.10),
              0 0 28px -8px rgba(45, 212, 167, 0.55);
}
.animation-cloud .m365-node.is-policy .m365-node__dot {
  background: var(--teal);
  box-shadow: 0 0 0 3px rgba(45, 212, 167, 0.14);
}
.animation-cloud .m365-node.is-policy .m365-node__dot::after { border-color: rgba(45, 212, 167, 0.5); }
.animation-cloud .m365-node.is-policy .m365-node__status { color: #6FD9BC; }
.animation-cloud .m365-node__badge {
  position: absolute;
  top: -8px;
  right: -8px;
  padding: 2px 6px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #7FE0C4;
  background: #0F2430;
  border: 1px solid rgba(45, 212, 167, 0.5);
  border-radius: 6px;
  opacity: 0;
  transform: scale(0.82);
  transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-cloud .m365-node.is-policy .m365-node__badge { opacity: 1; transform: scale(1); }

.animation-cloud .m365-rail {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 20px 22px 22px;
}

.animation-cloud .m365-rail__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 14px;
  margin-bottom: 4px;
  border-bottom: 1px solid var(--line);
}

.animation-cloud .m365-rail__list {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 8px 0 0;
  padding: 0;
  list-style: none;
}

.animation-cloud .m365-item {
  display: grid;
  grid-template-columns: 14px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  opacity: 0.26;
  transform: translateX(-4px);
