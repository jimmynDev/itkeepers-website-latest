<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('.animation-cloud').forEach(root => {
    mountAnimation(root, ({ later }) => {
      const section = root.querySelector('.itk-m365');

  var panel = section.querySelector(".itk-panel");

  var STATES = ["is-check", "is-verified", "is-cloud", "is-policy"];

  /* ---------- link setup ---------- */

  var links = {};
  section.querySelectorAll("[data-link]").forEach(function (path) {
    var len = 0;
    try { len = path.getTotalLength(); } catch (e) { len = 60; }
    path.style.strokeDasharray = len;
    path.style.strokeDashoffset = len;
    links[path.dataset.link] = path;
  });

  function drawLink(key) {
    var p = links[key];
    if (!p) return;
    p.classList.add("is-on");
    p.style.strokeDashoffset = 0;
  }

  /* ---------- helpers ---------- */

  function at(ms, fn) { later(fn, ms); }

  function show(key) {
    section.querySelectorAll('[data-node="' + key + '"]').forEach(function (el) {
      el.classList.add("is-on");
    });
  }

  function setNode(key, state, statusText) {
    section.querySelectorAll('[data-node="' + key + '"]').forEach(function (el) {
      el.classList.add("is-on");
      STATES.forEach(function (s) { el.classList.remove(s); });
      if (state) el.classList.add(state);
      if (statusText) {
        var s = el.querySelector("[data-status]");
        if (s) s.textContent = statusText;
      }
    });
  }

  function rail(n) {
    var el = section.querySelector('[data-rail="' + n + '"]');
    if (el) el.classList.add("is-on");
  }

  function life(n) {
    var el = section.querySelector('[data-life="' + n + '"]');
    if (el) el.classList.add(n === 4 ? "is-ok" : "is-on");
  }

  function showIdentity() {
    section.querySelectorAll("[data-identity]").forEach(function (el) {
      el.classList.add("is-on");
    });
    section.querySelectorAll("[data-spine]").forEach(function (el) {
      el.classList.add("is-on");
    });
  }

  function showLive() {
    section.querySelectorAll("[data-live]").forEach(function (el) {
      el.classList.add("is-on");
    });
  }

  /* ---------- timeline ---------- */

  function play() {
    panel.classList.add("is-in");

    /* -- before: services visible but not connected -- */
    at(220, function () {
      showLive();
      ["m365", "exchange", "intune", "sharepoint", "azure"].forEach(show);
    });

    /* -- people and devices appear separately -- */
    at(500, function () { show("user"); rail(0); });
    at(760, function () { show("device"); });

    /* -- identity becomes the connection point -- */
    at(1120, function () {
      showIdentity();
      drawLink("user");
      drawLink("device");
      setNode("user", "is-check", "Active");
      rail(1);
    });

    /* -- services attach, in order -- */
    at(1620, function () {
      setNode("m365", "is-verified", "Access assigned");
      drawLink("m365");
      rail(2);
    });

    at(2140, function () {
      setNode("exchange", "is-verified", "Mailbox ready");
      drawLink("exchange");
      rail(3);
    });

    at(2660, function () {
      setNode("device", "is-check", "Enrolled");
      setNode("intune", "is-verified", "Device managed");
      drawLink("intune");
      rail(4);
    });

    at(3180, function () {
      setNode("device", "is-policy", "Policy applied");
      rail(5);
    });

    at(3720, function () {
      setNode("sharepoint", "is-verified", "Sites available");
      drawLink("sharepoint");
      rail(6);
    });

    at(4260, function () {
      setNode("azure", "is-cloud", "Connected");
      drawLink("azure");
      rail(7);
    });

    /* -- offboarding -- */
    at(5900, function () { life(0); });
    at(6340, function () { life(1); });
    at(6780, function () { life(2); });
    at(7220, function () { life(3); });
    at(7660, function () { life(4); });
  }

  /* ---------- reduced-motion final state ---------- */

  function settle() {
    panel.classList.add("is-in");
    showLive();
    showIdentity();

    ["user", "device", "m365", "exchange", "intune", "sharepoint", "azure"]
      .forEach(show);

    Object.keys(links).forEach(function (k) {
      links[k].classList.add("is-on");
      links[k].style.strokeDashoffset = 0;
    });

    setNode("user", "is-check", "Active");
    setNode("device", "is-policy", "Policy applied");
    setNode("m365", "is-verified", "Access assigned");
    setNode("exchange", "is-verified", "Mailbox ready");
    setNode("intune", "is-verified", "Device managed");
    setNode("sharepoint", "is-verified", "Sites available");
    setNode("azure", "is-cloud", "Connected");

    for (var i = 0; i < 8; i++) rail(i);
    for (var j = 0; j < 5; j++) life(j);
  }
      return { play, settle, duration: 8700 };
    });
  });
</script>
