---
// Four-stage incident-response summary.
const stages = ['Issue detected', 'Engineer assigned', 'Resolved', 'Documented'];
---
<figure class="operate-process is-idle" data-animation="operational-workflow" aria-label="Example incident workflow from detection to documentation">
  <div class="incident-panel" data-animation-visual data-phase="settled">
    <div class="incident-chrome"><span class="incident-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="incident-url">ITKeepers / support</span><span class="incident-status" aria-hidden="true"><i></i><b data-incident-status>Documented</b></span></div>
    <div class="incident-heading"><h3>Incident response</h3></div>
    <div class="incident-rail">
      <div class="incident-axis" aria-hidden="true"><span class="incident-fill"></span></div>
      <ol class="incident-steps" aria-label="Example incident workflow">
        {stages.map((name,index) => <li class="incident-step is-complete" data-process-step={index}><span class="incident-node" aria-hidden="true"></span><div><strong>{name}</strong>{name === 'Documented' && <span class="incident-detail">Actions, outcome and follow-up recorded.</span>}</div></li>)}
      </ol>
      <span class="incident-ticket" aria-hidden="true"><i></i></span>
    </div>
  </div>
</figure>
<style>
  .operate-process { margin:0; min-width:0; }
  .incident-panel { --incident-cyan:#42BAEB; position:relative; padding:22px 24px 22px; border:1px solid var(--itk-animation-border); border-radius:18px; background:var(--itk-animation-panel); box-shadow:0 18px 44px -30px rgba(11,44,95,.5),inset 0 1px 0 rgba(255,255,255,.04); color:#f6fbff; }
  .incident-chrome { display:flex; align-items:center; flex-wrap:wrap; gap:8px; font-size:14px; line-height:1.5; color:#b9cedf; }
  .incident-dots { display:flex; gap:5px; }
  .incident-dots i { width:5px; height:5px; border-radius:50%; background:var(--incident-cyan); }
  .incident-url { flex:1; overflow-wrap:anywhere; }
  .incident-status { display:inline-flex; align-items:center; gap:6px; padding:3px 9px; border:1px solid #3e829b; border-radius:8px; color:#d6f4ff; background:rgba(66,186,235,.08); font-size:14px; }
  .incident-status i { flex:none; width:5px; height:5px; border-radius:50%; background:var(--incident-cyan); }
  .incident-heading { margin-block:20px 16px; }
  .incident-heading h3 { margin:0; font-size:20px; line-height:1.3; letter-spacing:-.02em; color:#f6fbff; }
  .incident-rail { position:relative; }
  .incident-steps { list-style:none; margin:0; padding:0; display:grid; gap:18px; }
  .incident-step { display:grid; grid-template-columns:20px minmax(0,1fr); gap:16px; position:relative; }
  .incident-node { z-index:1; align-self:start; justify-self:center; margin-top:6px; width:10px; height:10px; border-radius:50%; border:1px solid #759bb2; background:#15334b; }
  .incident-step strong { display:block; color:#f6fbff; font-size:16px; font-weight:600; line-height:1.35; }
  .incident-detail { display:block; margin-top:4px; color:#B8C4D6; font-size:14px; line-height:1.5; }
  .incident-step.is-complete .incident-node { background:var(--incident-cyan); border-color:var(--incident-cyan); }
  .incident-step:last-child.is-complete .incident-node { outline:1px solid var(--incident-cyan); outline-offset:3px; }
  .incident-step.is-active .incident-node { background:var(--incident-cyan); border-color:var(--incident-cyan); box-shadow:0 0 0 4px rgba(66,186,235,.16); }
  .incident-axis { position:absolute; left:9px; top:11px; bottom:11px; width:2px; background:#355b73; }
  .incident-fill { display:block; height:100%; width:100%; background:var(--incident-cyan); transform-origin:top; }
  .incident-ticket { display:none; position:absolute; left:10px; top:11px; width:0; height:0; }
  .incident-ticket i { display:block; position:absolute; width:10px; height:10px; top:-5px; left:-5px; border-radius:2px; background:#a4e7ff; transform:rotate(45deg); box-shadow:0 0 9px rgba(66,186,235,.45); }
  .incident-ticket.is-handoff::after { content:''; position:absolute; left:-12px; top:-12px; width:24px; height:24px; border:1px solid var(--incident-cyan); border-radius:50%; }
  .operate-process[data-animation-enhanced="true"] .incident-panel[data-phase="waiting"] { transform:translateY(10px); }
  .operate-process[data-animation-state="running"] .incident-ticket { display:block; }
  .operate-process .incident-panel[data-phase="waiting"] .incident-ticket { display:none; }
  @media(prefers-reduced-motion:no-preference) { .incident-panel { transition:transform 500ms cubic-bezier(.22,1,.36,1); } .incident-ticket,.incident-fill { transition:transform 390ms cubic-bezier(.16,1,.3,1); } .incident-node { transition:background-color 240ms ease,box-shadow 240ms ease; } }
  .operate-process:is([data-animation-state="paused"],[data-animation-state="replay-ready"],[data-animation-state="settled"]) .incident-panel * { transition:none; }
  .operate-process:is([data-animation-state="paused"],[data-animation-state="replay-ready"],[data-animation-state="settled"]) .incident-panel { transition:none; }
  .operate-process:is([data-animation-state="paused"],[data-animation-state="replay-ready"]) .incident-ticket { display:block; }
  .operate-process[data-animation-state="replay-ready"] .incident-panel[data-phase="settled"] .incident-ticket { display:none; }
  @media(max-width:480px) { .incident-panel { padding:18px 16px; } .incident-step { gap:10px; } }
  @media(forced-colors:active) { .incident-panel { --incident-cyan:Highlight; background:Canvas; color:CanvasText; border-color:CanvasText; } .incident-panel :is(h3,strong,.incident-detail,.incident-chrome,.incident-status) { color:CanvasText; } .incident-status,.incident-node { border-color:CanvasText; } }
  @media (prefers-reduced-motion:no-preference) {
    [data-animation-enhanced] [data-phase="settled"] .incident-node { animation:incident-node-breathe 4s ease-in-out infinite; }
    [data-animation-enhanced].is-idle .incident-node { animation-play-state:paused; }
  }
  @keyframes incident-node-breathe { 0%,100% { opacity:1; } 50% { opacity:.65; } }
</style>
