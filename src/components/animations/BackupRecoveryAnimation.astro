</style>

<script>
  import { mountAnimation } from '../../scripts/animation-lifecycle';
  document.querySelectorAll<HTMLElement>('.animation-backup').forEach(root => {
    mountAnimation(root, ({ later }) => {
      const section = root.querySelector('.itk-bdr');

  var panel     = section.querySelector(".itk-panel");
  var trackLine = section.querySelector("[data-track-line]");
  var sweep     = section.querySelector("[data-sweep]");

  /* ---------- helpers ---------- */

  function at(ms, fn) { later(fn, ms); }

  function all(sel) { return section.querySelectorAll(sel); }

  function eachPoint(n, fn) {
    all('[data-point="' + n + '"]').forEach(fn);
  }

  function eachSystem(key, fn) {
    all('[data-system="' + key + '"]').forEach(fn);
  }

  function showSystems() {
    all("[data-system]").forEach(function (el) {
      el.classList.add("is-on", "is-active", "is-flowing");
    });
  }

  function setSystemState(key, text) {
    eachSystem(key, function (el) {
      var s = el.querySelector("[data-state]");
      if (s) s.textContent = text;
    });
  }

  function setSystemClass(key, cls, remove) {
    eachSystem(key, function (el) {
      el.classList.add(...cls.split(/\s+/));
      if (remove) remove.forEach(function (c) { el.classList.remove(c); });
    });
  }

  function setPoint(n, cls, stateText) {
    eachPoint(n, function (el) {
      el.classList.add("is-on");
      if (cls) el.classList.add(...cls.split(/\s+/));
      if (stateText) {
        var s = el.querySelector("[data-state]");
        if (s) s.textContent = stateText;
      }
    });
  }

  function pointRemove(n, cls) {
    eachPoint(n, function (el) { el.classList.remove(cls); });
  }

  function setEvent(text, state) {
    all("[data-event]").forEach(function (el) {
      el.classList.add("is-on");
      el.classList.remove("is-warn", "is-ok");
      if (state) el.classList.add(state);
      var t = el.querySelector("[data-event-text]");
      if (t) t.textContent = text;
    });
  }

  function progressOn() {
    all("[data-event]").forEach(function (el) {
      el.classList.add("is-progress");
    });
  }

  function rail(n) {
    var el = section.querySelector('[data-rail="' + n + '"]');
    if (el) el.classList.add("is-on");
  }

  function chip(n) {
    var el = all("[data-chip]")[n];
    if (el) el.classList.add("is-on");
  }

  function liveVerified() {
    all("[data-live]").forEach(function (el) {
      el.classList.add("is-verified");
    });
  }

  /* ---------- timeline ---------- */

  function play() {
    panel.classList.add("is-in");

    /* interface wakes up */
    at(200, function () {
      all("[data-live]").forEach(function (el) { el.classList.add("is-on"); });
    });

    /* business systems start producing data */
    at(400, function () {
      showSystems();
    });

    /* backup starts */
    at(800, function () {
      if (trackLine) trackLine.classList.add("is-on");
      setEvent("Backup started", null);
      rail(0);
    });

    /* data protected */
    at(1200, function () {
      setSystemState("files", "Copy created");
      setSystemState("database", "Copy created");
      setSystemState("app", "Copy created");
      setEvent("Copy created", null);
      rail(1);
    });

    /* backup completes, recovery points accumulate */
    at(1650, function () {
      setEvent("Backup complete", null);
      setPoint(1, "is-complete", "Complete");
      rail(2);
    });

    at(1950, function () { setPoint(2, "is-complete", "Complete"); });
    at(2250, function () { setPoint(3, "is-complete", "Complete"); });
    at(2550, function () { setPoint(4, "is-complete", "Complete · latest"); });

    /* verification — the moment that matters */
    at(3000, function () {
      setEvent("Verifying recovery point", null);
      rail(3);
      if (sweep) sweep.classList.add("is-on");
    });

    /* verified point becomes recoverable; the rest stay unverified */
    at(3700, function () {
      setPoint(4, "is-verified", "Verified ✓");
      [1, 2, 3].forEach(function (n) {
        eachPoint(n, function (el) {
          el.classList.add("is-unverified");
          var s = el.querySelector("[data-state]");
          if (s) s.textContent = "Unverified";
        });
      });
      setEvent("Recovery point verified", "is-ok");
      rail(4);
    });

    /* controlled incident — restrained, not dramatic */
    at(4350, function () {
      eachSystem("database", function (el) {
        el.classList.remove("is-active", "is-flowing");
        el.classList.add("is-fault");
      });
      setSystemState("database", "Unavailable");
      setEvent("Database unavailable", "is-warn");
      rail(5);
    });

    /* select the verified recovery point */
    at(5000, function () {
      eachPoint(4, function (el) { el.classList.add("is-selected"); });
      setEvent("Selecting verified recovery point", "is-ok");
    });

    /* recovery initiated */
    at(5550, function () {
      setSystemState("database", "Restoring");
      setEvent("Recovery initiated", "is-ok");
      progressOn();
      rail(6);
    });

    /* data restored */
    at(6500, function () {
      eachSystem("database", function (el) {
        el.classList.remove("is-fault");
        el.classList.add("is-active", "is-flowing", "is-recovered");
      });
      setSystemState("database", "Restored");
      setEvent("Data restored", "is-ok");
      rail(7);
    });

    /* business operation resumes */
    at(7150, function () {
      eachSystem("database", function (el) {
        el.classList.remove("is-active");
        el.classList.add("is-recovered");
      });
      setSystemState("database", "Operation resumed");
      eachPoint(4, function (el) { el.classList.add("is-selected"); });

      setEvent("Business operation resumed", "is-ok");
      liveVerified();
      rail(8);
    });

    /* final verified state */
    at(7500, function () { chip(0); });
    at(7750, function () { chip(1); });
    at(8000, function () { chip(2); });
  }

  /* ---------- reduced-motion / fallback final state ---------- */

  function settle() {
    panel.classList.add("is-in");

    if (trackLine) trackLine.classList.add("is-on");

    all("[data-live]").forEach(function (el) {
      el.classList.add("is-on", "is-verified");
    });

    all("[data-chip]").forEach(function (el) { el.classList.add("is-on"); });

    all("[data-system]").forEach(function (el) {
      el.classList.add("is-on", "is-active", "is-flowing");
    });

    setSystemState("files", "Copy created");
    setSystemState("database", "Operation resumed");
    setSystemState("app", "Copy created");

    eachSystem("database", function (el) {
      el.classList.remove("is-active", "is-flowing");
      el.classList.add("is-recovered");
    });

    setPoint(4, "is-verified", "Verified ✓");
    eachPoint(4, function (el) { el.classList.add("is-selected"); });

    [1, 2, 3].forEach(function (n) {
      eachPoint(n, function (el) {
        el.classList.add("is-on", "is-complete", "is-unverified");
        var s = el.querySelector("[data-state]");
        if (s) s.textContent = "Unverified";
      });
    });

    setEvent("Business operation resumed", "is-ok");
    progressOn();

