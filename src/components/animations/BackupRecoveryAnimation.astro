<!-- Adapted from Backupp.html; illustrative, local-only prototype data. -->
<figure class="offering-animation animation-backup" data-animation="backup" role="img" aria-label="Illustrative backup workflow: a backup copy is checked, a failed job receives attention and a restore is verified.">
  <div class="itk-bdr" data-animation-visual aria-hidden="true">
    <div class="itk-panel" aria-hidden="true">

      
      <div class="bdr-stage">
        <div class="bdr-stage__head">
          <span class="bdr-stage__title">Backup &amp; recovery</span>
          <span class="bdr-live" data-live><i></i> Backup active</span>
        </div>

        
        <div class="bdr-systems">
          <div class="bdr-system" data-system="files" data-style="backup-inline-1">
            <span class="bdr-system__dot"></span>
            <span class="bdr-system__body">
              <span class="bdr-system__name">File server</span>
              <span class="bdr-system__state" data-state>Producing data</span>
            </span>
            <span class="bdr-system__stem"></span>
          </div>

          <div class="bdr-system" data-system="database" data-style="backup-inline-2">
            <span class="bdr-system__dot"></span>
            <span class="bdr-system__body">
              <span class="bdr-system__name">Database</span>
              <span class="bdr-system__state" data-state>Producing data</span>
            </span>
            <span class="bdr-system__stem"></span>
          </div>

          <div class="bdr-system" data-system="app" data-style="backup-inline-3">
            <span class="bdr-system__dot"></span>
            <span class="bdr-system__body">
              <span class="bdr-system__name">Business application</span>
              <span class="bdr-system__state" data-state>Producing data</span>
            </span>
            <span class="bdr-system__stem"></span>
          </div>
        </div>

        
        <div class="bdr-track">
          <span class="bdr-track__label">Recovery points</span>

          <div class="bdr-track__rail">
            <span class="bdr-track__line" data-track-line></span>
            <span class="bdr-track__sweep" data-sweep></span>

            <div class="bdr-points">

              <div class="bdr-point" data-point="1">
                <span class="bdr-point__beam"></span>
                <span class="bdr-point__dot"></span>
                <span class="bdr-point__index">01</span>
                <span class="bdr-point__state" data-state>Pending</span>
              </div>

              <div class="bdr-point" data-point="2">
                <span class="bdr-point__beam"></span>
                <span class="bdr-point__dot"></span>
                <span class="bdr-point__index">02</span>
                <span class="bdr-point__state" data-state>Pending</span>
              </div>

              <div class="bdr-point" data-point="3">
                <span class="bdr-point__beam"></span>
                <span class="bdr-point__dot"></span>
                <span class="bdr-point__index">03</span>
                <span class="bdr-point__state" data-state>Pending</span>
              </div>

              <div class="bdr-point" data-point="4">
                <span class="bdr-point__beam"></span>
                <span class="bdr-point__dot"></span>
                <span class="bdr-point__index">04</span>
                <span class="bdr-point__state" data-state>Pending</span>
              </div>

            </div>
          </div>
        </div>

        
        <div class="bdr-event" data-event>
          <span class="bdr-event__dot"></span>
          <span class="bdr-event__text" data-event-text>Standing by</span>
          <span class="bdr-event__progress" data-event-progress></span>
        </div>
      </div>

      
      <div class="bdr-rail">
        <div class="bdr-rail__head">
          <span class="bdr-stage__title">Lifecycle</span>
        </div>

        <ol class="bdr-rail__list">
          <li class="bdr-item" data-rail="0">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Backup starts</span>
            <span class="bdr-item__tag">Backup</span>
          </li>
          <li class="bdr-item" data-rail="1">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Copy created</span>
            <span class="bdr-item__tag">Backup</span>
          </li>
          <li class="bdr-item" data-rail="2">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Backup completes</span>
            <span class="bdr-item__tag">Backup</span>
          </li>
          <li class="bdr-item" data-rail="3" data-accent="teal">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Verification</span>
            <span class="bdr-item__tag">Restore check</span>
          </li>
          <li class="bdr-item" data-rail="4" data-accent="teal">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Recovery point available</span>
            <span class="bdr-item__tag">Verified</span>
          </li>
          <li class="bdr-item" data-rail="5" data-accent="amber">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">System unavailable</span>
            <span class="bdr-item__tag">Incident</span>
          </li>
          <li class="bdr-item" data-rail="6" data-accent="teal">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Recovery initiated</span>
            <span class="bdr-item__tag">Restore</span>
          </li>
          <li class="bdr-item" data-rail="7" data-accent="teal">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Data restored</span>
            <span class="bdr-item__tag">Restore</span>
          </li>
          <li class="bdr-item" data-rail="8" data-accent="teal">
            <span class="bdr-item__dot"></span>
            <span class="bdr-item__text">Business operation resumes</span>
            <span class="bdr-item__tag">Recovered</span>
          </li>
        </ol>

        <p class="bdr-rail__note">
          Having a backup is not the same as having a recoverable backup.
        </p>
      </div>

      
      <div class="bdr-mobile">
        <div class="bdr-mobile__head">
          <span class="bdr-stage__title">Backup &amp; recovery</span>
          <span class="bdr-live" data-live><i></i> Active</span>
        </div>

        <ul class="bdr-msys">
          <li data-system="files">
            <span class="bdr-system__dot"></span>
            <span class="bdr-msys__name">File server</span>
            <span class="bdr-msys__state" data-state>Producing data</span>
          </li>
          <li data-system="database">
            <span class="bdr-system__dot"></span>
            <span class="bdr-msys__name">Database</span>
            <span class="bdr-msys__state" data-state>Producing data</span>
          </li>
          <li data-system="app">
            <span class="bdr-system__dot"></span>
            <span class="bdr-msys__name">Business application</span>
            <span class="bdr-msys__state" data-state>Producing data</span>
          </li>
        </ul>

        <span class="bdr-mtitle">Recovery points</span>

        <ol class="bdr-mpoints">
          <li class="bdr-mpoint" data-point="1">
            <span class="bdr-mpoint__dot"></span>
            <span class="bdr-mpoint__index">Recovery point 01</span>
            <span class="bdr-mpoint__state" data-state>Pending</span>
          </li>
          <li class="bdr-mpoint" data-point="2">
            <span class="bdr-mpoint__dot"></span>
            <span class="bdr-mpoint__index">Recovery point 02</span>
            <span class="bdr-mpoint__state" data-state>Pending</span>
          </li>
          <li class="bdr-mpoint" data-point="3">
            <span class="bdr-mpoint__dot"></span>
            <span class="bdr-mpoint__index">Recovery point 03</span>
            <span class="bdr-mpoint__state" data-state>Pending</span>
          </li>
          <li class="bdr-mpoint" data-point="4">
            <span class="bdr-mpoint__dot"></span>
            <span class="bdr-mpoint__index">Recovery point 04</span>
            <span class="bdr-mpoint__state" data-state>Pending</span>
          </li>
        </ol>

        <div class="bdr-event" data-event>
          <span class="bdr-event__dot"></span>
          <span class="bdr-event__text" data-event-text>Standing by</span>
          <span class="bdr-event__progress" data-event-progress></span>
        </div>
      </div>

      
      <div class="bdr-foot">
        <span class="bdr-chip" data-chip>
          <i class="bdr-chip__check"></i>Restore checked
        </span>
        <span class="bdr-chip" data-chip>
          <i class="bdr-chip__check"></i>Recovery point available
        </span>
        <span class="bdr-chip" data-chip>
          <i class="bdr-chip__check"></i>Example complete
        </span>
      </div>

    </div>
  </div>
</figure>

<style is:global>

.animation-backup *, .animation-backup *::before, .animation-backup *::after { box-sizing: border-box; }

.animation-backup .sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.animation-backup .itk-bdr {
  --bg:            #070B14;
  --panel-top:     #0E1526;
  --panel-bottom:  #0A1020;
  --surface:       #0C1322;
  --surface-hi:    #121B2E;

  --line:          rgba(126, 156, 204, 0.14);
  --line-strong:   rgba(126, 156, 204, 0.26);

  --text:          #E8EEF9;
  --muted:         #8695B0;
  --dim:           #5D6B85;
  --blue:          #3B82F6;
  --blue-soft:     #60A5FA;
  --blue-text:     #8FC0FF;
  --teal:          #2DD4A7;
  --teal-text:     #6FD9BC;
  --amber:         #F0A93B;

  --r-lg: 20px;
  --r-md: 12px;
  --r-sm: 10px;

  position: relative;
  padding: clamp(56px, 8vw, 112px) clamp(18px, 5vw, 64px);
  background:
    radial-gradient(120% 70% at 50% -12%, rgba(45, 212, 167, 0.06), transparent 58%),
    radial-gradient(120% 70% at 50% -12%, rgba(59, 130, 246, 0.08), transparent 64%),
    var(--bg);
}

.animation-backup .itk-bdr__inner { max-width: 1180px; margin: 0 auto; }

.animation-backup .itk-bdr .itk-eyebrow {
  display: inline-block;
  margin: 0 0 20px;
  padding: 6px 13px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--teal-text);
  background: rgba(45, 212, 167, 0.06);
  border: 1px solid rgba(45, 212, 167, 0.20);
  border-radius: 999px;
}

.animation-backup .itk-bdr__head h2 {
  margin: 0 0 16px;
  max-width: 22ch;
  font-size: clamp(27px, 3.4vw, 43px);
  font-weight: 650;
  line-height: 1.14;
  letter-spacing: -0.02em;
  color: var(--text);
}

.animation-backup .itk-bdr__lede {
  margin: 0 0 38px;
  max-width: 66ch;
  font-size: clamp(14.5px, 1.15vw, 16.5px);
  line-height: 1.65;
  color: var(--muted);
}

.animation-backup .itk-bdr .itk-panel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 322px;
  overflow: hidden;
  background: linear-gradient(180deg, var(--panel-top) 0%, var(--panel-bottom) 100%);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow:
    0 42px 90px -52px rgba(0, 0, 0, 0.95),
    0 0 0 1px rgba(255, 255, 255, 0.015) inset;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-backup .itk-bdr .itk-panel.is-in { opacity: 1; transform: none; }

.animation-backup .bdr-stage {
  min-width: 0;
  padding: 20px 24px 24px;
  border-right: 1px solid var(--line);
}

.animation-backup .bdr-stage__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.animation-backup .bdr-stage__title {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-backup .bdr-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 12px 5px 10px;
  font-size: 12px;
  font-weight: 600;
  color: var(--blue-text);
  background: rgba(59, 130, 246, 0.09);
  border: 1px solid rgba(59, 130, 246, 0.22);
  border-radius: 999px;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.5s ease, transform 0.5s ease,
              color 0.5s ease, border-color 0.5s ease, background 0.5s ease;
}

.animation-backup .bdr-live.is-on { opacity: 1; transform: none; }

.animation-backup .bdr-live.is-verified {
  color: var(--teal-text);
  background: rgba(45, 212, 167, 0.08);
  border-color: rgba(45, 212, 167, 0.26);
}

.animation-backup .bdr-live i {
  width: 6px; height: 6px;
  border-radius: 50%;
  flex: none;
  background: #4C9BFF;
  animation: offering-backup-bdr-live-pulse 3.4s ease-out infinite;
  transition: background 0.5s ease;
}

.animation-backup .bdr-live.is-verified i {
  background: var(--teal);
  animation: offering-backup-bdr-teal-pulse 4s ease-out infinite;
}

@keyframes offering-backup-bdr-live-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(76, 155, 255, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(76, 155, 255, 0); }
}

@keyframes offering-backup-bdr-teal-pulse {
  0%        { box-shadow: 0 0 0 0 rgba(45, 212, 167, 0.5); }
  70%, 100% { box-shadow: 0 0 0 7px rgba(45, 212, 167, 0); }
}

.animation-backup .bdr-systems {
  position: relative;
  z-index: 3;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0 40px;
}

.animation-backup .bdr-system {
  position: relative;
  display: flex;
  align-items: center;
  gap: 9px;
  flex: 1 1 0;
  min-width: 0;
  padding: 9px 13px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: linear-gradient(180deg, var(--surface-hi) 0%, var(--surface) 100%);
  opacity: 0;
  transform: translateY(7px);
  transition:
    opacity 0.55s ease,
    transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
    border-color 0.5s ease,
    box-shadow 0.5s ease;
}

.animation-backup .bdr-system.is-on { opacity: 1; transform: none; }

.animation-backup .bdr-system__body {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.animation-backup .bdr-system__name {
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: #C3D2E8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.animation-backup .bdr-system__state {
  font-size: 12px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.03em;
  color: var(--dim);
  white-space: nowrap;
  transition: color 0.5s ease;
}

.animation-backup .bdr-system__dot {
  position: relative;
  flex: none;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #35415A;
  transition: background 0.5s ease, box-shadow 0.5s ease;
}
.animation-backup .bdr-system.is-active {
  border-color: rgba(59, 130, 246, 0.30);
  box-shadow: 0 0 26px -12px rgba(59, 130, 246, 0.6);
}

.animation-backup .bdr-system.is-active .bdr-system__dot {
  background: var(--blue-soft);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

.animation-backup .bdr-system.is-active .bdr-system__state { color: var(--blue-text); }
.animation-backup .bdr-system__stem {
  position: absolute;
  left: 50%;
  top: 100%;
  width: 1px;
  height: 26px;
  margin-left: -0.5px;
  background: linear-gradient(180deg, rgba(59, 130, 246, 0.55), rgba(59, 130, 246, 0));
  transform: scaleY(0);
  transform-origin: top center;
  transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  pointer-events: none;
}

.animation-backup .bdr-system.is-flowing .bdr-system__stem {
  transform: scaleY(1);
  animation: offering-backup-bdr-stem 2.6s ease-in-out infinite;
  animation-delay: calc(var(--i, 0) * 0.34s);
}

@keyframes offering-backup-bdr-stem {
  0%, 100% { opacity: 0.45; }
  50%      { opacity: 1; }
}
.animation-backup .bdr-system.is-fault {
  border-color: rgba(240, 169, 59, 0.5);
  box-shadow: 0 0 28px -12px rgba(240, 169, 59, 0.6);
}

.animation-backup .bdr-system.is-fault .bdr-system__dot {
  background: var(--amber);
  box-shadow: 0 0 0 3px rgba(240, 169, 59, 0.13);
}

.animation-backup .bdr-system.is-fault .bdr-system__state { color: #E8B978; }
.animation-backup .bdr-system.is-recovered {
  border-color: rgba(45, 212, 167, 0.44);
  box-shadow: 0 0 28px -12px rgba(45, 212, 167, 0.55);
}

.animation-backup .bdr-system.is-recovered .bdr-system__dot {
  background: var(--teal);
  box-shadow: 0 0 0 3px rgba(45, 212, 167, 0.13);
}

.animation-backup .bdr-system.is-recovered .bdr-system__state { color: var(--teal-text); }

.animation-backup .bdr-track {
  position: relative;
  z-index: 1;
}

.animation-backup .bdr-track__label {
  display: block;
  margin-bottom: 12px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}

.animation-backup .bdr-track__rail {
  position: relative;
}

.animation-backup .bdr-track__line {
  position: absolute;
  top: 7px;
  left: 12.5%;
  right: 12.5%;
  height: 1px;
  background: rgba(126, 156, 204, 0.16);
  transition: background 0.7s ease;
}

.animation-backup .bdr-track__line.is-on {
  background: linear-gradient(90deg,
    rgba(126, 156, 204, 0.16),
    rgba(59, 130, 246, 0.42) 20%,
    rgba(59, 130, 246, 0.42) 80%,
    rgba(126, 156, 204, 0.16));
}
.animation-backup .bdr-track__sweep {
  position: absolute;
  top: -10px;
  bottom: -10px;
  left: -14%;
  width: 52px;
  opacity: 0;
  pointer-events: none;
  background: linear-gradient(90deg,
    transparent,
    rgba(45, 212, 167, 0.18),
    transparent);
}

.animation-backup .bdr-track__sweep.is-on {
  animation: offering-backup-bdr-sweep 1.6s cubic-bezier(0.4, 0, 0.2, 1) 1;
}

@keyframes offering-backup-bdr-sweep {
  0%   { left: -14%; opacity: 0; }
  14%  { opacity: 1; }
  86%  { opacity: 1; }
  100% { left: 106%; opacity: 0; }
}

.animation-backup .bdr-points {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.animation-backup .bdr-point {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  opacity: 0;
  transform: translateY(6px);
  transition:
    opacity 0.55s ease,
    transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.animation-backup .bdr-point.is-on { opacity: 1; transform: none; }
.animation-backup .bdr-point.is-unverified { opacity: 1; }

.animation-backup .bdr-point__dot {
  position: relative;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: #2C3852;
  border: 1px solid rgba(126, 156, 204, 0.28);
  transition:
    background 0.55s ease,
    border-color 0.55s ease,
    box-shadow 0.55s ease,
    transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.animation-backup .bdr-point.is-complete .bdr-point__dot {
  background: var(--blue);
  border-color: rgba(96, 165, 250, 0.6);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}
.animation-backup .bdr-point.is-verified .bdr-point__dot {
  background: var(--teal);
  border-color: rgba(45, 212, 167, 0.7);
  box-shadow:
    0 0 0 4px rgba(45, 212, 167, 0.14),
    0 0 16px rgba(45, 212, 167, 0.45);
  transform: scale(1.12);
}
.animation-backup .bdr-point.is-selected .bdr-point__dot {
  animation: offering-backup-bdr-point-select 4.4s ease-in-out infinite;
}

@keyframes offering-backup-bdr-point-select {
  0%, 100% { box-shadow: 0 0 0 4px rgba(45, 212, 167, 0.14), 0 0 16px rgba(45, 212, 167, 0.45); }
  50%      { box-shadow: 0 0 0 8px rgba(45, 212, 167, 0.07), 0 0 22px rgba(45, 212, 167, 0.6); }
}
.animation-backup .bdr-point__beam {
  position: absolute;
  left: 50%;
  top: 7px;
  width: 1px;
  height: 54px;
  opacity: 0;
  transform: translate(-50%, -100%) scaleY(0);
  transform-origin: bottom center;
  background: linear-gradient(180deg,
    rgba(45, 212, 167, 0),
    rgba(45, 212, 167, 0.5));
  transition:
    opacity 0.5s ease,
    transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  pointer-events: none;
}

.animation-backup .bdr-point.is-selected .bdr-point__beam {
  opacity: 1;
  transform: translate(-50%, -100%) scaleY(1);
}

.animation-backup .bdr-point__index {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--dim);
  transition: color 0.5s ease;
}

.animation-backup .bdr-point.is-verified .bdr-point__index { color: var(--teal-text); }

.animation-backup .bdr-point__state {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-align: center;
  color: var(--dim);
  transition: color 0.5s ease;
}

.animation-backup .bdr-point.is-complete .bdr-point__state { color: #7FA6E8; }
.animation-backup .bdr-point.is-verified .bdr-point__state { color: var(--teal-text); }

.animation-backup .bdr-event {
  position: relative;
  display: flex;
  align-items: center;
