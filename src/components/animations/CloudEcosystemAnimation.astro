    <g transform="translate(160 392)"><g class="mcv-a n-itk mcv-itk">
      <rect class="mcv-itk-card" x="-130" y="-28" width="260" height="56" rx="14"/>
      <g class="mcv-icon" transform="translate(-100 0)"><circle r="13" class="mcv-icon-bg"/><path d="M0-6l5.5 2v4c0 3.5-2.5 5.5-5.5 7c-3-1.5-5.5-3.5-5.5-7v-4zM-2.3 .3l1.6 1.6l3-3.2"/></g>
      <text x="-78" y="-2" class="mcv-label mcv-itk-label">ITKeepers</text>
