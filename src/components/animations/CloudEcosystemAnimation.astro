    </defs>
    <ellipse class="mcv-glow" cx="160" cy="220" rx="170" ry="230" fill="url(#mcvGlowM)"/>
    <rect class="mcv-frame-base" x="14" y="100" width="292" height="230" rx="18"/>
    <rect class="mcv-frame" x="14" y="100" width="292" height="230" rx="18" pathLength="1"/>

    <path class="mcv-line l-1" d="M160 68 V104" pathLength="1"/>
    <path class="mcv-line l-2" d="M160 152 V185" pathLength="1"/>
    <path class="mcv-line l-3" d="M160 239 V272" pathLength="1"/>
    <path class="mcv-line mcv-mgmt l-5" d="M160 320 V330" pathLength="1"/>
    <path class="mcv-line mcv-mgmt l-4" d="M160 330 V364" pathLength="1"/>

    <g class="mcv-pulses">
      <circle r="3" opacity="0" class="mcv-pulse"><animate attributeName="opacity" values="0;1;1;0" keyTimes="0;.2;.8;1" dur="5.6s" begin="0.7s" repeatCount="indefinite"/><animateMotion dur="5.6s" begin="0.7s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .55 1" path="M160 68 V104"/></circle>
      <circle r="3" opacity="0" class="mcv-pulse"><animate attributeName="opacity" values="0;1;1;0" keyTimes="0;.2;.8;1" dur="5.6s" begin="2.1s" repeatCount="indefinite"/><animateMotion dur="5.6s" begin="2.1s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .55 1" path="M160 152 V185"/></circle>
      <circle r="3" opacity="0" class="mcv-pulse"><animate attributeName="opacity" values="0;1;1;0" keyTimes="0;.2;.8;1" dur="5.6s" begin="3.5s" repeatCount="indefinite"/><animateMotion dur="5.6s" begin="3.5s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines=".45 0 .55 1" path="M160 239 V272"/></circle>
    </g>

    <g transform="translate(160 44)"><g class="mcv-a n-user">
