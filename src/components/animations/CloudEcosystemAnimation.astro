</div>
</figure>
<style>

  
  

  .mcv {
    --mcv-itk: #42BAEB;
    --mcv-cloud: #5AA9FF;
    --mcv-ok: var(--itk-success, #2DD4A7);
    --mcv-surface: var(--surface-2, #0E1B2E);
    --mcv-surface-hi: var(--surface-3, #13243C);
    --mcv-text: var(--itk-text, #E8F1FA);
    --mcv-muted: var(--itk-muted, #8FA6BF);
    --mcv-line: rgba(90, 169, 255, .22);
    position: relative; width: 100%; max-width: 600px; margin-inline: auto;
  }
  .mcv-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .mcv-mobile { display: none; }
  @media (max-width: 640px) {
    .mcv { max-width: 340px; }
    .mcv-desktop { display: none; }
    .mcv-mobile { display: block; }
  }

  /* Nodes */
  .mcv-card { fill: var(--mcv-surface); stroke: rgba(90,169,255,.38); stroke-width: 1;
    filter: drop-shadow(0 6px 14px rgba(0,8,20,.45)); }
  .is-primary .mcv-card { fill: var(--mcv-surface-hi); stroke: rgba(90,169,255,.6); }
  .mcv-icon-bg { fill: rgba(90,169,255,.12); stroke: rgba(90,169,255,.35); stroke-width: 1; }
  .mcv-icon path { fill: none; stroke: var(--mcv-cloud); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .mcv-label { fill: var(--mcv-text); font: 600 15px/1 var(--font-sans, Inter, system-ui, -apple-system, "Segoe UI", sans-serif); letter-spacing: .01em; }
  .is-primary .mcv-label { font-size: 17px; }
  .mcv-sub { fill: var(--mcv-muted); font: 500 11px/1 var(--font-sans, Inter, system-ui, -apple-system, "Segoe UI", sans-serif); letter-spacing: .04em; }

  /* ITKeepers layer */
  .mcv-itk-card { fill: var(--mcv-surface-hi); stroke: var(--mcv-itk); stroke-width: 1.25;
    filter: drop-shadow(0 8px 22px rgba(66,186,235,.18)); }
  .mcv-itk .mcv-icon path { stroke: var(--mcv-itk); }
  .mcv-itk .mcv-icon-bg { fill: rgba(66,186,235,.14); stroke: rgba(66,186,235,.5); }
  .mcv-itk-label { font-size: 17px; }
  .mcv-ok { fill: var(--mcv-ok); }
  .mcv-frame { fill: none; stroke: var(--mcv-itk); stroke-opacity: .45; stroke-width: 1.25; stroke-dasharray: 1; }

  /* Lines & pulses */
  .mcv-line { fill: none; stroke: var(--mcv-line); stroke-width: 1.6; stroke-linecap: round; stroke-dasharray: 1; }
  .mcv-mgmt { stroke: var(--mcv-itk); stroke-opacity: .6; }

  .mcv-glow { opacity: 0; }

  /* Animated inner groups (outer <g> holds the position) */
  .mcv-a { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .mcv-line, .mcv-frame { stroke-dashoffset: 1; }
  .mcv-pulses { opacity: 0; }

  /* ===== Calm timeline: slow, eased, overlapping (~4.4s) ===== */
  .mcv { --ease: cubic-bezier(.33,0,.15,1); }
  .mcv[data-phase="play"] .mcv-glow { animation: mcvFade 1.92s var(--ease) 0s forwards; }
  /* Present the user anchor during the shared entrance, without a second fade. */
  .mcv .n-user { opacity: 1; transform: none; }
  .mcv[data-phase="play"] .l-1 { animation: mcvDraw 0.58s var(--ease) 0s forwards; }
  .mcv[data-phase="play"] .n-entra { animation: mcvIn 0.7s var(--ease) 0.15s forwards; }
  .mcv[data-phase="play"] .l-2 { animation: mcvDraw 0.58s var(--ease) 0.65s forwards; }
  .mcv[data-phase="play"] .n-m365  { animation: mcvIn 0.77s var(--ease) 0.9s forwards; }
  .mcv[data-phase="play"] .l-3 { animation: mcvDraw 0.7s var(--ease) 1.86s forwards; }
  .mcv[data-phase="play"] .n-dev   { animation: mcvIn 0.7s var(--ease) 2.11s forwards; }
  .mcv[data-phase="play"] .mcv-frame { animation: mcvDraw 1.41s var(--ease) 2.56s forwards; }
  .mcv[data-phase="play"] .l-4 { animation: mcvDraw 0.58s var(--ease) 2.75s forwards; }
  .mcv[data-phase="play"] .l-5 { animation: mcvDraw 0.5s var(--ease) 2.6s forwards; }
  .mcv[data-phase="play"] .mcv-itk-card { animation: mcvItkSettle 0.7s var(--ease) 3.7s forwards; }
  .mcv[data-phase="play"] .n-itk { animation: mcvIn 0.83s var(--ease) 2.94s forwards; }

  /* ===== Settled: quiet final state =====
     Keep only two ambient cues:
     1) a very subtle ITKeepers breathe
     2) occasional slow data pulses */
  .mcv[data-phase="settled"] .mcv-a { opacity: 1; transform: none; }
  .mcv[data-phase="settled"] .mcv-line,
  .mcv[data-phase="settled"] .mcv-frame { stroke-dashoffset: 0; }
  .mcv[data-phase="settled"] .mcv-glow { opacity: 1; animation: none; transform: none; }
  .mcv[data-phase="settled"] .mcv-pulses { animation: mcvFade 1.2s ease forwards; }
  .mcv[data-phase="settled"] .mcv-itk-card { animation: mcvItkBreathe 8s ease-in-out infinite; stroke-width: 1.4; }
  .mcv[data-phase="settled"] .mcv-ok { opacity: 1; animation: none; transform: none; }
  .mcv[data-phase="settled"] .mcv-frame { stroke-dasharray: none; animation: none; stroke-opacity: .5; }
  .mcv[data-phase="settled"] .mcv-mgmt { stroke-opacity: .68; }
  .mcv-frame-base { fill: none; stroke: #42BAEB; stroke-opacity: 0; stroke-width: 1; }
  .mcv[data-phase="settled"] .mcv-frame-base { stroke-opacity: .22; transition: stroke-opacity 1.8s ease; }

  /* Pulses: small, soft, with a fading trail */
  .mcv-pulse { fill: var(--mcv-itk); r: 2.5; opacity: .9; filter: drop-shadow(0 0 5px rgba(66,186,235,.6)); }

  @keyframes mcvIn { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }
  @keyframes mcvDraw { to { stroke-dashoffset: 0; } }
  @keyframes mcvFade { to { opacity: 1; } }
  @keyframes mcvItkBreathe { 0%,100% { filter: drop-shadow(0 8px 20px rgba(66,186,235,.14)); } 50% { filter: drop-shadow(0 8px 24px rgba(66,186,235,.22)); } }
  @keyframes mcvItkSettle { to { stroke-width: 1.4; } }

  @media (prefers-reduced-motion: reduce) {
    .mcv .mcv-a, .mcv .mcv-glow { opacity: 1 !important; transform: none !important; animation: none !important; }
    .mcv .mcv-line, .mcv .mcv-frame { stroke-dashoffset: 0 !important; animation: none !important; }
    .mcv .mcv-pulses { display: none; }
    .mcv .mcv-frame { stroke-dasharray: none !important; stroke-opacity: .6; }
    .mcv .mcv-frame-base { stroke-opacity: .24; }
    .mcv .mcv-mgmt { stroke-opacity: .68; }
    .mcv .mcv-itk-card { stroke-width: 1.4; }
  }


 .animation-cloud-ecosystem { position:relative; margin:0; }
 .mcv[data-motion="paused"] :global(*) { animation-play-state:paused!important; }
 .mcv[data-motion="running"] :global(*) { animation-play-state:running; }
 .mcv[data-phase="settled"] .mcv-pulses { pointer-events:none; }
 :global([data-hero-theme="day"]) .mcv { --mcv-surface:#f4f7fb; --mcv-surface-hi:#e9f3fa; --mcv-text:var(--n); --mcv-muted:#42566f; --mcv-cloud:#2763a5; --mcv-itk:#075d7d; --mcv-ok:#207644; }
 @media (prefers-reduced-motion:reduce) { .mcv :global(*) { animation:none!important; transition:none!important; } }
 @media (forced-colors:active) { .mcv text { fill:CanvasText; } .mcv :is(.mcv-card,.mcv-itk-card) { fill:Canvas; stroke:CanvasText; } }
</style>
<script>
import { mountAnimation } from '../../scripts/animation-lifecycle';
import { createServiceStory } from '../../scripts/service-operational-stories';
document.querySelectorAll<HTMLElement>('.animation-cloud-ecosystem').forEach(root => {
 mountAnimation(root, scheduler => createServiceStory(root, scheduler, 'cloud'));
});
</script>

