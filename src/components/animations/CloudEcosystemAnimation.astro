  </svg>

  <!-- ===== Mobile (≤640px) ===== -->
  <svg class="mcv-svg mcv-mobile" viewBox="0 0 320 450" role="img"
       aria-label="User, Entra ID, Microsoft 365, devices and collaboration, managed by ITKeepers">
    <defs>
      <radialGradient id="mcvGlowM" cx="50%" cy="50%" r="55%">
        <stop offset="0" stop-color="#42BAEB" stop-opacity=".14"/>
