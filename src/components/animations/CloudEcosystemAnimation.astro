      <g class="mcv-icon" transform="translate(-84 0)"><circle r="13" class="mcv-icon-bg"/><path d="M-5-5h4.5v4.5H-5zM.5-5H5v4.5H.5zM-5 .5h4.5V5H-5zM.5 .5H5V5H.5z"/></g>
      <text x="-62" y="6" class="mcv-label">Microsoft 365</text>
    </g></g>

    <g transform="translate(160 296)"><g class="mcv-a n-dev">
