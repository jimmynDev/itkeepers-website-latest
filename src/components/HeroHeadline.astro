<!-- Headline and choreography adapted from the approved yourITis.html. -->
<h1 class="itk-hero-accessible" id="home-title">Your IT person is a team.</h1>
<div class="itk-hero-title" data-hero-headline>
  <span class="itk-hero-fixed" aria-hidden="true">Your IT person</span>
  <span class="itk-hero-rotator" role="group" aria-label="IT capabilities. Rotation pauses while focused." aria-live="off">
    <span class="itk-hero-viewport">
    <span class="itk-hero-role itk-hero-brand is-active" aria-hidden="true">is a team.</span>
    <span class="itk-hero-role itk-hero-support" aria-hidden="true">is support.</span>
    <span class="itk-hero-role itk-hero-cloud" aria-hidden="true">is cloud.</span>
    <span class="itk-hero-role itk-hero-security" aria-hidden="true">is security.</span>
    <span class="itk-hero-role itk-hero-automation" aria-hidden="true">is automation.</span>
    <span class="itk-hero-role itk-hero-digital" aria-hidden="true">is digital.</span>
    </span>
  </span>
</div>

<style>
  :global(.home-hero) .itk-hero-title {
    --hero-accent-cyan:var(--itk-brand-cyan);
    --hero-accent-sky:var(--itk-cyan-sky);
    --hero-accent-deep:var(--itk-cyan-deep);
    --itk-hero-shift: 10px;
    --itk-hero-blur: 1.25px;
    --itk-hero-duration: 350ms;
    --itk-hero-ease: ease-out;
    display: flex; flex-direction: column; align-items: stretch;
    margin: 0; max-inline-size:1100px; text-wrap:balance; font-size: clamp(50px, 8vw, 112px); font-weight: 800;
    line-height: 1.08; letter-spacing: -.03em; text-align: start;
  }
  .itk-hero-fixed { display: block; color: #fff; }
  /* All six variants occupy one grid cell, reserving the longest wrapped height. */
  .itk-hero-rotator { display:block; position:relative; filter:drop-shadow(0 0 24px rgba(66,186,235,.2)); }
  .itk-hero-viewport { display:grid; grid-template-columns:minmax(0,1fr); overflow:hidden; padding:.4em 0; margin:-.4em 0; }
  .itk-hero-rotator:focus-visible { outline:none; box-shadow:0 3px 0 var(--focus),0 6px 0 var(--bg); }
  /* Extend the gradient paint box below the line box to include font descenders. */
  .itk-hero-role { grid-area: 1 / 1; justify-self: start; max-width: 100%; padding-block-end:.12em; white-space: normal; overflow-wrap:anywhere; opacity: 0; color:var(--hero-accent-cyan); }
  .itk-hero-role.is-active { opacity: 1; }
  @supports ((background-clip:text) or (-webkit-background-clip:text)) {
    .itk-hero-role { background-image:linear-gradient(135deg,var(--hero-accent-sky) 0%,var(--hero-accent-cyan) 50%,var(--hero-accent-deep) 100%); background-clip:text; -webkit-background-clip:text; color:transparent; }
  }
  .itk-hero-title[data-enhanced] .itk-hero-role {
    opacity: 0; transform: translate3d(0, var(--itk-hero-shift), 0); filter: blur(var(--itk-hero-blur));
    transition-property: opacity, transform, filter; transition-duration: var(--itk-hero-duration); transition-timing-function: var(--itk-hero-ease);
  }
  .itk-hero-title[data-enhanced] .itk-hero-role.is-active { opacity: 1; transform: translate3d(0, 0, 0); filter: blur(0); }
  .itk-hero-title[data-enhanced] .itk-hero-role.is-leaving { opacity: 0; transform: translate3d(0, calc(-1 * var(--itk-hero-shift)), 0); filter: blur(var(--itk-hero-blur)); }
  .itk-hero-title[data-enhanced] .itk-hero-role.no-anim { transition: none !important; }
  .itk-hero-accessible { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); clip-path: inset(50%); white-space: nowrap; border: 0; }
  :global([data-hero-theme="day"]) .itk-hero-fixed { color: var(--n); }
  :global([data-hero-theme="day"] .home-hero) .itk-hero-title { --hero-accent-sky:var(--itk-cyan-sky-light); --hero-accent-cyan:var(--itk-cyan-light); --hero-accent-deep:var(--itk-cyan-deep-light); }
  :global([data-hero-theme="day"]) .itk-hero-rotator { filter:none; }
  @media (max-width: 480px) { :global(.home-hero) .itk-hero-title { font-size: clamp(34px, 10.6vw, 50px); } }
  @media (prefers-reduced-motion: no-preference) { .itk-hero-title[data-enhanced] { animation: itk-hero-in 400ms cubic-bezier(.22,1,.36,1) both; } }
  @keyframes itk-hero-in { from { opacity: 0; } to { opacity: 1; } }
  /* The local preference attribute also makes a live preference change immediate. */
  .itk-hero-title[data-reduced] { animation: none; }
  .itk-hero-title[data-reduced][data-enhanced] .itk-hero-role { transform: none !important; filter: none !important; transition: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .itk-hero-title { animation: none !important; }
    .itk-hero-title[data-enhanced] .itk-hero-role { transform: none !important; filter: none !important; transition: none !important; }
  }
  @media (forced-colors: active) {
    .itk-hero-fixed, .itk-hero-role { color:CanvasText; background:none; }
    .itk-hero-rotator { filter:none; }
    .itk-hero-rotator:focus-visible { box-shadow:none; }
    .itk-hero-rotator:focus-visible::after { content:''; position:absolute; inset-inline:0; inset-block-end:-3px; border-block-end:3px solid Highlight; pointer-events:none; }
  }
</style>

<script>
  import { mountHeroHeadline } from '../scripts/hero-headline';
  document.querySelectorAll<HTMLElement>('[data-hero-headline]').forEach(mountHeroHeadline);
</script>
