---
import Base from '../layouts/Base.astro';const {title,intro,points=[],boundary,scopeHeading='What the team handles.',cta='Talk to our team'}=Astro.props;
const hasHeroVisual = Astro.slots.has('hero-visual');
---
<Base>{hasHeroVisual ? <section class="section service-hero-with-visual"><div class="service-hero-copy"><p class="eyebrow">ITKeepers services</p><h1>{title}</h1><p class="lead">{intro}</p><slot name="context" /></div><div class="service-hero-visual"><slot name="hero-visual" /></div></section> : <section class="section"><p class="eyebrow">ITKeepers services</p><h1>{title}</h1><p class="lead">{intro}</p><slot name="context" /></section>}<slot name="after-hero" /><section class="section light"><div class="split"><div><h2>{scopeHeading}</h2><p>{boundary}</p></div><div>{points.map((p)=><article><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div></div></section><slot /><section class="cta"><h2>Bring the context. We'll start there.</h2><a class="btn white" href="/contact/">{cta}</a></section><Fragment slot="after-footer"><slot name="after-footer" /></Fragment></Base>
