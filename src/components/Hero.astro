---
import HeroHeadline from './HeroHeadline.astro';
---
<section class="hero home-hero" aria-labelledby="home-title">
  <div class="hero-day-light" aria-hidden="true"></div>
  <div class="hero-heading"><HeroHeadline /></div>
  <div class="hero-bottom"><p class="lead">Familiar engineers. Shared context. A whole team behind the work.</p><a class="btn hero-cta" href="/contact">Book a free IT review</a></div>
  <div class="hero-tenets" role="group" aria-label="ITKeepers proof points"><p><span class="tenet-number" aria-hidden="true">01</span><strong>15+ years</strong><span>Experience</span></p><p><span class="tenet-number" aria-hidden="true">02</span><strong>50+</strong><span>Clients supported</span></p><p><span class="tenet-number" aria-hidden="true">03</span><strong>1,500+</strong><span>Endpoints managed</span></p><p><span class="tenet-number" aria-hidden="true">04</span><strong>2 locations</strong><span>Lebanon &amp; USA</span></p></div>
</section>

<style>
  .home-hero .hero-tenets { grid-template-columns:repeat(4,minmax(0,1fr)); }
  @media (max-width:900px) {
    .home-hero .hero-tenets { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .home-hero .hero-tenets p { min-inline-size:0; grid-template-columns:36px minmax(0,1fr); }
    .home-hero .hero-tenets :is(strong,p > span:last-child) { overflow-wrap:anywhere; }
    .home-hero .hero-tenets p:nth-last-child(-n+2) { border-block-end:0; }
  }
  .hero-heading { position: relative; }
  :global(.home-page) .home-hero {
    position: relative;
    isolation: isolate;
    background: transparent;
    --hero-grid-ink: var(--text-light);
  }
  .home-hero::before,
  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .home-hero::before {
    background-image:
      linear-gradient(var(--hero-grid-ink) 1px, transparent 1px),
      linear-gradient(90deg, var(--hero-grid-ink) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: 0 calc(-1 * var(--hero-grid-offset));
    opacity: .05;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 72%, rgba(0,0,0,.75) 82%, rgba(0,0,0,.30) 92%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 72%, rgba(0,0,0,.75) 82%, rgba(0,0,0,.30) 92%, transparent 100%);
    mask-position: 0 0;
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
  .home-hero::after {
    background: radial-gradient(ellipse 42% 75% at 85% 35%, var(--c), transparent 70%);
    opacity: .12;
  }
  .home-hero > div:not(.hero-day-light) {
    position: relative;
    z-index: 1;
  }
  .home-hero .hero-day-light {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(circle 420px at var(--hero-mouse-x, 50%) var(--hero-mouse-y, 50%), color-mix(in srgb,var(--itk-brand-cyan) 20%,transparent), transparent 70%);
  }
  :global([data-hero-theme="day"] .home-page) .home-hero {
    --fg: var(--n);
    --muted: #42566f;
    --accent: #075d7d;
    --focus: var(--n);
    --hero-grid-ink: var(--n);
    color: var(--fg);
    background: var(--surface-light);
  }
  :global([data-hero-theme="day"]) .home-hero .lead { color: var(--muted); }
  :global([data-hero-theme="day"]) .home-hero .eyebrow,
  :global([data-hero-theme="day"]) .home-hero .tenet-number { color: var(--accent); }
  :global([data-hero-theme="day"]) .home-hero .hero-tenets,
  :global([data-hero-theme="day"]) .home-hero .hero-tenets p { border-color: #97c8df; }
  :global([data-hero-theme="day"]) .home-hero[data-mouse-light] .hero-day-light { display: block; }
  @media (max-width: 480px) {
    .home-hero .hero-cta { inline-size: 100%; }
  }
  /* Color interpolation fallback for browsers without view transitions. */
  @supports not (view-transition-name: hero-theme) {
    @media (prefers-reduced-motion: no-preference) {
      .home-hero { transition: background-color 650ms ease-in-out, color 650ms ease-in-out; }
      .home-hero .lead, .home-hero .eyebrow, .home-hero .tenet-number,
      .home-hero .hero-tenets, .home-hero .hero-tenets p,
      .home-hero .hero-tenets strong, .home-hero .hero-tenets p > span:last-child,
      .home-hero :global(.itk-hero-fixed), .home-hero :global(.itk-hero-toggle) {
        transition: color 650ms ease-in-out, border-color 650ms ease-in-out;
      }
    }
  }
  @media (forced-colors: active) {
    .home-hero::before,
    .home-hero::after { display: none; }
    .home-hero .hero-day-light { display: none !important; }
  }
</style>


