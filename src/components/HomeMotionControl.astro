<button type="button" class="home-motion-control" data-page-motion-control hidden>Pause motion</button>
<style>
  .home-motion-control { position:fixed; inset-inline-end:max(16px,env(safe-area-inset-right)); inset-block-end:max(16px,env(safe-area-inset-bottom)); z-index:25; min-block-size:44px; padding:8px 14px; border:1px solid var(--itk-border-strong); border-radius:999px; color:var(--itk-text); background:var(--itk-surface); font:600 12px/1.3 system-ui,sans-serif; cursor:pointer; }
  .home-motion-control:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
  :global(html[data-motion-paused] body *),:global(html[data-motion-paused] body *::before),:global(html[data-motion-paused] body *::after) { animation-play-state:paused!important; }
  /* Transient interfaces must open in their final readable state while paused. */
  :global(html[data-motion-paused] .site-header),:global(html[data-motion-paused] .site-header *),:global(html[data-motion-paused] .playbook-card) { animation:none!important; }
  @media(forced-colors:active) { .home-motion-control { color:ButtonText; background:ButtonFace; border-color:ButtonText; } }
</style>
<script>
  import { mountPageMotionControl } from '../scripts/page-motion-control';
  const button=document.querySelector<HTMLButtonElement>('[data-page-motion-control]');
  if(button) mountPageMotionControl(button);
</script>
