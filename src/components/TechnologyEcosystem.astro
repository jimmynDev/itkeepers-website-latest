---
<section class="technology-ecosystem" id="technology" aria-labelledby="technology-title">
  <div class="technology-inner">
    <div class="technology-header">
      <h2 id="technology-title"><span class="ecosystem-title-dot" aria-hidden="true"></span>OUR TECHNOLOGY ECOSYSTEM</h2>
    </div>
  </div>
  <div class="logo-stage" role="region" aria-labelledby="technology-title" tabindex="0">
    <div class="logo-track">
      {[false, true].map(duplicate => <div class="logo-group" aria-hidden={duplicate ? 'true' : undefined}>
        {logos.map(logo => <div class={'technology-logo logo-' + logo.key}>
          {['veeam','hpe'].includes(logo.key)
            ? <Fragment set:html={(logo.key === 'veeam' ? veeam : hpe).replace(/role="img"/g, duplicate ? 'aria-hidden="true"' : 'role="img"')} />
            : <img src={'/assets/technology/' + logo.key + '.svg'} alt={duplicate ? '' : logo.name + ' logo'} width={logo.width} height={logo.height} decoding="async" loading="lazy" />}
        </div>)}
      </div>)}
    </div>
  </div>
</section>
<style>
  :global(body.home-page) .technology-ecosystem {
    --itk-blue:#4071B5; --itk-cyan:#42BAEB;
    position:relative; isolation:isolate; overflow:hidden; padding:64px 0;
    color:#0b2c5f;
    background:radial-gradient(ellipse at 50% 20%,rgba(66,186,235,.045),transparent 52%),linear-gradient(180deg,#fff 0%,#f8fbff 48%,#f3f8fc 100%);
  }
  .technology-inner { width:min(1180px,calc(100% - 48px)); margin-inline:auto; }
  .technology-header { display:flex; align-items:center; justify-content:center; text-align:center; margin:0 auto 14px; }
  #technology-title { display:inline-flex; align-items:center; justify-content:center; gap:7px; margin:0; padding:0 10px; font-size:10px; line-height:1.4; font-weight:650; letter-spacing:.12em; text-transform:uppercase; color:#53677f; }
  .ecosystem-title-dot { width:4px; height:4px; flex:0 0 4px; border-radius:50%; background:#42BAEB; box-shadow:0 0 0 3px rgba(66,186,235,.05),0 0 8px rgba(66,186,235,.10); }
    .logo-stage {
      position: relative;

      width: 100%;

      padding: 20px 0 24px;

      overflow: hidden;
    }

    /*
      Soft fade at both sides.
      Logos never disappear through a hard edge.
    */

    .logo-stage::before,
    .logo-stage::after {
      content: "";

      position: absolute;

      top: 0;
      bottom: 0;

      width: min(140px, 12vw);

      z-index: 5;

      pointer-events: none;
    }

    .logo-stage::before {
      left: 0;

      background:
        linear-gradient(
          90deg,
          #f7faff 5%,
          rgba(247, 250, 255, 0.84) 32%,
          transparent 100%
        );
    }

    .logo-stage::after {
      right: 0;

      background:
        linear-gradient(
          270deg,
          #f7faff 5%,
          rgba(247, 250, 255, 0.84) 32%,
          transparent 100%
        );
    }

    /* =====================================================
       MOVING MARQUEE
    ====================================================== */

    .logo-track {
      display: flex;

      width: max-content;

      animation:
        technology-scroll 38s linear infinite;

      will-change: transform;
    }

    .logo-stage:hover .logo-track {
      animation-play-state: paused;
    }

    .logo-group {
      display: flex;
      align-items: center;

      flex-shrink: 0;

      gap: 68px;

      padding-right: 68px;
    }

    @keyframes technology-scroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-50%);
      }
    }

    /* =====================================================
       LOGOS — real SVG artwork, monochrome via CSS
    ====================================================== */

    .technology-logo {
      position: relative;
      min-width: max-content;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 88px;
      padding: 18px 6px;
      cursor: default;
      opacity: 0.78;
      transform: translateY(0) scale(1);
      transition:
        opacity 260ms ease,
        transform 260ms ease;
    }

    .technology-logo::before {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 5px;
      width: 70%;
      height: 26px;
      transform: translateX(-50%) scaleX(0.7);
      border-radius: 50%;
      background:
        radial-gradient(
          ellipse,
          rgba(66, 186, 235, 0.16),
          transparent 72%
        );
      filter: blur(8px);
      opacity: 0;
      transition:
        opacity 260ms ease,
        transform 260ms ease;
    }

    .technology-logo::after {
      content: "";
      position: absolute;
      left: 20%;
      right: 20%;
      bottom: 3px;
      height: 1px;
      background:
        linear-gradient(
          90deg,
          transparent,
          var(--itk-blue),
          var(--itk-cyan),
          transparent
        );
      transform: scaleX(0);
      opacity: 0;
      transition:
        opacity 260ms ease,
        transform 260ms ease;
    }

    .technology-logo:hover {
      opacity: 1;
      transform:
        translateY(-4px)
        scale(1.035);
    }

    .technology-logo:hover::before {
      opacity: 1;
      transform:
        translateX(-50%)
        scaleX(1);
    }

    .technology-logo:hover::after {
      opacity: 0.85;
      transform: scaleX(1);
    }

    /*
      Keep the original vector artwork.
      CSS removes the brand colors without rasterizing the logo.
    */
    .technology-logo img,
    .technology-logo :global(svg) {
      display: block;
      width: auto;
      height: auto;
      object-fit: contain;
      color: #748296;
      fill: currentColor;
      filter:
        grayscale(1)
        saturate(0)
        brightness(0.79)
        contrast(1.08);
      opacity: 0.92;
      transform: translateZ(0);
      transition:
        filter 260ms ease,
        opacity 260ms ease,
        transform 260ms ease;
      user-select: none;
      -webkit-user-drag: none;
    }

    .technology-logo:hover img,
    .technology-logo:hover :global(svg) {
      filter:
        grayscale(1)
        saturate(0)
        brightness(0.63)
        contrast(1.12);
      opacity: 1;
      transform: scale(1.015);
    }

    /* Optical sizing so each brand has similar visual weight. */
    .logo-microsoft img   { width: 208px; max-height: 48px; }
    .logo-bitdefender img { width: 205px; max-height: 48px; }
    .logo-fortinet img    { width: 205px; max-height: 36px; }
    .logo-veeam :global(svg)       { width: 198px; height: 50px; }
    .logo-meraki img      { width: 155px; max-height: 58px; }
    .logo-ubiquiti img    { width: 180px; max-height: 58px; }
    .logo-vmware img      { width: 210px; max-height: 45px; }
    .logo-hpe :global(svg)         { width: 185px; max-height: 52px; overflow:visible; }
    .logo-naverisk img    { width: 210px; max-height: 48px; }
    .logo-mikrotik img    { width: 205px; max-height: 48px; }

    
  .logo-stage:focus-visible { outline:2px solid #4071B5; outline-offset:-3px; }
  .logo-stage:focus-within .logo-track { animation-play-state:paused; }
  @media(max-width:768px) {
    :global(body.home-page) .technology-ecosystem { padding:64px 0; }
    .technology-inner { width:min(calc(100% - 32px),1180px); }
    .logo-group { gap:45px; padding-right:45px; }
    .technology-logo { min-height:75px; }
    .technology-logo img,.technology-logo :global(svg) { max-width:165px; max-height:42px; }
    .logo-veeam :global(svg) { width:165px; height:42px; }
    .logo-meraki img { width:138px; max-height:50px; }
    .logo-track { animation-duration:30s; }
  }
  @media(prefers-reduced-motion:reduce) {
    .logo-track { animation:none; }
    .logo-stage { overflow-x:auto; scrollbar-width:none; }
    .logo-stage::-webkit-scrollbar { display:none; }
    .logo-group[aria-hidden="true"] { display:none; }
    .technology-logo,.technology-logo img,.technology-logo :global(svg) { transition:none; }
  }
  @media(forced-colors:active) { .logo-stage::before,.logo-stage::after { display:none; } #technology-title { color:CanvasText; } }
</style>
