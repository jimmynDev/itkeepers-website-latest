---
import { inquiryLimits } from '../data/inquiry';
import { formspreeEndpoint, formspreeSubject } from '../data/formspree';
import { businessPhone, contactEmail } from '../data/contact';
import '../styles/inquiry-form.css';

const { compact=false, id='contact' } = Astro.props as { compact?: boolean; id?: string };
const Heading = compact ? 'h3' : 'h2';
// The approved provider is direct browser-to-Formspree; both ITKeepers APIs stay disabled.
const fields = compact ? ['name','email','phone','company'] as const : ['name','email','company','phone'] as const;
const labels = { name:'Full name', email:'Work email', company:'Company', phone:'Phone' };
const types = { name:'text', email:'email', company:'text', phone:'tel' };
const autocomplete = { name:'name', email:'email', company:'organization', phone:'tel' };
---
<section class:list={['inquiry-widget', { 'inquiry-widget--compact': compact }]} aria-labelledby={id + '-form-title'}>
  <Heading id={id + '-form-title'} class="inquiry-heading">{compact ? 'Book your free IT consultation.' : 'Send us a message'}</Heading>
      <form class:list={['inquiry-form', { 'inquiry-compact': compact }]} method="post" action={formspreeEndpoint} data-inquiry-form data-inquiry-delivery="formspree" data-inquiry-mode={compact ? 'review' : 'contact'} aria-labelledby={id + '-form-title'} aria-describedby={id + '-privacy'}>
        <input type="hidden" name="type" value={compact ? 'review' : 'general'} disabled={!compact} />
        <input type="hidden" name="form_kind" value={compact ? 'review' : 'contact'} />
        {compact && <input type="hidden" name="_subject" value={formspreeSubject('review')} />}
        <div hidden aria-hidden="true"><label for={id + '-gotcha'}>Leave this field empty<input id={id + '-gotcha'} name="_gotcha" type="text" tabindex="-1" autocomplete="off" /></label></div>
        {compact && <input type="hidden" name="message" value="I'd like a free IT consultation." />}
        <div class="inquiry-fields">
          {!compact && <div class="inquiry-field inquiry-type">
            <label for={id + '-type'}>Inquiry type</label>
            <select id={id + '-type'} name="_subject" data-inquiry-intent>
              <option value={formspreeSubject('general')}>General inquiry</option>
              <option value={formspreeSubject('review')}>Free IT Consultation</option>
            </select>
            <noscript><p class="inquiry-email-note">For a free IT consultation, select “Free IT Consultation” and briefly describe what you need below.</p></noscript>
          </div>}
          {fields.map(name => <div class="inquiry-field">
            <label for={id + '-' + name}>{labels[name]} <span>({name === 'name' || name === 'email' ? 'required' : 'optional'})</span></label>
            <input id={id + '-' + name} name={name} type={types[name]} autocomplete={autocomplete[name]} inputmode={name === 'email' ? 'email' : name === 'phone' ? 'tel' : undefined} spellcheck={name === 'email' ? 'false' : undefined} maxlength={inquiryLimits[name]} required={name === 'name' || name === 'email'} aria-describedby={id + '-' + name + '-error'} />
            <p class="inquiry-error" id={id + '-' + name + '-error'} data-field-error={name} hidden></p>
          </div>)}
          {!compact && <div class="inquiry-field inquiry-message">
            <label for={id + '-message'}>How can we help? <span>(required)</span></label>
            <textarea id={id + '-message'} name="message" rows="4" maxlength={inquiryLimits.message} required placeholder="Briefly describe what you're looking for…" aria-describedby={id + '-message-error'}></textarea>
            <p class="inquiry-error" id={id + '-message-error'} data-field-error="message" hidden></p>
          </div>}
        </div>
        <button class="btn inquiry-submit" type="submit">{compact ? 'Request my free IT consultation' : 'Send my message'}</button>
        <p class="inquiry-privacy" id={id + '-privacy'}>Formspree processes inquiries for a temporary administrator-managed inbox. <a href="/privacy/">Privacy notice</a>.</p>
        <div data-formspree-verification hidden>
          <p class="inquiry-email-note">Continue on Formspree to complete any required verification. This submits your details and leaves this website.</p>
          <button class="btn inquiry-provider-submit" type="submit" data-formspree-native>Continue on Formspree</button>
        </div>
        <p class="inquiry-status" data-inquiry-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
        <p class="inquiry-email-note" data-inquiry-error-contacts hidden>Prefer another way? <a href={contactEmail.href}>Email {contactEmail.display}</a> or <a href={businessPhone.href}>call {businessPhone.display}</a>.</p>
      </form>
    <!-- Provider acceptance is distinct from verified inbox delivery. -->
</section>
<script>
  import { initializeContactForms } from '../scripts/contact-form';
  initializeContactForms();
  document.addEventListener('astro:page-load', () => initializeContactForms());
</script>
