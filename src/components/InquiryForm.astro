---
import { businessPhone, contactEmail } from '../data/contact';
import { inquiryLimits, serviceInterests } from '../data/inquiry';
import '../styles/inquiry-form.css';

const { compact=false, id='contact' } = Astro.props as { compact?: boolean; id?: string };
const Heading = compact ? 'h3' : 'h2';
const rawEndpoint = (import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ?? '').trim();
// Restrict delivery to a configured same-origin API route; never POST contact data to an arbitrary URL.
const endpoint = /^\/(?!\/)[a-zA-Z0-9/_-]+$/.test(rawEndpoint)
  && !rawEndpoint.split('/').includes('..')
  && rawEndpoint !== '/contact' ? rawEndpoint : null;
const fields = compact ? ['name','email','phone','company'] as const : ['name','email','company','phone'] as const;
const labels = { name:'Full name', email:'Work email', company:'Company', phone:'Phone' };
const types = { name:'text', email:'email', company:'text', phone:'tel' };
const autocomplete = { name:'name', email:'email', company:'organization', phone:'tel' };
---
<section class:list={['inquiry-widget', { 'inquiry-widget--compact': compact }]} aria-labelledby={id + '-form-title'}>
  <Heading id={id + '-form-title'} class="inquiry-heading">{compact ? 'Book your free IT review.' : 'Send us a message'}</Heading>
  {endpoint ? <>
    <p class="inquiry-intro">A few details are enough to get started.</p>
    <div data-inquiry-live>
      <form class:list={['inquiry-form', { 'inquiry-compact': compact }]} method="post" action={endpoint} novalidate data-inquiry-form data-inquiry-mode={compact ? 'review' : 'contact'} aria-labelledby={id + '-form-title'}>
        <input type="hidden" name="type" value={compact ? 'review' : 'general'} />
        <input type="hidden" name="form_kind" value={compact ? 'review' : 'contact'} />
        {compact && <input type="hidden" name="message" value="I\'d like a free IT review." />}
        <div class="inquiry-fields">
          {fields.map(name => <div class="inquiry-field">
            <label for={id + '-' + name}>{labels[name]} <span>({name === 'name' || name === 'email' ? 'required' : 'optional'})</span></label>
            <input id={id + '-' + name} name={name} type={types[name]} autocomplete={autocomplete[name]} inputmode={name === 'email' ? 'email' : name === 'phone' ? 'tel' : undefined} spellcheck={name === 'email' ? 'false' : undefined} maxlength={inquiryLimits[name]} required={name === 'name' || name === 'email'} aria-describedby={id + '-' + name + '-error'} />
            <p class="inquiry-error" id={id + '-' + name + '-error'} data-field-error={name} hidden></p>
          </div>)}
          {!compact && <div class="inquiry-field inquiry-message">
            <label for={id + '-message'}>How can we help? <span>(required)</span></label>
            <textarea id={id + '-message'} name="message" rows="4" maxlength={inquiryLimits.message} required placeholder="Briefly describe what you're looking for..." aria-describedby={id + '-data-help ' + id + '-message-error'}></textarea>
            <p class="inquiry-help" id={id + '-data-help'}>Please don't include passwords, account credentials or confidential technical information.</p>
            <p class="inquiry-error" id={id + '-message-error'} data-field-error="message" hidden></p>
          </div>}
        </div>
        {!compact && <details class="inquiry-details">
          <summary>Add details (optional)</summary>
          <fieldset class="inquiry-interests">
            <legend>Interested in <span>(optional)</span></legend>
            <div class="inquiry-chips">
              {serviceInterests.map(item => <div class="interest-option">
                <input type="checkbox" name="interests" value={item.value} id={id + '-interest-' + item.value} hidden />
                <button class="interest-chip" type="button" data-interest={item.value} aria-pressed="false" aria-controls={id + '-interest-' + item.value}>
                  <span class="interest-chip-mark" aria-hidden="true">✓</span><span>{item.label}</span>
                </button>
              </div>)}
            </div>
          </fieldset>
        </details>}
        <button class="btn inquiry-submit" type="submit">{compact ? 'Request my free IT review' : 'Send my message'}</button>
        <p class="inquiry-status" data-inquiry-status role="status" aria-live="polite" aria-atomic="true"></p>
        {!compact && <p class="inquiry-privacy"><a href="/privacy">Privacy notice</a></p>}
        <!-- TODO: Add a verified "what happens next" response-time sentence only after ITKeepers approves the claim. -->
      </form>
    </div>
    <div class="inquiry-result" data-inquiry-success role="status" aria-live="polite" tabindex="-1" hidden>
      <h3>Message sent.</h3>
      <p>Thank you. Your message has been received by ITKeepers.</p>
    </div>
    <div class="inquiry-unavailable" data-inquiry-unavailable hidden>
      <p data-inquiry-failure-message>Online requests are unavailable. Please contact our team directly.</p>
      <div class="inquiry-direct-actions">
        <a href={contactEmail.href}>Email our team</a>
        <a href={businessPhone.href}>Call {businessPhone.display}</a>
      </div>
    </div>
  </> : <div class="inquiry-unavailable" data-inquiry-unavailable>
    <p>Online requests are unavailable. Please contact our team directly.</p>
    <div class="inquiry-direct-actions">
      <a href={contactEmail.href}>Email our team</a>
      <a href={businessPhone.href}>Call {businessPhone.display}</a>
    </div>
    <!-- TODO: Configure PUBLIC_CONTACT_FORM_ENDPOINT to a working same-origin API route with server-side validation, spam controls, and mail delivery before enabling the form. -->
  </div>}
</section>
<script>
  import { initializeContactForms } from '../scripts/contact-form';
  initializeContactForms();
  document.addEventListener('astro:page-load', () => initializeContactForms());
</script>
