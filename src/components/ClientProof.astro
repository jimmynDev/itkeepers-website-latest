---
import {videoTestimonials,textTestimonials,videoReady} from '../data/client-proof';
const available=videoTestimonials.filter(videoReady);
const active=available[0];
const hasQuotes=textTestimonials.some(item=>item.approved&&item.quote);
const mediaConfig=JSON.stringify(available).replace(/</g,'\\u003c');
---
<section class="client-proof" id="client-proof" aria-labelledby="client-proof-title" data-client-proof>
  <div class="client-proof-inner">
    <header class="client-proof-heading"><p class="client-proof-eyebrow">CLIENT PROOF</p><h2 id="client-proof-title">What clients say after the handoff.</h2>{!active&&!hasQuotes&&<p class="proof-content-note">Client testimonial content is pending.</p>}</header>
    <figure class="client-proof-media">
      <div class="proof-media-frame" id="client-proof-media">
        {active ? <>
          <div class="proof-video-facade" data-proof-facade><img src={active.poster} alt="" width="1280" height="720" loading="lazy" decoding="async" data-proof-poster/><button type="button" class="proof-play" data-proof-play hidden>Play testimonial</button></div>
          <video class="proof-video" controls playsinline preload="none" poster={active.poster} aria-label={active.label} data-proof-video hidden></video>
          <noscript><p class="proof-media-nojs"><a href={active.sources[0].src}>Watch testimonial</a><a href={active.transcript}>Read transcript</a></p></noscript>
        </> : <div class="proof-media-pending"><span class="proof-pending-label">CONTENT PENDING</span><strong>Video testimonial</strong><p>Awaiting approved video, poster and captions.</p></div>}
      </div>
      <figcaption class="proof-media-caption"><span data-proof-video-label>{active?.label??'Video testimonial content pending'}</span>{active?.transcript&&<a href={active.transcript} data-proof-transcript>Read transcript</a>}</figcaption>
      <ul class="proof-video-selectors" aria-label="Video testimonials">
        {videoTestimonials.map((item,index)=><li><button type="button" data-proof-select={item.id} disabled={!videoReady(item)} aria-label={videoReady(item)?item.label:`Video testimonial ${index+1} — content pending`} aria-pressed={videoReady(item)?item.id===active?.id:undefined} aria-controls="client-proof-media"><span>{videoReady(item)?item.label:String(index+1).padStart(2,'0')}</span>{!videoReady(item)&&<span class="proof-slot-state">Pending</span>}</button></li>)}
      </ul>
      {active&&<p class="proof-media-status" data-proof-status role="status" aria-live="polite"></p>}
    </figure>
    <div class="proof-text-grid" aria-label="Written testimonials">
      {textTestimonials.map((item,index)=><article class="proof-text-slot" aria-labelledby={`${item.id}-title`}>
        {item.approved&&item.quote ? <blockquote><p id={`${item.id}-title`}>{item.quote}</p>{item.attribution&&Object.values(item.attribution).some(Boolean)&&<cite>{[item.attribution.name,item.attribution.role,item.attribution.company].filter(Boolean).join(' · ')}</cite>}</blockquote> : <><h3 id={`${item.id}-title`}>Written testimonial {String(index+1).padStart(2,'0')}</h3><p>Approved quote and attribution pending.</p></>}
      </article>)}
    </div>
    {active&&<script type="application/json" data-proof-config set:html={mediaConfig}></script>}
  </div>
</section>
<style>
  :global(body.home-page) .client-proof { --proof-ink:#0b2c5f; --proof-muted:#42566f; --proof-blue:#4071B5; --proof-line:#d0dfea; color:var(--proof-ink); background:linear-gradient(180deg,#edf3f8 0px,#f9fbfd 160px,#fff 65%,#fafcfe 100%); padding-block:clamp(64px,7vw,104px) clamp(64px,6vw,96px); }
  .client-proof-inner { max-width:1220px; margin-inline:auto; }
  .client-proof :is(h2,h3,p) { overflow-wrap:anywhere; }
  .client-proof-heading { display:block; height:auto; padding:0; border:0; margin:0 0 36px; background:transparent; }
  .client-proof-eyebrow { color:color-mix(in srgb,var(--proof-blue) 90%,var(--proof-ink)); font-size:12px; font-weight:700; letter-spacing:.14em; margin:0 0 22px; }
  #client-proof-title { font-size:clamp(36px,3.8vw,56px); line-height:1.08; font-weight:600; letter-spacing:-.04em; color:var(--proof-ink); max-width:21ch; margin:0; text-wrap:balance; }
  .proof-content-note { color:var(--proof-muted); font-size:16px; line-height:1.7; margin:22px 0 0; }
  .client-proof-media { max-width:1000px; margin:0; }
  .proof-media-frame { aspect-ratio:16/9; position:relative; display:grid; overflow:hidden; border:1px solid #335778; border-radius:18px; background:#102641; color:#f6fbff; }
  .proof-media-pending { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; padding:24px; text-align:center; }
  .proof-pending-label { color:#afd7ec; font-size:12px; font-weight:700; letter-spacing:.12em; }
  .proof-media-pending strong { font-size:clamp(20px,2.5vw,30px); line-height:1.3; font-weight:600; letter-spacing:-.02em; }
  .proof-media-pending p { color:#c8daeb; font-size:16px; line-height:1.6; margin:0; max-width:36ch; }
  .proof-video-facade,.proof-video { width:100%; height:100%; position:absolute; inset:0; object-fit:contain; }
  .proof-video-facade { display:grid; place-items:center; }
  .proof-video-facade[hidden],.proof-video[hidden],.proof-play[hidden] { display:none; }
  .proof-video-facade img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .proof-play { position:relative; z-index:1; min-height:48px; padding:12px 24px; border:1px solid #42BAEB; border-radius:12px; background:#102641; color:#f6fbff; font:700 14px/1.6 Arial,sans-serif; cursor:pointer; }
  .proof-media-nojs { position:absolute; inset-inline:16px; bottom:16px; display:flex; justify-content:center; flex-wrap:wrap; gap:16px; margin:0; }
  .proof-media-nojs a { display:inline-flex; align-items:center; min-height:44px; padding:8px 16px; background:#102641; color:#f6fbff; border:1px solid #42BAEB; border-radius:10px; text-decoration:underline; }
  .proof-media-caption { display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:16px; color:var(--proof-muted); font-size:14px; line-height:1.6; }
  .proof-media-caption a { color:var(--proof-ink); text-decoration:underline; text-underline-offset:4px; min-height:44px; display:inline-flex; align-items:center; }
  .proof-video-selectors { list-style:none; padding:0; margin:20px 0 0; display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px; }
  .proof-video-selectors button { width:100%; min-width:0; min-height:56px; display:flex; align-items:center; justify-content:center; gap:12px; border:1px solid #bfcede; border-radius:10px; padding:10px; background:#f5f9fc; color:var(--proof-ink); font:700 14px/1.6 Arial,sans-serif; overflow-wrap:anywhere; cursor:pointer; }
  .proof-video-selectors button > span { min-width:0; max-width:100%; }
  .proof-video-selectors button:disabled { color:var(--proof-muted); opacity:1; cursor:default; }
  .proof-video-selectors button[aria-pressed="true"] { border-color:#4071B5; background:#e9f3fb; box-shadow:inset 0 -2px #4071B5; }
  .proof-slot-state { font-size:12px; font-weight:400; }
  .proof-play:focus-visible,.proof-video-selectors button:focus-visible,.proof-video:focus-visible,.proof-media-caption a:focus-visible { outline:3px solid #4071B5; outline-offset:4px; }
  .proof-play:focus-visible { outline-color:#42BAEB; }
  .proof-media-nojs a:focus-visible { outline:3px solid #42BAEB; outline-offset:3px; }
  .proof-media-status { color:var(--proof-muted); font-size:14px; line-height:1.6; margin:16px 0 0; }
  .proof-media-status:empty { display:none; }
  .proof-text-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 56px; margin-top:40px; }
  .proof-text-slot { border:0; border-top:1px solid var(--proof-line); border-radius:0; background:transparent; padding:26px 0; margin:0; }
  .proof-text-slot h3 { color:var(--proof-ink); font-size:16px; font-weight:700; line-height:1.4; margin:0 0 12px; }
  .proof-text-slot p { color:var(--proof-muted); font-size:16px; line-height:1.7; margin:0; }
  .proof-text-slot blockquote { margin:0; padding:0; }
  .proof-text-slot blockquote p { font-size:20px; color:var(--proof-ink); line-height:1.6; }
  .proof-text-slot cite { display:block; margin-top:18px; color:var(--proof-muted); font-size:14px; line-height:1.6; font-style:normal; }
  @media(max-width:768px) { .proof-text-grid { grid-template-columns:1fr; margin-top:32px; } .proof-video-selectors { gap:8px; } .proof-video-selectors button { flex-direction:column; gap:0; padding:8px 4px; } }
  @media(max-width:480px) { .proof-media-frame { border-radius:14px; } .proof-media-pending { gap:8px; padding:16px; } .proof-media-pending p { font-size:14px; max-width:28ch; } .proof-media-caption { font-size:13px; } }
  @media(forced-colors:active) { :global(body.home-page) .client-proof { --proof-ink:CanvasText; --proof-muted:CanvasText; --proof-blue:LinkText; --proof-line:CanvasText; background:Canvas; } .proof-media-frame,.proof-video-selectors button,.proof-play { background:Canvas; color:CanvasText; border-color:CanvasText; } .proof-pending-label,.proof-media-pending p { color:CanvasText; } .proof-video-selectors button[aria-pressed="true"] { border-color:Highlight; } }
</style>
<script>
  import { initializeClientProof } from '../scripts/client-proof';
  initializeClientProof(document);
  document.addEventListener('astro:page-load',()=>initializeClientProof(document));
</script>
