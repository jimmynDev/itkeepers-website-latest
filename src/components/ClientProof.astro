---
import {videoTestimonials,textTestimonials,videoReady,quoteReady,approvedAttribution} from '../data/client-proof';
const available=videoTestimonials.filter(videoReady);
const quotes=textTestimonials.filter(quoteReady);
const active=available[0];
const mediaConfig=JSON.stringify(available).replace(/</g,'\\u003c');
---
{(active || quotes.length > 0) && <section class="client-proof" id="client-proof" aria-labelledby="client-proof-title" data-client-proof>
  <div class="client-proof-inner home-review-container">
    <header class="client-proof-heading"><p class="client-proof-eyebrow">WHAT CLIENTS SAY</p><h2 id="client-proof-title">Clients, in their words.</h2></header>
    {quotes.length > 0 && <div class="proof-carousel" role="region" aria-roledescription="carousel" aria-label="Client testimonials" data-proof-carousel>
      <div class="proof-stage" id="client-proof-quotes" aria-live="off" data-proof-stage>
        {quotes.map((item,index)=><blockquote class="proof-slide" role="group" aria-roledescription="slide" aria-label={`Testimonial ${index+1} of ${quotes.length}`} aria-hidden={index!==0} inert={index!==0} data-proof-slide={index}>
          <p>{item.quote}</p>{approvedAttribution(item) && <cite>{approvedAttribution(item)}</cite>}
        </blockquote>)}
      </div>
      {quotes.length > 1 && <div class="proof-control-area">
        <div class="proof-navigation" data-proof-navigation hidden>
          <div class="proof-arrows">
            <button class="proof-arrow" type="button" aria-label="Previous testimonial" aria-describedby="client-proof-navigation-help" aria-controls="client-proof-quotes" data-proof-previous><span aria-hidden="true">←</span></button>
            <button class="proof-arrow" type="button" aria-label="Next testimonial" aria-describedby="client-proof-navigation-help" aria-controls="client-proof-quotes" data-proof-next><span aria-hidden="true">→</span></button>
          </div>
          <div class="proof-dots" role="group" aria-label="Choose a testimonial">
            {quotes.map((item,index)=><button class="proof-dot" type="button" aria-label={`Show testimonial ${index+1}${approvedAttribution(item)?`: ${approvedAttribution(item)}`:''}`} aria-describedby="client-proof-navigation-help" aria-current={index===0?'true':undefined} aria-controls="client-proof-quotes" data-proof-dot={index}><span aria-hidden="true"></span></button>)}
          </div>
        </div>
      </div>}
      {quotes.length > 1 && <p class="proof-quote-status" id="client-proof-navigation-help">Use an arrow or dot to stop automatic rotation and choose a testimonial.</p>}
      <p class="proof-quote-status" role="status" aria-live="polite" aria-atomic="true" data-proof-quote-status></p>
    </div>}
    {active && <figure class="client-proof-media">
      <div class="proof-media-frame" id="client-proof-media">
        <div class="proof-video-facade" data-proof-facade><img src={active.poster} alt="" width="1280" height="720" loading="lazy" decoding="async" data-proof-poster/><button type="button" class="proof-play" data-proof-play hidden>Play testimonial</button></div>
        <video class="proof-video" controls playsinline preload="none" poster={active.poster} aria-label={active.label} data-proof-video hidden></video>
        <noscript><p class="proof-media-nojs"><a href={active.sources[0].src}>Watch testimonial</a><a href={active.transcript}>Read transcript</a></p></noscript>
      </div>
      <figcaption class="proof-media-caption"><span data-proof-video-label>{active.label}</span><a href={active.transcript} data-proof-transcript>Read transcript</a></figcaption>
      {available.length > 1 && <ul class="proof-video-selectors" aria-label="Video testimonials">
        {available.map(item=><li><button type="button" data-proof-select={item.id} aria-pressed={item.id===active.id} aria-controls="client-proof-media"><span>{item.label}</span></button></li>)}
      </ul>}
      <p class="proof-media-status" data-proof-status role="status" aria-live="polite"></p>
    </figure>}
    {active && <script type="application/json" data-proof-config set:html={mediaConfig}></script>}
  </div>
</section>}
<style>
  .client-proof { --proof-ink:var(--itk-text); --proof-muted:var(--itk-supporting-text,#B8C4D6); --proof-blue:var(--itk-cyan-sky); color:var(--proof-ink); background:var(--itk-bg); scroll-margin-block-start:140px; }
  .client-proof :is(h2,p,cite,button) { overflow-wrap:anywhere; }
  .client-proof-heading { display:block; height:auto; padding:0; border:0; margin:0 0 36px; background:transparent; text-align:center; }
  .client-proof-eyebrow { color:var(--proof-blue); font-size:var(--itk-label); font-weight:600; letter-spacing:var(--itk-label-tracking); line-height:1.5; margin:0 0 14px; }
  #client-proof-title { font-size:var(--itk-heading); line-height:1.12; font-weight:600; letter-spacing:-.035em; color:#fff; margin:0; text-wrap:balance; scroll-margin-block-start:180px; }
  .proof-carousel { max-inline-size:900px; margin-inline:auto; text-align:center; }
  /* Invisible slides still size this single shared track to its longest quote. */
  .proof-stage { display:grid; min-block-size:260px; }
  .proof-slide { grid-area:1 / 1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24px; min-inline-size:0; margin:0; padding:0; border:0; background:transparent; visibility:hidden; opacity:0; pointer-events:none; }
  .proof-slide[aria-hidden="false"] { visibility:visible; opacity:1; pointer-events:auto; }
  .proof-slide p { max-inline-size:48ch; color:#fff; font-size:clamp(26px,2.1vw,30px); line-height:1.5; white-space:pre-wrap; margin:0; }
  .proof-slide cite { color:var(--proof-muted); font-size:16px; line-height:1.6; font-style:normal; }
  .proof-stage[data-phase="out"] .proof-slide[aria-hidden="false"],.proof-stage[data-phase="in"] .proof-slide[aria-hidden="false"] { opacity:0; }
  .proof-control-area { min-block-size:100px; margin-block-start:28px; }
  .proof-navigation { display:flex; flex-direction:column; align-items:center; gap:8px; }
  .proof-navigation[hidden] { display:none; }
  .proof-arrows,.proof-dots { display:flex; align-items:center; justify-content:center; }
  .proof-arrows { gap:16px; }
  .proof-arrow { inline-size:48px; block-size:48px; display:grid; place-items:center; padding:0; border:0; border-radius:50%; background:#14283f; color:var(--itk-cyan-sky); font:26px/1 var(--font-editorial,Arial,sans-serif); cursor:pointer; }
  .proof-arrow:hover { background:var(--itk-brand-cyan); color:var(--itk-bg); }
  .proof-dot { inline-size:44px; block-size:44px; display:grid; place-items:center; border:0; padding:0; background:transparent; cursor:pointer; }
  .proof-dot span { inline-size:8px; block-size:8px; border-radius:50%; background:var(--proof-muted); }
  .proof-dot[aria-current="true"] span { inline-size:10px; block-size:10px; background:var(--itk-brand-cyan); }
  .proof-arrow:focus-visible,.proof-dot:focus-visible { outline:3px solid var(--itk-brand-cyan); outline-offset:3px; border-radius:50%; }
  .proof-quote-status { position:absolute; inline-size:1px; block-size:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .client-proof-media { max-inline-size:1000px; margin:0; }
  .proof-carousel + .client-proof-media { margin-block-start:32px; }
  .proof-media-frame { aspect-ratio:16/9; position:relative; display:grid; overflow:hidden; border:1px solid #335778; border-radius:var(--itk-radius-lg); background:#102641; color:#f6fbff; }
  .proof-video-facade,.proof-video { width:100%; height:100%; position:absolute; inset:0; object-fit:contain; }
  .proof-video-facade { display:grid; place-items:center; }
  .proof-video-facade[hidden],.proof-video[hidden],.proof-play[hidden] { display:none; }
  .proof-video-facade img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .proof-play { position:relative; z-index:1; min-height:48px; padding:12px 24px; border:1px solid var(--itk-brand-cyan); border-radius:var(--itk-radius-sm); background:#102641; color:#f6fbff; font:700 14px/1.6 Arial,sans-serif; cursor:pointer; }
  .proof-media-nojs { position:absolute; inset-inline:16px; bottom:16px; display:flex; justify-content:center; flex-wrap:wrap; gap:16px; margin:0; }
  .proof-media-nojs a { display:inline-flex; align-items:center; min-height:44px; padding:8px 16px; background:#102641; color:#f6fbff; border:1px solid var(--itk-brand-cyan); border-radius:var(--itk-radius-sm); text-decoration:underline; }
  .proof-media-caption { display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:16px; color:var(--proof-muted); font-size:14px; line-height:1.6; }
  .proof-media-caption a { color:var(--proof-ink); text-decoration:underline; text-underline-offset:4px; min-height:44px; display:inline-flex; align-items:center; }
  .proof-video-selectors { list-style:none; padding:0; margin:20px 0 0; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,140px),1fr)); gap:12px; }
  .proof-video-selectors button { width:100%; min-width:0; min-height:56px; display:flex; align-items:center; justify-content:center; border:1px solid var(--itk-cyan-sky); border-radius:var(--itk-radius-sm); padding:10px; background:var(--itk-surface); color:var(--proof-ink); font:700 14px/1.6 Arial,sans-serif; cursor:pointer; }
  .proof-video-selectors button > span { min-width:0; max-width:100%; }
  .proof-video-selectors button[aria-pressed="true"] { box-shadow:inset 0 -2px var(--itk-cyan-sky); }
  .proof-play:focus-visible,.proof-video-selectors button:focus-visible,.proof-video:focus-visible,.proof-media-caption a:focus-visible,.proof-media-nojs a:focus-visible { outline:3px solid var(--itk-brand-cyan); outline-offset:4px; }
  .proof-media-status { color:var(--proof-muted); font-size:14px; line-height:1.6; margin:16px 0 0; }
  .proof-media-status:empty { display:none; }
  @media(max-width:767px) { .proof-slide p { font-size:clamp(20px,5.8vw,22px); } .proof-stage { min-block-size:0; } }
  @media(prefers-reduced-motion:no-preference) { .proof-slide { transition:opacity 175ms ease; } }
  @media(max-width:480px) { .proof-media-frame { border-radius:var(--itk-radius-md); } }
  @media(forced-colors:active) { .client-proof { --proof-ink:CanvasText; --proof-muted:CanvasText; --proof-blue:LinkText; background:Canvas; } .proof-media-frame,.proof-video-selectors button,.proof-play,.proof-media-nojs a,.proof-arrow { background:Canvas; color:CanvasText; border-color:CanvasText; box-shadow:none; } #client-proof-title,.proof-slide p { color:CanvasText; } .proof-dot span { background:CanvasText; } .proof-dot[aria-current="true"] span { background:Highlight; } .proof-video-selectors button[aria-pressed="true"] { border-color:Highlight; } }
</style>
<script>
  import { initializeClientProof } from '../scripts/client-proof';
  import { initializeClientProofCarousel } from '../scripts/client-proof-carousel';
  initializeClientProof(document);
  initializeClientProofCarousel(document);
  document.addEventListener('astro:page-load',()=>{initializeClientProof(document);initializeClientProofCarousel(document);});
</script>
