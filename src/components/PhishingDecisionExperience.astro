---
import { phishingScenarios } from '../data/phishing-scenarios';
const { id = 'phishing-decisions' } = Astro.props;
---
<section class="phishing-decisions" id={id} aria-labelledby={`${id}-title`} data-phishing-experience>
  <div class="decision-inner">
    <div class="decision-heading">
      <p class="decision-eyebrow">TRY IT YOURSELF</p>
      <h2 id={`${id}-title`}>What would you do?</h2>
      <p class="decision-intro">Four everyday messages. No technical knowledge needed — choose what feels natural and see what ITKeepers would check next.</p>
    </div>
    <div class="decision-stage">
      <div class="decision-progress" data-decision-progress hidden>
        <span data-decision-count aria-label="Message 1 of 4">01 / 04</span>
        <div class="decision-segments" aria-hidden="true">{phishingScenarios.map((_, index) => <span data-decision-segment data-active={index === 0 ? 'true' : 'false'}></span>)}</div>
      </div>
      <div class="decision-body">
        <div class="decision-panel decision-fallback" data-decision-fallback>
          <h3>Pause. Check the context. Involve your team.</h3>
          <p>A familiar sender name is not enough to verify a request. Check unexpected sign-ins, payment changes and file shares through a known communication channel, and involve IT when you are unsure.</p>
          <p>You don’t need to become the IT expert. You need a team that knows what to check.</p>
        </div>
        {phishingScenarios.map((scenario, index) => <>
          <div class="decision-panel" data-decision-scenario={index} hidden inert aria-labelledby={`${id}-${scenario.id}-title`}>
            <div class="decision-message">
              <p class="decision-sender">{scenario.sender}<span class="decision-address">{scenario.address}</span></p>
              <h3 id={`${id}-${scenario.id}-title`} data-decision-heading tabindex="-1">{scenario.subject}</h3>
              <p>{scenario.body}</p>
            </div>
            <fieldset class="decision-choices"><legend>What would you do?</legend>
              {scenario.options.map(option => <button type="button" data-decision-option={option.id} aria-pressed="false" aria-controls={`${id}-${scenario.id}-${option.id}`}>{option.label}</button>)}
            </fieldset>
          </div>
          {scenario.options.map(option => <div class="decision-panel decision-explanation" id={`${id}-${scenario.id}-${option.id}`} data-decision-explanation={option.id} data-decision-index={index} hidden inert aria-labelledby={`${id}-${scenario.id}-${option.id}-title`}>
            <p class="decision-eyebrow">ITKEEPERS VIEW</p>
            <h3 id={`${id}-${scenario.id}-${option.id}-title`}>{option.response}</h3>
            <dl class="decision-checks">{scenario.checks.map(check => <div><dt>{check.label}</dt><dd>{check.detail}</dd></div>)}</dl>
            <p data-decision-feedback>{option.explanation}</p>
            <div class="decision-navigation"><button type="button" class="decision-next" data-decision-next>Continue</button></div>
          </div>)}
        </>)}
        <div class="decision-panel decision-final" data-decision-final hidden inert>
          <p class="decision-eyebrow">THE TAKEAWAY</p>
          <h3 data-decision-heading tabindex="-1">You shouldn’t have to investigate every suspicious message yourself.</h3>
          <p>Knowing when to pause matters. Having an IT team that can verify the context matters more.</p>
          <p class="decision-positioning">Your IT person is a team.</p>
          <div class="decision-navigation"><button type="button" class="decision-restart" data-decision-restart>Try the messages again</button></div>
        </div>
      </div>
    </div>
    <p class="decision-note"><span class="illustrative-badge">Illustrative</span> Fictional messages, people and businesses.</p>
    <p class="decision-announcement" data-decision-announcement role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</section>
<noscript><style is:inline>.phishing-decisions .decision-panel[hidden], .phishing-decisions .decision-progress { display:none; } .phishing-decisions .decision-stage { min-block-size:0; }</style></noscript>
<style>
  :global(body.home-page) .phishing-decisions { --decision-bg:var(--itk-bg); --decision-surface:var(--itk-surface-raised); --decision-ink:var(--itk-text); --decision-muted:var(--itk-muted); --decision-accent:var(--itk-brand-cyan); color:var(--decision-ink); background:var(--decision-bg); padding-block:var(--itk-section-space); }
  .decision-inner { max-inline-size:1000px; margin-inline:auto; }
  .phishing-decisions :is(h2,h3,p,dd,dt,button,span) { overflow-wrap:anywhere; }
  .decision-heading { max-inline-size:740px; margin-block-end:32px; }
  .phishing-decisions .decision-eyebrow { color:var(--decision-accent); font-size:var(--itk-label); font-weight:700; letter-spacing:var(--itk-label-tracking); margin:0; }
  .decision-heading .decision-eyebrow { margin-block-end:20px; }
  .decision-heading h2 { color:inherit; font-size:clamp(36px,3.8vw,56px); font-weight:600; line-height:1.08; letter-spacing:-.04em; margin:0 0 20px; }
  .phishing-decisions p { color:var(--decision-muted); font-size:var(--itk-body); line-height:1.6; margin:0; }
  .decision-stage { display:flex; flex-direction:column; gap:28px; min-block-size:600px; padding:32px; border:1px solid var(--itk-border-strong); border-radius:var(--itk-radius-lg); background:radial-gradient(ellipse at 85% 8%,rgba(66,186,235,.06),transparent 55%),var(--decision-surface); box-shadow:0 14px 36px -28px rgba(0,0,0,.55),inset 0 1px 0 rgba(66,186,235,.06); }
  .decision-progress { display:flex; align-items:center; gap:24px; color:var(--decision-accent); font:600 12px/1.5 var(--font-mono,monospace); letter-spacing:.04em; }
  .decision-progress[hidden] { display:flex; visibility:hidden; }
  .decision-segments { display:flex; gap:8px; flex:1; max-inline-size:180px; }
  .decision-segments span { flex:1; block-size:3px; background:var(--itk-border-strong); border-radius:2px; }
  .decision-segments [data-active="true"] { background:linear-gradient(90deg,var(--itk-brand-deep),var(--decision-accent)); }
  /* All screens share a grid cell and reserve the tallest intrinsic content.
     Inactive screens keep layout space, but are invisible, inert and hidden to AT. */
  .decision-body { display:grid; flex:1; min-inline-size:0; }
  .decision-panel,.decision-panel[hidden] { grid-area:1 / 1; display:flex; flex-direction:column; gap:24px; min-inline-size:0; margin:0; padding:0; border:0; }
  .decision-panel[hidden] { visibility:hidden; pointer-events:none; }
  .decision-panel[aria-hidden="true"] { pointer-events:none; }
  .phishing-decisions .decision-panel h3 { color:var(--decision-ink); font-size:clamp(22px,2.2vw,28px); font-weight:600; line-height:1.25; letter-spacing:-.025em; margin:0; }
  .decision-message { padding-block-end:24px; border-block-end:1px solid var(--itk-border); }
  .phishing-decisions .decision-sender { color:var(--decision-ink); margin-block-end:20px; }
  .decision-address { display:block; font-size:12px; color:var(--decision-muted); margin-block-start:2px; }
  .decision-message h3 { margin-block-end:16px !important; }
  .decision-choices { display:grid; grid-template-columns:1fr; gap:10px; border:0; min-inline-size:0; padding:0; margin: auto 0 0; }
  .decision-choices legend { color:var(--decision-ink); font-size:16px; font-weight:600; line-height:1.5; padding:0; margin-block-end:16px; }
  .phishing-decisions button { min-block-size:48px; padding:12px 18px; border:1px solid rgba(66,186,235,.6); border-radius:var(--itk-radius-sm); color:var(--decision-ink); background:rgba(64,113,181,.08); font:600 14px/1.5 var(--font-editorial,system-ui,sans-serif); text-align:start; cursor:pointer; touch-action:manipulation; transition:background 240ms ease-out,border-color 240ms ease-out; }
  .decision-choices button { inline-size:100%; }
  .phishing-decisions button:hover,.decision-choices button[aria-pressed="true"] { border-color:var(--decision-accent); background:rgba(64,113,181,.2); }
  .decision-checks { display:grid; gap:20px; margin:0; padding-inline-start:18px; border-inline-start:2px solid var(--decision-accent); }
  .decision-checks dt { font-size:16px; font-weight:600; color:var(--decision-accent); margin-block-end:4px; }
  .decision-checks dd { margin:0; color:var(--decision-muted); font-size:16px; line-height:1.6; }
  .decision-navigation { display:flex; justify-content:flex-end; margin-block-start:auto; padding-block-start:8px; }
  .phishing-decisions .decision-next { color:var(--decision-bg); background:var(--decision-accent); border-color:var(--decision-accent); padding-inline:26px; }
  .phishing-decisions .decision-next:hover { background:color-mix(in srgb,var(--decision-accent) 88%,white); }
  .phishing-decisions .decision-final h3 { font-size:clamp(28px,3vw,38px); max-inline-size:700px; }
  .phishing-decisions .decision-positioning { color:var(--decision-ink); font-weight:700; }
  .phishing-decisions .decision-restart { color:var(--decision-accent); background:transparent; }
  .decision-note { display:flex; flex-wrap:wrap; gap:10px; align-items:center; padding-block-start:20px; }
  .phishing-decisions .decision-note { font-size:12px; }
  .phishing-decisions :is(button,[tabindex="-1"]):focus-visible { outline:3px solid var(--decision-accent); outline-offset:4px; }
  .decision-announcement { position:absolute; inline-size:1px; block-size:1px; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  @media(max-width:600px) { .decision-stage { min-block-size:660px; padding:20px; gap:24px; } .decision-panel,.decision-panel[hidden] { gap:20px; } .decision-progress { gap:16px; } }
  @media(prefers-reduced-motion:reduce) { .phishing-decisions button { transition:none; } }
  @media(forced-colors:active) { :global(body.home-page) .phishing-decisions { --decision-bg:Canvas; --decision-surface:Canvas; --decision-ink:CanvasText; --decision-muted:CanvasText; --decision-accent:LinkText; } .decision-stage,.phishing-decisions button { border-color:CanvasText; } .decision-segments [data-active="true"] { background:Highlight; } .phishing-decisions :is(button,[tabindex="-1"]):focus-visible { outline-color:Highlight; } }
</style>
<script>
  import { initializePhishingExperiences } from '../scripts/phishing-decision-experience';
  initializePhishingExperiences(document);
  document.addEventListener('astro:page-load', () => initializePhishingExperiences(document));
</script>
