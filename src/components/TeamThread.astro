---
const chapters = [
  ['A familiar starting point.', 'In this example, a familiar engineer is the starting point. The people and the question come first.', 'Familiar engineer'],
  ['The context travels.', 'In this illustrative example, notes about the environment and the open question travel with the work.', 'Shared context'],
  ['One person. Wider expertise.', 'A colleague can join the investigation with the same context, rather than starting the conversation again.', 'Wider expertise'],
  ['The thread comes back to you.', 'The example ends with the action and what to check next. Follow-up is part of the story.', 'Follow-up']
];
---
<section class="team-thread" aria-labelledby="thread-title">
  <div class="thread-intro"><p class="eyebrow">Your IT person is a team.</p><h2 id="thread-title">One conversation.<br />A thread that stays connected.</h2><p>A working relationship, illustrated in four parts.</p><span class="thread-badge">Illustrative</span></div>
  <div class="thread-layout">
    <div class="thread-visual">
      <button class="thread-motion" type="button" hidden aria-pressed="false">Pause scroll animation</button>
      <div class="thread-board" aria-hidden="true">
                <div class="thread-schematic-label"><span>ITKEEPERS / THE CONTEXT THREAD</span><span>01—04</span></div>
        <svg class="thread-line" viewBox="0 0 600 420" preserveAspectRatio="none" focusable="false" aria-hidden="true"><path class="thread-trace-base" d="M80 110 H500 V320 H80" /><path class="thread-trace-draw" pathLength="1" d="M80 110 H500 V320 H80" /><circle cx="80" cy="110" r="5"/><circle cx="500" cy="110" r="5"/><circle cx="500" cy="320" r="5"/><circle cx="80" cy="320" r="5"/></svg>
        <div class="thread-node thread-person"><span class="thread-index">01 / RELATIONSHIP</span><strong>Your familiar<br />engineer</strong><span class="thread-caption">The conversation starts here</span></div>
        <div class="thread-node thread-context"><span class="thread-index">02 / CONTEXT PACKET</span><strong>Shared context</strong><div class="thread-packet"><div class="thread-paper"><span><i>ENV</i> Environment notes</span><span><i>ASK</i> The open question</span><span><i>NEXT</i> What happens next</span></div></div></div>
        <div class="thread-node thread-colleague"><span class="thread-index">03 / COLLABORATION</span><strong>A colleague's<br />expertise</strong><span class="thread-caption">The same thread, a wider view</span></div>
        <div class="thread-node thread-follow"><span class="thread-index">04 / CONTINUITY</span><strong>Back to you.</strong><span class="thread-caption">Action + follow-up</span></div>
      </div>
      <p class="thread-key">Familiar engineer → shared context → wider expertise → follow-up.</p>
    </div>
    <ol class="thread-chapters">
      {chapters.map(([heading, text, label], index) => <li data-thread-chapter><p class="eyebrow">0{index + 1} / {label}</p><h3>{heading}</h3><p>{text}</p></li>)}
    </ol>
  </div>
</section>
<style>
  .team-thread { --technical-font: ui-monospace, SFMono-Regular, Consolas, monospace; --bg: var(--surface-light); --fg: var(--i); --muted: var(--text-light-muted); --accent: var(--accent-light); --focus: var(--n); padding-block: clamp(80px, 10vw, 144px); }
  .team-thread .eyebrow { font-size: 12px; }
  .thread-intro { max-inline-size: 940px; margin-block-end: clamp(56px, 7vw, 104px); }
  .thread-intro h2 { font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif; font-size: clamp(38px, 6vw, 86px); line-height: 1.02; letter-spacing: -.055em; text-wrap: balance; }
  .thread-intro > p:not(.eyebrow) { font-size: clamp(18px, 2vw, 22px); line-height: 1.6; margin-block: 28px 20px; }
  .thread-intro > p:not(.eyebrow), .thread-chapters li > p:not(.eyebrow), .thread-key { color: var(--muted); }
  .thread-badge { display: inline-block; font-size: 12px; font-weight: 700; border: 1px solid var(--accent); border-radius: 3px; padding: 5px 12px; color: var(--accent); }
  .thread-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(32px, 6vw, 88px); align-items: start; }
  .thread-visual { min-inline-size: 0; }
  .thread-motion { font: inherit; font-size: 12px; color: var(--fg); background: transparent; border: 1px solid var(--accent); border-radius: 3px; padding: 10px 14px; margin-block-end: 18px; cursor: pointer; }
  .thread-motion[hidden] { display: none; }
  .thread-board { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 64px 36px; padding-block: 64px 28px; min-block-size: 420px; border-block: 1px solid var(--accent); }
  .thread-schematic-label { position: absolute; inset-block-start: 20px; inset-inline: 0; display: flex; justify-content: space-between; gap: 16px; font: 12px/1.5 var(--technical-font); letter-spacing: .06em; color: var(--accent); }
  .thread-line { position: absolute; inset: 32px 0 0; inline-size: 100%; block-size: calc(100% - 32px); overflow: visible; fill: var(--bg); stroke: var(--accent); stroke-width: 2; }
  .thread-line path { fill: none; vector-effect: non-scaling-stroke; }
  .thread-trace-base { stroke-dasharray: 2 7; }
  .thread-trace-draw { stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .thread-node { position: relative; padding: 0 12px 12px; background: var(--bg); border-inline-start: 2px solid var(--accent); min-inline-size: 0; }
  .thread-index { display: block; font: 12px/1.5 var(--technical-font); color: var(--accent); letter-spacing: .04em; margin-block-end: 18px; }
  .thread-node strong { display: block; font-size: clamp(23px, 2.5vw, 34px); line-height: 1.05; letter-spacing: -.04em; }
  .thread-caption { display: block; font-size: 12px; line-height: 1.5; color: var(--muted); margin-block-start: 12px; }
  .thread-packet { position: relative; margin-block-start: 22px; padding: 8px 0 0 8px; }
  .thread-packet::before { content: ''; position: absolute; inset: 0 8px 8px 0; border: 1px solid var(--accent); }
  .thread-paper i { font: normal 12px/1.5 var(--technical-font); display: block; color: var(--text-light-muted); margin-block-end: 3px; }
  .thread-paper { background: var(--text-light); color: var(--i); position: relative; padding: 16px; margin-block-start: 0; font-size: 12px; line-height: 1.5; }
  .thread-paper span { display: block; padding-block: 5px; border-block-end: 1px solid var(--text-light-muted); }
  .thread-paper span:last-child { border: 0; }
  .thread-follow { grid-column: 1; grid-row: 2; }
  .thread-colleague { grid-column: 2; grid-row: 2; }
  .thread-key { font-size: 12px; line-height: 1.7; max-inline-size: 52ch; }
  .thread-chapters { list-style: none; padding: 0; margin: 0; }
  .thread-chapters li { padding-block: 24px 56px; border-block-start: 1px solid var(--accent); }
  .thread-chapters h3 { font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif; font-size: clamp(30px, 3.5vw, 48px); line-height: 1.04; letter-spacing: -.045em; text-wrap: balance; }
  .thread-chapters li > p:not(.eyebrow) { font-size: 18px; line-height: 1.65; max-inline-size: 42ch; }
  @media (min-width: 901px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .team-thread[data-layout] .thread-visual { position: sticky; top: 36px; }
    .team-thread[data-layout] .thread-chapters li { min-block-size: 62vh; }
    .team-thread[data-animated] .thread-context { transform: translateY(calc((1 - var(--context, 1)) * 16px)); }
    .team-thread[data-animated] .thread-colleague { transform: translateX(calc((1 - var(--expertise, 1)) * 32px)); }
    .team-thread[data-animated] .thread-follow { transform: translateY(calc((1 - var(--follow, 1)) * 28px)); }
    .team-thread[data-animated] .thread-packet { transform: translateY(calc((1 - var(--context, 1)) * 16px)) rotate(calc((1 - var(--context, 1)) * -4deg)); transform-origin: bottom left; }
    .team-thread[data-animated] .thread-trace-draw { stroke-dashoffset: calc(1 - var(--thread, 1)); }

  }
  @media (min-width: 901px) and (max-height: 850px) {
    .thread-board { gap: 44px 28px; padding-block: 54px 24px; }
    .thread-node strong { font-size: 26px; }
    .thread-index { margin-block-end: 12px; }
    .thread-packet { margin-block-start: 16px; }
    .thread-paper { padding: 12px; }
  }
  @media (max-width: 900px) { .thread-layout { grid-template-columns: 1fr; } .thread-intro { margin-block-end: 32px; } .thread-chapters li { padding-block-end: 28px; } }
  @media (max-width: 400px) { .thread-board { gap: 52px 16px; } .thread-node { padding: 12px 6px; } .thread-node strong { font-size: 21px; } }
  @media (forced-colors: active) { .thread-node, .thread-paper, .thread-packet::before { border-color: CanvasText; } .thread-line { stroke: CanvasText; } }
</style>
<script>
  const root = document.querySelector<HTMLElement>('.team-thread');
  if (root && 'IntersectionObserver' in window && 'ResizeObserver' in window) {
    const button = root.querySelector<HTMLButtonElement>('.thread-motion')!;
    const chapters = Array.from(root.querySelectorAll<HTMLElement>('[data-thread-chapter]'));
    const suitable = matchMedia('(min-width: 901px) and (min-height: 700px) and (prefers-reduced-motion: no-preference)');
    const visual = root.querySelector<HTMLElement>('.thread-visual')!;
    let paused = false;
    let fits = false;
    let visible = false;
    let frame = 0;
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const ease = (n: number) => n * n * (3 - 2 * n);
    const draw = () => {
      frame = 0;
      if (!visible || paused || !suitable.matches || !fits) return;
      const progress = chapters.map(chapter => clamp((innerHeight * .75 - chapter.getBoundingClientRect().top) / (innerHeight * .55)));
      root.style.setProperty('--context', String(ease(progress[1])));
      root.style.setProperty('--expertise', String(ease(progress[2])));
      root.style.setProperty('--follow', String(ease(progress[3])));
      root.style.setProperty('--thread', String((progress[1] + progress[2] + progress[3]) / 3));
    };
    const schedule = () => { if (!frame && visible && !paused && suitable.matches && fits) frame = requestAnimationFrame(draw); };
    const configure = () => {
      button.hidden = false;
      fits = visual.scrollHeight <= innerHeight - 72;
      const layout = suitable.matches && fits;
      root.toggleAttribute('data-layout', layout);
      const animated = layout && !paused;
      root.toggleAttribute('data-animated', animated);
      button.hidden = !layout;
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused ? 'Resume scroll animation' : 'Pause scroll animation';
      schedule();
    };
    button.addEventListener('click', () => { paused = !paused; configure(); });
    suitable.addEventListener('change', configure);
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', configure, { passive: true });
    if ('IntersectionObserver' in window && 'ResizeObserver' in window) {
      const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; schedule(); });
      observer.observe(root);
      const sizeObserver = new ResizeObserver(configure);
      sizeObserver.observe(visual);
      configure();
    }
  }
</script>








