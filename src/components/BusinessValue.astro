---
const circles = [
  {
    id: 'future',
    eyebrow: 'ITKeepers · Lebanon',
    top: 'Built for',
    accent: "what's next.",
    subheading: 'Managed Service Provider',
  },
  {
    id: 'monitoring',
    eyebrow: 'Proactive Operations',
    top: '',
    accent: '24/7',
    subheading: 'Automated Monitoring',
  },
  {
    id: 'ownership',
    eyebrow: 'Client Ownership',
    top: 'Your data.',
    accent: 'Your control.',
    subheading: 'Your business stays yours',
  },
];
const services = ['Managed IT', 'Security', 'Cloud', 'Infrastructure', 'AI', 'Web'];
---
<section class="business-value" id="business-value" aria-labelledby="business-value-title">
  <div class="business-inner">
    <h2 id="business-value-title" class="business-sr-only">ITKeepers: Managed Services and Client Commitments</h2>

    <div class="business-circles">
      {circles.map((circle) => (
        <article class="business-circle" data-orbit-stage aria-label={circle.eyebrow}>
          <svg class="business-ring" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <filter id={'business-trail-glow-' + circle.id} x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3" />
              </filter>
              <filter id={'business-dot-glow-' + circle.id} x="-200%" y="-200%" width="500%" height="500%">
                <feGaussianBlur stdDeviation="5" />
              </filter>
            </defs>
            <circle class="business-outer-track" cx="200" cy="200" r="199" />
            <circle class="business-full-ring" cx="200" cy="200" r="194" />
            <g class="business-orbit">
              <g class="business-trail-glow" data-trail-glow filter={'url(#business-trail-glow-' + circle.id + ')'}></g>
              <g data-trail></g>
              <circle class="business-dot-halo" cx="200" cy="6" r="8" filter={'url(#business-dot-glow-' + circle.id + ')'} />
              <circle class="business-dot" cx="200" cy="6" r="4.5" />
              <circle class="business-dot-highlight" cx="199.2" cy="4.9" r="1.5" />
            </g>
          </svg>
          <div class="business-circle-copy">
            <p class="business-circle-eyebrow">{circle.eyebrow}</p>
            <h3 class="business-circle-heading">
              <span class="business-circle-top" aria-hidden={!circle.top ? 'true' : undefined}>{circle.top || '\u00a0'}</span>
              <strong>{circle.accent}</strong>
            </h3>
            <p class="business-circle-subheading">{circle.subheading}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="business-services" aria-label="ITKeepers service areas">
      <ul class="business-service-line" aria-label="Services">
        {services.map((service, index) => (
          <li class="business-service-word" style={'--reveal-delay:' + (70 + index * 130) + 'ms'}>{service}</li>
        ))}
      </ul>
      <p class="business-payoff">All under one roof.</p>
    </div>
  </div>
</section>

<style>
  .business-value {
    --business-accent: #38bdf8;
    --business-accent-bright: var(--business-accent);
    --business-ring-color: var(--business-accent);
    background: var(--itk-bg);
    color: var(--itk-text);
    padding-block: var(--chapter-space, 64px) var(--chapter-gap, 32px);
    scroll-margin-block-start: 140px;
    text-align: center;
  }
  .business-inner {
    max-width: 1240px;
    min-width: 0;
    padding-inline: clamp(16px, 2vw, 24px);
    margin-inline: auto;
  }
  .business-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .business-circles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: center;
    align-items: center;
    gap: clamp(14px, 2.5vw, 40px);
    max-width: 100%;
    margin-inline: auto;
  }
  .business-circle {
    position: relative;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    width: min(100%, 362px);
    aspect-ratio: 1;
    container-type: inline-size;
    isolation: isolate;
    min-width: 0;
  }
  .business-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .business-outer-track { fill: none; stroke: #2b3140; stroke-width: .8px; opacity: .6; }
  .business-full-ring { fill: none; stroke: var(--business-ring-color); stroke-width: 1.5px; opacity: .68; }
  .business-orbit {
    transform-origin: 200px 200px;
    animation: business-circle-orbit 13s linear infinite;
    will-change: transform;
  }
  .business-circle:nth-child(2) .business-orbit { animation-delay: -4s; }
  .business-circle:nth-child(3) .business-orbit { animation-delay: -8s; }
  .business-value.is-orbit-ready .business-orbit { animation-play-state: paused; }
  .business-value.is-orbit-ready .business-circle.is-orbit-active .business-orbit { animation-play-state: running; }
  .business-trail-glow { opacity: .6; }
  .business-value :global(.business-trail-segment) {
    fill: none;
    stroke: var(--business-accent-bright);
    stroke-linecap: round;
  }
  .business-dot-halo { fill: var(--business-accent); opacity: .55; }
  .business-dot { fill: var(--business-accent-bright); }
  .business-dot-highlight { fill: var(--business-accent); opacity: .75; }
  @keyframes business-circle-orbit {
    from { transform: rotate(81deg); }
    to { transform: rotate(441deg); }
  }
  .business-circle-copy {
    position: absolute;
    inset: 0;
    --business-headline-size: clamp(25px, 11cqw, 43px);
    display: grid;
    grid-template-rows: 1.3em calc(var(--business-headline-size) * 2.2) 1.4em;
    row-gap: clamp(8px, 2.2cqw, 10px);
    font-size: 16px;
    align-items: center;
    align-content: center;
    justify-items: center;
    padding-inline: 6%;
    pointer-events: none;
  }
  .business-circle-eyebrow {
    margin: 0;
    color: #B8C4D6;
    font-size: 13px;
    font-weight: 750;
    letter-spacing: .08em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .business-circle-heading {
    display: grid;
    grid-template-rows: repeat(2, 1.1em);
    margin: 0;
    color: #f4f6f9;
    font-size: var(--business-headline-size);
    font-weight: 800;
    letter-spacing: -.038em;
    line-height: 1.1;
    white-space: nowrap;
  }
  .business-circle-top { display: block; }
  .business-circle-heading strong { color: var(--business-accent); font-weight: inherit; }
  .business-circle-subheading {
    margin: 0;
    color: #B8C4D6;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    white-space: nowrap;
  }

  .business-services {
    --business-service-ink: #ffffff;
    --business-service-cyan: var(--business-accent);
    --business-service-size: clamp(1.125rem, 2.16vw, 1.575rem);
    max-width: 100%;
    margin: clamp(64px, 5.6vw, 80px) auto 0;
    padding-inline: 0;
    text-align: center;
  }
  .business-service-line {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    color: var(--business-service-ink);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: var(--business-service-size);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: .01em;
    text-wrap: balance;
  }
  .business-service-word {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid color-mix(in srgb, var(--business-accent) 30%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--business-accent) 8%, transparent);
    box-shadow: none;
    cursor: default;
    white-space: nowrap;
  }
  .business-payoff {
    margin: 20px 0 0;
    color: var(--business-service-cyan);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: calc(var(--business-service-size) * .85);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: .01em;
  }
  /* An explicit light-surface variant; the current V2 business section stays
     dark in both hero theme modes, so it retains the white/cyan treatment. */
  .business-value[data-surface="light"] {
    --business-accent: #075d7d;
    background: #f5f9fc;
    color: #0b2c5f;
  }
  .business-value[data-surface="light"] .business-services {
    --business-service-ink: #0b2c5f;
    --business-service-cyan: var(--business-accent);
  }
  .business-value[data-surface="light"] .business-circle-eyebrow,
  .business-value[data-surface="light"] .business-circle-subheading {
    color: #42566f;
  }
  .business-value[data-surface="light"] .business-circle-heading { color: #0b2c5f; }
  /* Only opt into a hidden starting state after the observer is installed. */
  .business-value.is-motion-ready .business-service-word,
  .business-value.is-motion-ready .business-payoff {
    opacity: 0;
    transform: translateY(9px);
    transition: opacity 400ms ease, transform 460ms cubic-bezier(.18, .72, .25, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .business-value.is-motion-ready .business-payoff {
    transition-delay: 1150ms;
    transition-duration: 650ms;
  }
  .business-value.is-motion-ready .business-services.is-visible .business-service-word,
  .business-value.is-motion-ready .business-services.is-visible .business-payoff {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 900px) {
    .business-circles { gap: 12px; }
    .business-circle-copy { --business-headline-size: clamp(20px, 10cqw, 36px); font-size: 15px; }
    .business-circle-subheading { font-size: 15px; }
    .business-service-line { max-inline-size: 440px; }
  }
  @media (max-width: 700px) {
    .business-circles { grid-template-columns: 1fr; gap: 16px; }
    .business-circle { width: min(100%, 344px); }
    .business-circle-copy { --business-headline-size: clamp(25px, 11cqw, 42px); }
    .business-services { margin-top: 48px; }
  }
  @media (max-width: 767px) {
    .business-services { margin-top: 48px; }
  }
  @media (max-width: 600px) {
    .business-service-line { max-inline-size: 280px; }
  }
  @media (max-width: 420px) {
    .business-services { padding-inline: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .business-orbit { animation: none; transform: rotate(81deg); will-change: auto; }
    .business-trail-glow { opacity: .25; }
    .business-value.is-motion-ready .business-service-word,
    .business-value.is-motion-ready .business-payoff {
      opacity: 1; transform: none; transition: none;
    }
  }
  @media (forced-colors: active) {
    .business-value { background: Canvas; color: CanvasText; }
    .business-ring { forced-color-adjust: none; }
    .business-circle-eyebrow, .business-circle-heading, .business-circle-heading strong,
    .business-circle-subheading, .business-circle-subheading b,
    .business-service-line, .business-payoff {
      color: CanvasText;
    }
    .business-service-word { background: Canvas; color: CanvasText; border-color: CanvasText; }
  }
</style>

<script>
  const section = document.getElementById('business-value');
  if (section) {
    const ns = 'http://www.w3.org/2000/svg';
    const radius = 194;
    const tailLength = 100;
    const steps = 70;
    const pointAt = (degrees: number) => {
      const a = degrees * Math.PI / 180;
      return [200 + radius * Math.sin(a), 200 - radius * Math.cos(a)];
    };

    // Full rings are in the HTML; create only the orbiting fading trails.
    const stages = section.querySelectorAll<HTMLElement>('[data-orbit-stage]');
    for (const stage of stages) {
      const regular = stage.querySelector('[data-trail]');
      const glow = stage.querySelector('[data-trail-glow]');
      if (!regular || !glow) continue;
      for (let i = 0; i < steps; i++) {
        const from = -tailLength + i * tailLength / steps;
        const to = -tailLength + (i + 1) * tailLength / steps + .07;
        const [x1, y1] = pointAt(from);
        const [x2, y2] = pointAt(to);
        const progress = (i + .5) / steps;
        const alpha = Math.pow(progress, 1.85) * .99;
        const width = 1.5 + Math.pow(progress, 1.9) * 1.65;
        const arc = 'M ' + x1.toFixed(3) + ' ' + y1.toFixed(3) + ' A ' + radius + ' ' + radius +
          ' 0 0 1 ' + x2.toFixed(3) + ' ' + y2.toFixed(3);
        for (const [layer, isGlow] of [[glow, true], [regular, false]] as const) {
          const path = document.createElementNS(ns, 'path');
          path.setAttribute('d', arc);
          path.setAttribute('class', 'business-trail-segment');
          path.setAttribute('stroke-width', (width * (isGlow ? 2 : 1)).toFixed(2));
          path.setAttribute('opacity', (alpha * (isGlow ? .88 : 1)).toFixed(3));
          layer.appendChild(path);
        }
      }
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion && 'IntersectionObserver' in window) {
      const services = section.querySelector<HTMLElement>('.business-services');
      if (services) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              services.classList.add('is-visible');
              observer.disconnect();
            }
          }
        }, { threshold: .2 });
        revealObserver.observe(services);
        section.classList.add('is-motion-ready');
      }

      const orbitObserver = new IntersectionObserver(entries => {
        for (const entry of entries) {
          entry.target.classList.toggle('is-orbit-active', entry.isIntersecting);
        }
      });
      section.classList.add('is-orbit-ready');
      stages.forEach(stage => orbitObserver.observe(stage));
    }
  }
</script>
