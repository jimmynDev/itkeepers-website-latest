---
const cards = [
  { key:'familiar', title:'A familiar engineer', description:'Someone who understands your systems and business context.', icon:'M16 16a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM6 28v-3a10 10 0 0 1 20 0v3' },
  { key:'specialists', title:'Specialists behind them', description:'Deeper expertise moves inside our team, not back to you.', icon:'M16 7v5M7 23l6-6M25 23l-6-6M19 4a3 3 0 1 0-6 0 3 3 0 0 0 6 0ZM10 26a3 3 0 1 0-6 0 3 3 0 0 0 6 0ZM28 26a3 3 0 1 0-6 0 3 3 0 0 0 6 0ZM20 16a4 4 0 1 0-8 0 4 4 0 0 0 8 0Z' },
  { key:'development', title:'Expertise that evolves', description:'Continuous technical training, specialist courses and hands-on engineering.', icon:'m2 10 14-7 14 7-14 7-14-7ZM8 13v9l8 4 8-4v-9M29 11v11M12 29l-3 3M20 29l3 3' },
];
---
<section class="who-we-are" id="who-we-are" aria-labelledby="who-title">
  <div class="team-inner">
    <p class="eyebrow team-eyebrow">WHO YOU WORK WITH</p>
    <h2 id="who-title">The engineer you know. The expertise you need.</h2>
    <div class="team-cards">
      {cards.map(card => <article class="team-card" aria-labelledby={`team-${card.key}-title`}>
        <svg class="team-icon" width="32" height="32" viewBox="0 0 32 34" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={card.icon} /></svg>
        <div class="team-card-copy"><h3 id={`team-${card.key}-title`}>{card.title}</h3><p>{card.description}</p></div>
      </article>)}
    </div>
  </div>
</section>
<style>
  :global(body.home-page) #who-we-are { background:var(--itk-bg); color:var(--itk-text); padding-block:var(--chapter-gap,32px) 48px; }
  .team-inner { max-width:1240px; margin-inline:auto; min-width:0; padding-inline:clamp(16px,2vw,24px); }
  .team-eyebrow { color:var(--itk-brand-cyan); font-size:14px; font-weight:700; line-height:1.5; letter-spacing:var(--itk-label-tracking); margin:0 0 16px; }
  #who-title { color:var(--itk-text); font-size:var(--itk-heading); font-weight:600; line-height:1.12; letter-spacing:-.035em; max-width:27ch; margin:0 0 20px; text-wrap:balance; scroll-margin-block-start:140px; }
  .team-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-block-start:20px; }
  .team-card { min-width:0; margin:0; padding:24px; border:1px solid var(--itk-border-strong); border-radius:var(--itk-radius-lg); background:var(--itk-surface-raised); }
  .team-icon { display:block; color:var(--itk-brand-cyan); margin-block-end:20px; }
  .team-card h3 { color:var(--itk-text); font-size:18px; line-height:1.3; font-weight:600; letter-spacing:-.02em; margin:0 0 12px; text-wrap:balance; }
  .team-card p { color:#B8C4D6; font-size:16px; line-height:1.5; font-weight:400; margin:0; text-wrap:pretty; }
  @media(max-width:900px) {
    .team-cards { grid-template-columns:1fr; gap:16px; margin-block-start:24px; }
    .team-card { display:grid; grid-template-columns:32px minmax(0,1fr); align-items:start; gap:20px; }
    .team-icon { margin:0; }
  }
  @media(forced-colors:active) {
    :global(body.home-page) #who-we-are,.team-card { background:Canvas; color:CanvasText; }
    .team-card { border-color:CanvasText; }
    .team-eyebrow,#who-title,.team-card h3,.team-card p,.team-icon { color:CanvasText; }
  }
</style>
