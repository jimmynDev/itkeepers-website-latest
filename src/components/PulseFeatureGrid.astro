---
const features = [
  { title:'IT Health', text:'Planned overview of identity, devices, security, licensing and items requiring attention.', detail:'An IT Health summary is a guide to review, not a certified security measurement.' },
  { title:'Users & Identity', text:'Planned Microsoft 365 view: users, licenses, guest and admin accounts, MFA registration and account status.' },
  { title:'Devices', text:'Planned view of managed devices, compliance, encryption, endpoint protection, recent check-ins and open work.' },
  { title:'Security', text:'Planned view of Microsoft Secure Score, alerts, device protection, identity security, MFA coverage and recommendations.', detail:'Pulse is designed to surface security information from the underlying technologies; it does not replace them.' },
  { title:'Microsoft Licensing', text:'Planned view of purchased, assigned and available licenses, with utilization for review.' },
  { title:'Reports', text:'Planned monthly IT, security, device, licensing and identity reports showing changes, open priorities and progress.' },
  { title:'Support', text:'Planned view of open and resolved requests, status and assigned engineer or team.' }
];
---
<div class="pulse-features">{features.map(({ title, text, detail }, index) => <section class="pulse-feature" aria-labelledby={`pulse-feature-${index}`}><span class="pulse-feature-index" aria-hidden="true">0{index + 1}</span><h3 id={`pulse-feature-${index}`}>{title}</h3><p>{text}</p>{detail && <p class="pulse-feature-detail">{detail}</p>}</section>)}</div>
