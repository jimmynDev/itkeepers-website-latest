import Animation from '../../components/animations/WebDesignHostingAnimation.astro';
---
<Base>
<section class="section service-page-example"><p class="eyebrow">Digital Services</p><h1>Web Design &amp; Hosting</h1><p class="lead">Website design, hosting, security and maintenance from wireframe to launch and ongoing updates.</p><Animation /><div class="offering-detail" id="web-design-hosting-details" role="region" aria-labelledby="website-scope-title">
      <div><p class="eyebrow">Plan the whole website</p><h2 id="website-scope-title">From the first page to what comes next.</h2></div>
      <div>
        <p>Plan content and navigation around your audience and the action they need to take.</p>
        <p>Agree hosting, updates and maintenance as part of the website scope.</p>
      </div>
    </div></section>
<section class="cta"><h2>Bring the context. We'll start there.</h2><a class="btn white" href="/contact/">Talk to our team</a></section>
</Base>
