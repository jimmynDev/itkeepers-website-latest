---
import Base from '../../layouts/Base.astro';
import Animation from '../../components/animations/ManagedITAnimation.astro';
import PulseSection from '../../components/PulseSection.astro';
import { managedServices } from '../../data/managed-services';
import '../../styles/service-delivery-pages.css';
const scopeNotes: Record<string, string> = {
  'it-services': 'Engineers review monitoring and security alerts alongside backup status and open work, then assess the affected environment.',
  'service-desk': 'Phone and email requests are prioritized and assigned to an engineer. Serious incidents can take priority over queued work.',
  'backup-disaster-recovery': 'Backup job monitoring and routine restore tests support recovery planning. Test scope and recovery objectives depend on the agreed service.',
  'patch-management': 'Engineers review patch status, security updates and failed jobs under agreed maintenance arrangements.',
  'service-packages': 'Shared records cover devices, users, networks and licenses. Reports include patch, backup and security status with recommendations; contents depend on the agreed service.',
};
// Preserve the approved qualitative operating model and shared scope boundary.
const points = [
  ['From assessment to an assigned engineer', 'Monitoring alerts and client reports lead to issue assessment, a ticket and an assigned engineer, with the next action tracked through follow-up.'],
  ['Escalation with shared context', 'Another engineer joins when their expertise is a better fit or the initial investigation has not resolved the issue. Shared environment records help the handover.'],
  ['Restore service, then follow through', 'A workaround or service restoration may come before deeper remediation. Recurring issues are investigated further and escalated when needed.'],
];
---
<Base>
  <div class="delivery-page managed-page">
    <section class="delivery-section delivery-hero" aria-labelledby="managed-title">
      <div class="managed-hero-grid">
        <div class="managed-hero-copy">
          <p class="eyebrow">ITKeepers services</p>
          <h1 id="managed-title">Managed IT services</h1>
          <p class="delivery-lead">Engineers assess alerts and support requests, maintain systems and track follow-up in shared IT records.</p>
          <a class="delivery-primary" href="/contact/?type=review">Book a Free IT Consultation</a>
          <p class="delivery-scope">Exact support scope, coverage and response commitments depend on the agreed service.</p>
        </div>
        <div class="managed-hero-visual">
          <p class="eyebrow">Illustrative workflow</p>
          <h2>From signal to resolution.</h2>
          <Animation />
        </div>
      </div>
    </section>
    <section class="delivery-section delivery-alt managed-day-to-day" aria-labelledby="managed-capabilities-title">
      <header class="delivery-section-heading"><p class="eyebrow">What we manage</p><h2 id="managed-capabilities-title">Day-to-day IT operations.</h2></header>
      <div class="managed-capabilities">
        {managedServices.map((service, index) => <article class="managed-capability" id={service.id} aria-labelledby={`${service.id}-title`}>
          <span class="delivery-index" aria-hidden="true">0{index + 1}</span><h3 id={`${service.id}-title`}>{service.name}</h3><p>{scopeNotes[service.id]}</p>
          {service.id === 'backup-disaster-recovery' && <a class="delivery-link" href={service.href}>Explore Backup &amp; Disaster Recovery</a>}
        </article>)}
      </div>
    </section>
    <section class="delivery-section" aria-labelledby="managed-ownership-title">
      <header class="delivery-section-heading"><p class="eyebrow">Engineering ownership</p><h2 id="managed-ownership-title">Assessment, escalation and follow-up.</h2></header>
      <ol class="delivery-process">{points.map(([title, text], index) => <li><span class="delivery-index" aria-hidden="true">0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
    </section>
    <PulseSection managed />
  </div>
</Base>
