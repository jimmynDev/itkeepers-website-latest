---
import PulseSection from '../../components/PulseSection.astro';
import Animation from '../../components/animations/ManagedITAnimation.astro';
import { managedServices } from '../../data/managed-services';
const scopeNotes: Record<string, string> = {
  'it-services': 'Connect support, maintenance and documentation around the systems your people use.',
  'service-desk': 'Agree how support requests are raised, prioritized and followed up, including contact paths and coverage.',
  'backup-disaster-recovery': 'Backup job monitoring and routine restore tests support recovery planning. Test scope and recovery objectives depend on the agreed service.',
  'patch-management': 'Agree update scope and maintenance arrangements for the systems being managed.',
  'service-packages': 'Define included services, responsibilities, coverage and response commitments in the service agreement.',
};
import P from '../../components/ServicePage.astro';const points=[['Ongoing ownership','Support, monitoring, maintenance and follow-up stay connected instead of becoming isolated tickets.'],['Escalation inside the team','When deeper expertise is useful, another engineer can join with shared context.'],['Documentation & reporting','Environment knowledge and recurring reporting help work continue with less dependence on one person.']];
---
<P title="Managed IT services" intro="Support, monitoring, maintenance and documentation for the day-to-day operation of your business IT." scopeHeading="What does ongoing IT management cover?" points={points} boundary="Exact support scope, coverage and response commitments depend on the agreed service."><p slot="context">As a Lebanon-based MSP, ITKeepers connects ongoing support with shared environment knowledge. See <a class="disclosure-link" href="/how-we-work/">how engineers review and follow up on work</a> or compare the <a class="disclosure-link" href="/services/">seven IT service areas</a>.</p><section class="section managed-day-to-day"><p class="eyebrow">DAY-TO-DAY</p><h2>Support and maintenance areas</h2><p>Exact support scope, coverage and response commitments depend on the agreed service.</p><ul>{managedServices.map(service => <li id={service.id}><h3>{service.name}</h3><p>{scopeNotes[service.id]}</p>{service.id === 'backup-disaster-recovery' && <a class="scene-link" href={service.href}>Explore Backup &amp; Disaster Recovery</a>}</li>)}</ul></section><section class="section service-page-example"><h2>How a storage warning is investigated</h2><p>Follow a hypothetical storage warning from detection through investigation and follow-up.</p><Animation /></section><PulseSection managed /></P>
<style>
  .managed-day-to-day ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .managed-day-to-day li { padding-block: 20px; border-block-start: 1px solid var(--s); scroll-margin-block-start: 32px; }
  .managed-day-to-day h3 { font-size: 24px; margin-block-end: 12px; }
  .managed-day-to-day a { text-decoration: underline; }
  @media (max-width: 700px) { .managed-day-to-day ul { grid-template-columns: 1fr; } }
</style>
