---
import PulseSection from '../../components/PulseSection.astro';
import Animation from '../../components/animations/ManagedITAnimation.astro';
import { managedServices } from '../../data/managed-services';
const scopeNotes: Record<string, string> = {
  'it-services': 'Automated monitoring and security alerts are reviewed alongside backup status and open work. Engineers assess what a signal means for the affected environment before deciding the next action.',
  'service-desk': 'Requests arrive by phone or email and are prioritized and assigned to an engineer. The engineer gathers details, investigates and contacts you when useful. Serious incidents can take priority over queued work.',
  'backup-disaster-recovery': 'Backup job monitoring and routine restore tests support recovery planning. Test scope and recovery objectives depend on the agreed service.',
  'patch-management': 'Engineers review patch status, security updates, failed jobs and outstanding tasks. Update scope and maintenance arrangements are agreed for the systems being managed.',
  'service-packages': 'Shared records cover devices, users, networks, licenses and environment details. Reporting brings together patch and backup status, security updates, device information and recommendations; exact contents depend on the agreed service.',
};
import P from '../../components/ServicePage.astro';
// Brief §§3–4; approved qualitative operations V2-OPERATIONS-01/02.
// No response-time, staffed coverage or maintenance-frequency promise is inferred.
const points = [
  ['From assessment to an assigned engineer', 'Monitoring alerts and client reports lead to issue assessment, a ticket and an assigned engineer, with the next action tracked through follow-up.'],
  ['Escalation with shared context', 'Another engineer joins when their expertise is a better fit or the initial investigation has not resolved the issue. Shared environment records help the handover.'],
  ['Restore service, then follow through', 'A workaround or service restoration may come before deeper remediation. Recurring issues are investigated further and escalated when needed.'],
];
---
<P title="Managed IT services" intro="Support, monitoring, maintenance and documentation for the day-to-day operation of your business IT." scopeHeading="How does a request move through the team?" points={points} boundary="Exact support scope, coverage and response commitments depend on the agreed service."><p slot="context">As a Lebanon-based MSP, ITKeepers connects ongoing support with shared environment knowledge. See <a class="disclosure-link" href="/how-we-work/">how engineers review and follow up on work</a> or compare the <a class="disclosure-link" href="/services/">seven IT service areas</a>.</p><section class="section managed-day-to-day"><p class="eyebrow">DAY-TO-DAY</p><h2>Monitoring, support and maintenance</h2><ul>{managedServices.map(service => <li id={service.id}><h3>{service.name}</h3><p>{scopeNotes[service.id]}</p>{service.id === 'backup-disaster-recovery' && <a class="scene-link" href={service.href}>Explore Backup &amp; Disaster Recovery</a>}</li>)}</ul></section><section class="section service-page-example"><h2>How a storage warning is investigated</h2><p>Follow a hypothetical storage warning from detection through investigation and follow-up.</p><Animation /></section><PulseSection managed /></P>
<style>
  .managed-day-to-day ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .managed-day-to-day li { padding-block: 20px; border-block-start: 1px solid var(--s); scroll-margin-block-start: 32px; }
  .managed-day-to-day h3 { font-size: 24px; margin-block-end: 12px; }
  .managed-day-to-day a { text-decoration: underline; }
  @media (max-width: 700px) { .managed-day-to-day ul { grid-template-columns: 1fr; } }
</style>
