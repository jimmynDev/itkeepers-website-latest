---
import Base from '../../../layouts/Base.astro';
import articles from '../../../data/legacy-articles.json';
export function getStaticPaths() {
  return articles.map(article => {
    const [year, month, slug] = article.path.split('/').filter(Boolean);
    return { params: { year, month, slug }, props: { article } };
  });
}
const { article } = Astro.props;
const date = new Date(article.published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base>
  <section class="section">
    <p class="eyebrow">ITKeepers blog archive</p>
    <h1 class="archive-title">{article.title}</h1>
    <p>Originally published <time datetime={article.published}>{date}</time></p>
    <p class="lead">This retained article reflects its original publication context. It has not been updated and does not describe current ITKeepers service inclusions.</p>
    <a class="disclosure-link" href="/blog/">Back to the blog archive</a>
  </section>
  <section class="section">
    <article class="archive-body">
      {article.blocks.map(block => block.tag === 'h2' ? <h2>{block.text}</h2> : block.tag === 'h3' ? <h3>{block.text}</h3> : <p>{block.text}</p>)}
      <p>For current planning context, explore the <a class="disclosure-link" href="/resources/ai-governance/">AI Governance Playbook</a> and the <a class="disclosure-link" href="/services/ai-automation/">illustrative AI and automation workflow</a>.</p>
    </article>
  </section>
</Base>
<style>
  .archive-title { font-size:clamp(36px,5vw,72px); line-height:1.1; overflow-wrap:anywhere; }
  .archive-body { max-inline-size:75ch; margin-inline:auto; padding:0; border:0; border-radius:0; }
  .archive-body p { font-size:18px; line-height:1.75; }
  .archive-body h2 { margin-block:40px 20px; font-size:clamp(28px,3vw,38px); line-height:1.25; }
  .archive-body h3 { font-size:26px; line-height:1.3; }
  .archive-body > :first-child { margin-block-start:0; }
</style>
