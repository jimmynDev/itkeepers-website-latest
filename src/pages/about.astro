---
import Base from '../layouts/Base.astro';
import AboutTeamContext from '../components/about/AboutTeamContext.astro';
import { offices } from '../data/locations';
---
<Base>
  <section class="section about-section about-intro">
    <p class="eyebrow">ABOUT ITKEEPERS</p>
    <h1>Your IT person is a team.</h1>
    <p class="lead">ITKeepers brings familiar engineers and shared technical expertise to the day-to-day work of <a class="disclosure-link" href="/services/managed-it/">managing business IT</a>.</p>
    <div class="split about-row about-offices">
      <h2>Our offices in Lebanon and the USA.</h2>
      <div>
        <p>With physical offices in Dbayeh, Lebanon, and Parkland, Florida, ITKeepers supports businesses across the Middle East and North Africa (MENA) and the United States.</p>
        {offices.map(office => <p><strong>{office.label}</strong>{office.addressLines.map(line => <Fragment><br />{line}</Fragment>)}<br /><a class="disclosure-link" href={office.phone.href}>{office.phone.display}</a></p>)}
      </div>
    </div>
  </section>
  <section class="section light about-section">
    <div class="split about-row">
      <h2>Familiar people. Shared expertise.</h2>
      <div>
        <p>Engineers share knowledge of your people, applications and infrastructure so you do not have to coordinate internal handoffs.</p>
      </div>
    </div>
  </section>
  <section class="section about-section">
    <div class="split about-row">
      <h2>Proactive work, connected to follow-through.</h2>
      <div>
        <p>Between support requests, engineers review monitoring signals, maintain systems and follow up on open issues.</p>
        <p><a class="disclosure-link" href="/how-we-work/">Automated monitoring and engineer follow-up</a> have different coverage: monitoring can run continuously; human coverage and response commitments depend on your service agreement.</p>
      </div>
    </div>
  </section>
  <section class="about-context-section" aria-label="Team collaboration illustration">
    <AboutTeamContext />
  </section>
  <section class="section light about-section">
    <div class="split about-row">
      <h2>Knowledge that stays with the work.</h2>
      <div>
        <p>We record systems, configurations, changes and decisions so engineers can pick up work with its history.</p>
      </div>
    </div>
  </section>
  <section class="section about-section">
    <div class="split about-row">
      <h2>Expertise that keeps developing.</h2>
      <div>
        <p>Engineers develop through technical training, specialist courses and hands-on work, then share that knowledge with colleagues.</p>
      </div>
    </div>
  </section>
  <section class="section light about-section">
    <div class="split about-row">
      <h2>A relationship that develops with your business.</h2>
      <div>
        <p>As your organization adds people or changes applications, we review what remains useful, what needs attention and what should change.</p>
      </div>
    </div>
  </section>
  <section class="cta about-section about-closing">
    <h2>Let’s talk about your environment.</h2>
    <a class="btn white" href="/contact/">Talk to our team</a>
  </section>
</Base>
<style>
  .about-section,.about-context-section {
    --about-bg:var(--itk-bg); --about-text:var(--itk-text); --about-muted:var(--itk-supporting-text,var(--itk-muted));
    --about-accent:var(--itk-brand-cyan); --about-rule:var(--itk-border-strong);
    color:var(--about-text); background:var(--about-bg);
    padding-inline:max(var(--layout-gutter),calc((100% - 1120px)/2));
  }
  .about-section { padding-block:calc(var(--itk-section-space) * .75); }
  .about-context-section { padding-block:0; }
  .about-offices { margin-block-start:40px; }
  .about-section .about-row { grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:clamp(32px,5vw,72px); align-items:start; }
  .about-section h1 { max-inline-size:20ch; font-size:clamp(40px,5.2vw,72px); line-height:1.08; color:var(--about-text); }
  .about-section h2 { font-size:clamp(28px,2.65vw,38px); line-height:1.18; color:var(--about-text); }
  .about-section p:not(.eyebrow),.about-section .about-row p {
    max-inline-size:68ch; font-size:clamp(16px,1.3vw,18px); line-height:1.7; color:var(--about-muted);
  }
  .about-section .about-row p:first-child { margin-block-start:0; }
  .about-section .about-row p:last-child,.about-intro > p:last-child { margin-block-end:0; }
  .about-section > .eyebrow { color:var(--about-accent); }
  .about-closing p { margin-block-end:24px; }
  :global(:root[data-hero-theme="day"]) :is(.about-section,.about-context-section) {
    --about-bg:var(--surface-light); --about-text:var(--itk-light-text); --about-muted:var(--itk-light-muted);
    --about-accent:var(--itk-light-accent); --about-rule:var(--itk-light-border);
  }
  @media(max-width:700px) { .about-section .about-row { grid-template-columns:1fr; gap:20px; } .about-row h2 { margin-block-end:0; } }
  @media(forced-colors:active) {
    .about-section,.about-context-section { --about-bg:Canvas; --about-text:CanvasText; --about-muted:CanvasText; --about-accent:LinkText; --about-rule:CanvasText; }
  }
</style>
