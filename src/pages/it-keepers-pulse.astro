---
import Base from '../layouts/Base.astro';
import PulsePreview from '../components/PulsePreview.astro';
import PulseFeatureGrid from '../components/PulseFeatureGrid.astro';
import PulseWorkflow from '../components/PulseWorkflow.astro';
import '../styles/pulse.css';
---
<Base>
  <article class="pulse-page">
    <header class="pulse-shell pulse-reveal pulse-hero">
      <div class="pulse-reveal-copy">
        <p class="eyebrow">IT KEEPERS PULSE · UNDER DEVELOPMENT</p>
        <h1>Your IT environment.<br />One clear view.</h1>
        <p>IT Keepers Pulse is under development as a client visibility platform for the systems ITKeepers manages — users, devices, security, Microsoft 365, licensing, reports and support activity.</p>
        <div class="pulse-actions"><a class="btn" href="#one-view">Explore planned views <span aria-hidden="true">↓</span></a><a class="pulse-text-link" href="/contact/?type=review">Book a Free IT Consultation</a></div>
      </div>
      <PulsePreview />
    </header>
    <section class="pulse-shell pulse-capabilities" id="one-view" aria-labelledby="pulse-one-view">
      <div class="pulse-section-intro"><p class="eyebrow">ONE VIEW</p><h2 id="pulse-one-view">See what is happening across your IT environment.</h2><p>Planned dashboard views bring together status, priorities and support activity.</p></div>
      <PulseFeatureGrid />
      <p class="pulse-capability-note">Sample data only. Planned views, data sources, reports and support integrations depend on development and agreed service scope.</p>
    </section>
    <section class="pulse-shell" aria-labelledby="pulse-action-title">
      <div class="pulse-section-intro"><p class="eyebrow">VISIBLE ACCOUNTABILITY</p><h2 id="pulse-action-title">From monitoring to action.</h2><p>Pulse is designed to connect monitoring status with assigned work and follow-up.</p><p>Handling depends on the issue and agreed service scope. See <a class="disclosure-link" href="/how-we-work/">how engineers investigate and follow up</a>.</p></div>
      <PulseWorkflow />
    </section>
    <section class="pulse-shell pulse-ownership" aria-labelledby="pulse-ownership-title">
      <div><p class="eyebrow">MANAGED BY ITKEEPERS. VISIBLE TO YOU.</p><h2 id="pulse-ownership-title">Visibility without another platform to manage.</h2><p>IT Keepers Pulse is designed as a client-facing view of your managed IT environment, rather than another monitoring tool for your team to operate.</p><a class="pulse-text-link" href="/services/managed-it/">Explore Managed IT <span aria-hidden="true">→</span></a></div>
    </section>
    <section class="pulse-shell pulse-closing" aria-labelledby="pulse-contact-title"><div class="pulse-section-intro"><p class="eyebrow">LET'S TALK ABOUT YOUR ENVIRONMENT</p><h2 id="pulse-contact-title">A clearer view starts with the right context.</h2><p>Discuss Pulse development status and the views and integrations proposed for your environment.</p><a class="btn" href="/contact/?type=review">Book a Free IT Consultation <span aria-hidden="true">→</span></a></div></section>
  </article>
</Base>
