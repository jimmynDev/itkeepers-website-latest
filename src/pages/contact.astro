---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { businessPhone, contactEmail } from '../data/contact';
---
<Base>
  <section class="section contact-page" aria-labelledby="contact-title">
    <div class="contact-container">
      <div class="contact-heading">
        <p class="eyebrow">LET'S TALK</p>
        <h1 id="contact-title">Talk to our team.</h1>
      </div>
      <div class="contact-layout">
        <div class="contact-form-panel">
          <InquiryForm id="contact" />
        </div>
        <aside class="contact-information" aria-label="Other ways to contact ITKeepers">
          <section class="contact-card" aria-labelledby="contact-call-title">
            <h2 id="contact-call-title">Call us</h2>
            <a class="contact-detail" href={businessPhone.href}>
              <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.57 2.8.7A2 2 0 0 1 22 16.92Z"/></svg>
              <span>{businessPhone.display}</span>
            </a>
          </section>
          <section class="contact-card contact-emergency" aria-labelledby="contact-emergency-title">
            <h2 id="contact-emergency-title">Under attack?</h2>
            <a class="contact-emergency-link" href="/emergency/">Get emergency help</a>
          </section>
          <section class="contact-card" aria-labelledby="contact-email-title">
            <h2 id="contact-email-title">Email our team</h2>
            <a class="contact-detail" href={contactEmail.href}>
              <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              <span>{contactEmail.display}</span>
            </a>
          </section>
        </aside>
      </div>
    </div>
  </section>
</Base>
<style>
  :global(body main > section.contact-page) {
    inline-size:100%; max-inline-size:none; min-inline-size:0;
    padding:56px 24px 80px;
    background:var(--itk-bg);
  }
  .contact-container { inline-size:100%; max-inline-size:1100px; min-inline-size:0; margin-inline:auto; }
  .contact-heading { margin-block-end:36px; }
  .contact-heading .eyebrow { color:var(--itk-brand-cyan); font-size:12px; margin:0 0 16px; }
  .contact-heading h1 { font-size:clamp(38px,4.6vw,64px); line-height:1.08; font-weight:700; margin:0 0 20px; text-wrap:balance; letter-spacing:-.03em; }
  .contact-layout { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:32px; align-items:start; }
  .contact-form-panel { min-inline-size:0; padding:30px; background:var(--itk-surface-raised); border:1px solid var(--itk-border-strong); border-radius:var(--itk-radius-lg); }
  .contact-information { display:grid; gap:20px; min-inline-size:0; }
  .contact-card { min-inline-size:0; padding:26px; border:1px solid var(--itk-border-strong); border-radius:var(--itk-radius-md); background:var(--itk-bg-alt); }
  .contact-card h2 { color:var(--itk-text); font-size:24px; line-height:1.25; letter-spacing:-.025em; font-weight:600; margin:0 0 16px; }
  .contact-detail { display:inline-flex; align-items:center; gap:12px; min-block-size:48px; font-size:20px; line-height:1.4; font-weight:600; color:var(--itk-text); overflow-wrap:anywhere; text-decoration:none; }
  .contact-detail svg { flex:0 0 21px; color:var(--itk-brand-cyan); }
  .contact-detail:hover { color:#7DD3FC; text-decoration:underline; text-underline-offset:4px; }
  .contact-emergency { border-color:rgba(248,113,113,.55); background:linear-gradient(rgba(248,113,113,.04),rgba(248,113,113,.04)),var(--itk-bg-alt); }
  .contact-emergency-link { display:inline-flex; align-items:center; min-block-size:44px; font-size:16px; font-weight:600; line-height:1.5; color:#FCA5A5; text-decoration:underline; text-underline-offset:5px; }
  .contact-emergency-link:hover { color:#FFE0E0; }
  .contact-page a:focus-visible { outline:3px solid #7DD3FC; outline-offset:4px; }

  :global(html[data-theme="light"] body main > section.contact-page) { --itk-supporting-text:#42566F; background:#F5F9FC; color:#0B2C5F; }
  :global(html[data-theme="light"]) .contact-heading .eyebrow { color:#075D7D; }
  :global(html[data-theme="light"]) .contact-card,:global(html[data-theme="light"]) .contact-form-panel { background:#FFFFFF; border-color:rgba(11,44,95,.2); }
  :global(html[data-theme="light"]) .contact-card h2,:global(html[data-theme="light"]) .contact-detail { color:#0B2C5F; }
  :global(html[data-theme="light"]) .contact-detail svg { color:#075D7D; }
  :global(html[data-theme="light"]) .contact-emergency { border-color:rgba(153,27,27,.48); background:#FFF4F4; }
  :global(html[data-theme="light"]) .contact-emergency-link { color:#991B1B; }
  :global(html[data-theme="light"]) .contact-emergency-link:hover { color:#6B1111; }
  :global(html[data-theme="light"]) .contact-detail:hover { color:#075D7D; }
  :global(html[data-theme="light"]) .contact-page a:focus-visible { outline-color:#075D7D; }

  @media(max-width:900px) {
    .contact-layout { display:flex; flex-direction:column; gap:24px; }
    .contact-information { order:0; inline-size:100%; grid-template-columns:minmax(0,1fr); }
    .contact-form-panel { order:1; inline-size:100%; }
  }
  @media(max-width:600px) {
    :global(body main > section.contact-page) { padding-block:36px 56px; }
    .contact-form-panel,.contact-card { padding:22px; }
    .contact-heading { margin-block-end:28px; }
  }
  @media(forced-colors:active) {
    .contact-form-panel,.contact-card { background:Canvas; border-color:CanvasText; }
    .contact-page a:focus-visible { outline-color:Highlight; }
    .contact-emergency-link { color:LinkText; }
  }
</style>
