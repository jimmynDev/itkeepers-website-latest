---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { businessPhone, contactEmail } from '../data/contact';
---
<Base title="Free IT Review | ITKeepers" description="Book a free IT review with ITKeepers to discuss recurring IT issues, infrastructure, Microsoft 365, security and upcoming technology priorities.">
  <section class="section contact-page" aria-labelledby="contact-title">
    <div class="contact-heading">
      <p class="eyebrow">LET'S TALK</p><h1 id="contact-title">Talk to our team.</h1>
      <p>Tell us what you need. We'll take it from there.</p>
    </div>
    <div class="contact-layout">
      <div class="contact-form-panel">
        <InquiryForm id="contact" />
      </div>
      <aside class="contact-information" aria-label="Other ways to contact ITKeepers">
        <section class="contact-card" aria-labelledby="contact-call-title">
          <p class="contact-card-label">CALL US</p><h2 id="contact-call-title">A conversation starts here.</h2>
          <a class="contact-detail" href={businessPhone.href}>{businessPhone.display}</a>
        </section>
        <section class="contact-card contact-emergency" aria-labelledby="contact-emergency-title">
          <p class="contact-card-label"><span aria-hidden="true" class="contact-emergency-dot"></span>SECURITY INCIDENT</p>
          <h2 id="contact-emergency-title">Under attack?</h2>
          <p>Suspect ransomware, account compromise, or an active security incident? Contact our team immediately.</p>
          <a class="contact-emergency-link" href="/emergency/">Get emergency help</a>
        </section>
        <section class="contact-card" aria-labelledby="contact-email-title">
          <p class="contact-card-label">EMAIL</p><h2 id="contact-email-title">Write to us.</h2>
          <a class="contact-detail" href={contactEmail.href}>{contactEmail.display}</a>
        </section>
      </aside>
    </div>
  </section>
</Base>
<style>
  :global(body) main > .contact-page { padding-block:56px 72px; }
  .contact-heading { margin-block-end:36px; }
  .contact-heading .eyebrow { font-size:12px; margin:0 0 16px; }
  .contact-heading h1 { font-size:clamp(38px,4.6vw,64px); line-height:1.08; font-weight:600; margin:0 0 20px; text-wrap:balance; }
  .contact-heading > p:last-child { color:var(--itk-muted); font-size:18px; margin:0; }
  .contact-layout { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:32px; align-items:start; }
  .contact-form-panel { min-inline-size:0; padding:28px; background:var(--itk-surface-raised); border:1px solid var(--itk-border-strong); border-radius:var(--itk-radius-lg); }
  .contact-information { display:grid; gap:20px; min-inline-size:0; }
  .contact-card { padding:26px; border:1px solid var(--itk-border-strong); border-radius:var(--itk-radius-md); background:var(--itk-bg-alt); }
  .contact-card-label { color:var(--itk-brand-cyan); font-size:12px; letter-spacing:.1em; font-weight:600; margin:0 0 16px; }
  .contact-card h2 { font-size:24px; line-height:1.25; letter-spacing:-.025em; font-weight:600; margin:0 0 16px; }
  .contact-detail { display:inline-flex; align-items:center; min-block-size:48px; font-size:clamp(18px,1.8vw,22px); color:var(--itk-text); overflow-wrap:anywhere; }
  .contact-detail:hover { color:var(--itk-brand-cyan); }
  .contact-emergency { border-color:rgba(232,93,93,.45); }
  .contact-emergency .contact-card-label { display:flex; align-items:center; gap:8px; color:#ffb4b4; }
  .contact-emergency-dot { inline-size:6px; block-size:6px; background:currentColor; border-radius:50%; }
  .contact-emergency > p:not(.contact-card-label) { color:var(--itk-muted); margin:0 0 16px; }
  .contact-emergency-link { display:inline-flex; align-items:center; min-block-size:48px; font-weight:600; color:#ffb4b4; text-decoration:underline; text-underline-offset:5px; }
  .contact-emergency-link:hover { color:var(--itk-text); }

  .contact-page a:focus-visible { outline:3px solid var(--itk-brand-cyan); outline-offset:4px; }
  @media(max-width:900px) { .contact-layout { grid-template-columns:1fr; } .contact-information { grid-template-columns:repeat(2,minmax(0,1fr)); } .contact-emergency { grid-row:span 2; grid-column:2; } }
  @media(max-width:600px) { :global(body) main > .contact-page { padding-block:36px 44px; } .contact-form-panel,.contact-card { padding:20px; } .contact-information { grid-template-columns:1fr; } .contact-emergency { grid-column:auto; grid-row:auto; } .contact-layout { gap:24px; } .contact-heading { margin-block-end:28px; } }
  @media(forced-colors:active) { .contact-form-panel,.contact-card { background:Canvas; border-color:CanvasText; } .contact-page a:focus-visible { outline-color:Highlight; } .contact-emergency-link { color:CanvasText; } }
</style>
