{
  "extends": "astro/tsconfigs/base",
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "worker/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "types": [
      "node",
      "astro/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  }
}
